class Regs:
    """32-bit register window (UIO map or /dev/mem)."""

    def __init__(self, base, size, devmem=False):
        self.base = base
        if devmem:
            fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
            self.mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE,
                                offset=base)
            self.src = "/dev/mem"
        else:
            dev = find_uio(base)
            if dev is None:
                raise SystemExit(f"pktrec-phy: no UIO device maps 0x{base:x} "
                                 "(generic-uio binding missing? try --devmem)")
            fd = os.open(dev, os.O_RDWR | os.O_SYNC)
            self.mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE,
                                offset=0)
            self.src = dev
        os.close(fd)
        # typed view: every access is a single aligned 32-bit load/store
        self.words = memoryview(self.mm).cast("I")

    def rd(self, off):
        return self.words[off >> 2]

    def wr(self, off, val):
        self.words[off >> 2] = val & 0xFFFFFFFF


def find_uio(base):
    root = "/sys/class/uio"
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return None
    for n in names:
        try:
            with open(f"{root}/{n}/maps/map0/addr") as f:
                if int(f.read().strip(), 16) == base:
                    return f"/dev/{n}"
        except (OSError, ValueError):
            continue
    return None


class Board:
    def __init__(self, devmem=False):
        self.eth = Regs(ETH_BASE, ETH_SIZE, devmem)
        self.m0 = Regs(M0_BASE, M0_SIZE, devmem)
        if self.eth.rd(ETH_ID) != ETH_ID_VALUE:
            raise SystemExit(f"pktrec-phy: eth_ports ID 0x{self.eth.rd(ETH_ID):08x}, "
                             f"expected 0x{ETH_ID_VALUE:08x} (wrong bitstream?)")
        if self.m0.rd(M0_ID) != M0_ID_VALUE:
            raise SystemExit(f"pktrec-phy: m0_path ID 0x{self.m0.rd(M0_ID):08x}, "
                             f"expected 0x{M0_ID_VALUE:08x}")
        self.devmem = devmem
        self._cap = None

    @property
    def cap(self):
        """Capture block (SFD registers), mapped on first use."""
        if self._cap is None:
            self._cap = Regs(CAP_BASE, CAP_SIZE, self.devmem)
            if self._cap.rd(0) != CAP_ID_VALUE:
                raise SystemExit(f"pktrec-phy: capture ID 0x{self._cap.rd(0):08x}, "
                                 f"expected 0x{CAP_ID_VALUE:08x}")
            if self._cap.rd(CAP_VERSION) < 0x00010002:
                raise SystemExit("pktrec-phy: capture register map "
                                 f"0x{self._cap.rd(CAP_VERSION):08x} has no SFD block (needs 1.2)")
        return self._cap

    def need_gen(self):
        if self.m0.rd(M0_VERSION) < 0x00010001:
            raise SystemExit("pktrec-phy: this bitstream has no traffic generator (m0 map 1.0)")

    def has_tap(self):
        """m0 map 1.2 (M3): PAIR_MODE, EFF_PATH, dynamic IFG."""
        return self.m0.rd(M0_VERSION) >= 0x00010002

    def need_tap(self):
        if not self.has_tap():
            raise SystemExit("pktrec-phy: this bitstream has no TAP-mode registers "
                             f"(m0 map 0x{self.m0.rd(M0_VERSION):08x}, needs 1.2)")

    def capture_running(self):
        """True while the capture block records (CTRL.ENABLE); None if unknown."""
        try:
            c = self._cap if self._cap is not None else Regs(CAP_BASE, CAP_SIZE, self.devmem)
        except (SystemExit, OSError):
            return None
        if c.rd(0) != CAP_ID_VALUE:
            return None
        return bool(c.rd(CAP_CTRL) & CAP_CTRL_ENABLE)

    def has_replay(self):
        """m0 map 1.3 (M6): PATH_RPL (path mode 4 replay)."""
        return self.m0.rd(M0_VERSION) >= 0x00010003

    def replay_ports(self):
        return self.m0.rd(M0_PATH_RPL) & 0xF if self.has_replay() else 0

    def write_path(self, m):
        """PATH_CTRL = m, and PAIR_MODE derived from it (pair = tap iff both ports fwd)."""
        self.m0.wr(M0_PATH_CTRL, m & 0xFF)
        if self.has_tap():
            pm = 0
            for p in range(2):
                if all(((m >> (2 * n)) & 3) == MODES["fwd"] for n in (2 * p, 2 * p + 1)):
                    pm |= PAIR_MODES["tap"] << (2 * p)
            self.m0.wr(M0_PAIR_MODE, pm)

    def pair_modes(self):
        """Mode name of pair 0 and 1 (PAIR_MODE on 1.2, else derived from PATH_CTRL)."""
        if self.has_tap():
            pm = self.m0.rd(M0_PAIR_MODE)
            return [PAIR_MODE_NAMES[(pm >> (2 * p)) & 3] for p in range(2)]
        m = self.m0.rd(M0_PATH_CTRL)
        return ["tap" if all(((m >> (2 * n)) & 3) == MODES["fwd"] for n in (2 * p, 2 * p + 1))
                else "monitor" for p in range(2)]

    @staticmethod
    def rd64(regs, off):
        lo = regs.rd(off)                     # the LO read latches HI
        return lo | (regs.rd(off + 4) << 32)

    # ---- MDIO bus lock (flock, re-entrant within this process) ----
    MDIO_LOCK = "/run/lock/pktrec-mdio"
    _lock_fd = None
    _lock_depth = 0

    @contextlib.contextmanager
    def mdio_lock(self):
        if self._lock_depth == 0:
            try:
                os.makedirs(os.path.dirname(self.MDIO_LOCK), exist_ok=True)
                self._lock_fd = os.open(self.MDIO_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
                fcntl.flock(self._lock_fd, fcntl.LOCK_EX)
            except OSError:
                self._lock_fd = None          # no lock directory: run unlocked
        self._lock_depth += 1
        try:
            yield
        finally:
            self._lock_depth -= 1
            if self._lock_depth == 0 and self._lock_fd is not None:
                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)
                os.close(self._lock_fd)
                self._lock_fd = None

    # ---- MDIO (Taxi taxi_mdio_master behind the shell's MDIO_CMD/STATUS/RDATA) ----
    def _mdio_wait(self, want_rd, timeout=0.05):
        t0 = time.monotonic()
        while True:
            st = self.eth.rd(ETH_MDIO_STATUS)
            if st & 0x4:
                raise RuntimeError("MDIO command dropped (master busy)")
            if not (st & 0x1) and (not want_rd or (st & 0x2)):
                return
            if time.monotonic() - t0 > timeout:
                raise RuntimeError(f"MDIO timeout (status 0x{st:x})")

    def _mdio(self, op, phy, reg, data=0):
        # [31:30]=01 start, [29:28] op (01 write, 10 read), [27:23] phy, [22:18] reg, [15:0] data
        self._mdio_wait(False)
        self.eth.wr(ETH_MDIO_CMD, (1 << 30) | (op << 28) | ((phy & 0x1F) << 23) |
                    ((reg & 0x1F) << 18) | (data & 0xFFFF))
        self._mdio_wait(op == 2)
        return self.eth.rd(ETH_MDIO_RDATA) & 0xFFFF if op == 2 else None

    def mdio_rd(self, phy, reg):
        with self.mdio_lock():
            if reg <= 0x1F:
                return self._mdio(2, phy, reg)
            self._mdio(1, phy, REGCR, 0x001F)
            self._mdio(1, phy, ADDAR, reg)
            self._mdio(1, phy, REGCR, 0x401F)
            return self._mdio(2, phy, ADDAR)

    @staticmethod
    def p0_guard(phy, reg, val):
        """Refuse the two writes that stop P0's CLK_OUT, which clocks P1-P3 (module
        docstring, "P0 guard"). No option overrides this."""
        if phy != PHY_ADDR[0]:
            return
        if reg == BMCR and val & BMCR_PWRDN:
            raise RuntimeError("refused: BMCR[11] power-down on P0 (MDIO 0x01) stops the 25 MHz "
                               "CLK_OUT that clocks P1-P3 (OP080): they would lose link and MDIO")
        if reg == IO_MUX_CFG:
            raise RuntimeError("refused: IO_MUX_CFG 0x0170 on P0 (MDIO 0x01) sets the CLK_OUT "
                               "mode; P0's CLK_OUT clocks P1-P3 on the OP080")

    def mdio_wr(self, phy, reg, val):
        self.p0_guard(phy, reg, val)
        with self.mdio_lock():
            if reg <= 0x1F:
                self._mdio(1, phy, reg, val)
                return
            self._mdio(1, phy, REGCR, 0x001F)
            self._mdio(1, phy, ADDAR, reg)
            self._mdio(1, phy, REGCR, 0x401F)
            self._mdio(1, phy, ADDAR, val)

    def mdio_rmw(self, phy, reg, clr, setb):
        with self.mdio_lock():
            v = self.mdio_rd(phy, reg)
            n = (v & ~clr) | setb
            if n != v:
                self.mdio_wr(phy, reg, n)
            return v

    # ---- helpers ----
    def eth_port(self, n, off):
        return self.eth.rd(ETH_PORT_BASE + n * ETH_PORT_STRIDE + off)

    def copper_link(self, n):
        return bool(self.mdio_rd(PHY_ADDR[n], PHYSTS) & 0x0400)

    def phy_powered_down(self, n):
        return bool(self.mdio_rd(PHY_ADDR[n], BMCR) & BMCR_PWRDN)

    def phy_power_down(self, n):
        """BMCR[11] power-down: MDI off, the far device sees link down. Never on P0
        (p0_guard refuses it: P0's CLK_OUT clocks P1-P3)."""
        self.mdio_rmw(PHY_ADDR[n], BMCR, 0, BMCR_PWRDN)

    def phy_power_on(self, n):
        """Clear BMCR[11] and restart auto-negotiation (BMCR[9], self-clearing)."""
        self.mdio_rmw(PHY_ADDR[n], BMCR, BMCR_PWRDN, BMCR_AN_RESTART)

    def phy_loopback(self, n, on):
        """BMCR[14] MII loopback on / off. With it on, the DP83867 drops its copper link
        (the far device sees link down) but keeps running: its clocks (P0's CLK_OUT
        feeds P1-P3), MDIO and the SGMII side stay alive (bench 2026-10-13). Turning it
        off also restarts auto-negotiation (BMCR[9], self-clearing).
        Loop safety: refused (RuntimeError) while anything is sent into port n (its
        path or EFF_PATH is not idle): whatever its TX carries would come straight
        back on its RX. Callers make the path idle first."""
        if on:
            busy = tx_into(self, n)
            if busy:
                raise RuntimeError(f"refused: MII loopback on P{n}: " + "; ".join(busy))
            self.mdio_rmw(PHY_ADDR[n], BMCR, 0, BMCR_LOOPBACK)
        else:
            self.mdio_rmw(PHY_ADDR[n], BMCR, BMCR_LOOPBACK, BMCR_AN_RESTART)

    def phy_looped(self, n):
        return bool(self.mdio_rd(PHY_ADDR[n], BMCR) & BMCR_LOOPBACK)

    # ---- per-port path (loop safety) ----
    def path_of(self, n):
        """Selected TX source of port n: idle|loop|fwd|gen|replay."""
        if (self.replay_ports() >> n) & 1:
            return "replay"
        return MODE_NAMES[(self.m0.rd(M0_PATH_CTRL) >> (2 * n)) & 3]

    def eff_path_of(self, n):
        """TX source port n uses now (EFF_PATH, m0 map 1.2); None if not readable."""
        if not self.has_tap():
            return None
        e = self.m0.rd(M0_EFF_PATH)
        if self.has_replay() and (e >> (8 + n)) & 1:
            return "replay"
        return MODE_NAMES[(e >> (2 * n)) & 3]

    def set_port_path(self, n, mode):
        """PATH_CTRL of one port only; PAIR_MODE is left alone (watch's P0 hold keeps
        the pair in TAP mode while P0's path is idle)."""
        m = self.m0.rd(M0_PATH_CTRL) & 0xFF
        self.m0.wr(M0_PATH_CTRL, (m & ~(3 << (2 * n))) | (MODES[mode] << (2 * n)))

    def wait_eff_path(self, n, mode, timeout=0.2):
        """True once EFF_PATH shows `mode` for port n (TX switches at a frame boundary)."""
        t0 = time.monotonic()
        while True:
            e = self.eff_path_of(n)
            if e is None or e == mode:
                return True
            if time.monotonic() - t0 > timeout:
                return False
            time.sleep(0.005)

    def sgmii_retrigger(self, n):
        """Make the DP83867 send a fresh SGMII config word (CFG2[7] 0 -> 1)."""
        a = PHY_ADDR[n]
        v = self.mdio_rd(a, CFG2)
        self.mdio_wr(a, CFG2, v & ~0x0080)
        self.mdio_wr(a, CFG2, v | 0x0080)


# ---------------------------------------------------------------------------
# Loop safety (module docstring "Loop safety"; LAN outage 2026-10-13)
# ---------------------------------------------------------------------------
def path_what(n, p):
    return {"loop": f"P{n}'s own RX", "fwd": f"P{n ^ 1}'s RX (TAP forwarding)",
            "gen": f"P{n}'s generator", "replay": "replay frames"}.get(p, p)


def tx_into(b, n):
    """Reasons why something is sent into port n (empty = its TX is idle)."""
    p = b.path_of(n)
    if p != "idle":
        return [f"P{n}'s path is {p} (its TX carries {path_what(n, p)})"]
    e = b.eff_path_of(n)
    if e not in (None, "idle"):
        return [f"P{n}'s EFF_PATH is still {e} (path switches at the next frame boundary)"]
    return []


def loop_hazards(b, n):
    """Why port n must not be put into a loopback now (empty list = allowed): a path
    forwards into it, or it is in a TAP pair."""
    why = tx_into(b, n)
    if b.pair_modes()[n // 2] == "tap":
        why.append(f"P{n} is in TAP pair {n // 2} (P{n & 2}<->P{(n & 2) + 1} forward to each other)")
    return why


def watch_holds():
    """Ports pktrec-phy-watch holds right now (from its state file)."""
    st = read_watch_state() or {}
    return set(st.get("held") or [])


def lan_gate(why, what, accept):
    """Refuse `what` for the reasons `why`, unless --i-accept-lan-loop (then warn)."""
    if not why:
        return
    msg = (f"{what}: " + "; ".join(why) + ". A loopback on a port that is forwarded into (or "
           "cabled to the LAN) reflects the far side's traffic back at it - on the router-facing "
           "pair a LAN-wide reflection loop. Make the path idle first (pktrec-phy mode <pair> "
           "monitor / path <n> idle) and test on pair 1. --force does not override this; "
           "--i-accept-lan-loop does")
    if not accept:
        raise SystemExit(f"pktrec-phy: refused: {msg}")
    print(LAN_LOOP_WARNING)
    print(f"  overridden: {msg}")


def safety_doc(b):
    """Per-port loop-safety state and every reflecting combination (pktrec-phy safe)."""
    held = watch_holds()
    pairs = b.pair_modes()
    gen_ok = b.m0.rd(M0_VERSION) >= 0x00010001
    ports = []
    for n in range(4):
        d = {"port": n, "pair": n // 2, "pair_mode": pairs[n // 2], "lan": n in LAN_PORTS,
             "path": b.path_of(n), "eff_path": b.eff_path_of(n), "watch_held": n in held,
             "phy_loopback": None, "phy_powered_down": None, "gen_running": None}
        try:
            bm = b.mdio_rd(PHY_ADDR[n], BMCR)
            if bm != 0xFFFF:
                d["phy_loopback"] = bool(bm & BMCR_LOOPBACK)
                d["phy_powered_down"] = bool(bm & BMCR_PWRDN)
        except RuntimeError as e:
            d["mdio_error"] = str(e)
        if gen_ok:
            d["gen_running"] = bool(b.m0.rd(GEN_BASE + n * GEN_STRIDE + G_STATUS) & 1)
        ports.append(d)
    hazards = []
    for d in ports:
        n, q = d["port"], ports[d["port"] ^ 1]
        sends = d["path"] != "idle" or d["eff_path"] not in (None, "idle")
        if d["phy_loopback"] and sends:
            if q["path"] == "fwd" or q["eff_path"] == "fwd":
                hazards.append({"port": n, "kind": "loop",
                                "msg": f"REFLECTION LOOP: P{n ^ 1} RX -> P{n} TX -> PHY{n} loopback -> "
                                       f"P{n} RX -> P{n ^ 1} TX: the device on P{n ^ 1} gets its own "
                                       "traffic back" + (" (LAN pair!)" if q["lan"] else "")})
            else:
                hazards.append({"port": n, "kind": "reflect",
                                "msg": f"P{n}'s TX ({d['path']}) is looped back into P{n} RX by its PHY"})
        if d["path"] == "loop" or d["eff_path"] == "loop":
            hazards.append({"port": n, "kind": "path_loop",
                            "msg": f"path loop: P{n} sends what it receives back to its link "
                                   "partner" + (" (LAN pair!)" if d["lan"] else "")
                                   + (" and its PHY loops it again: frames circulate"
                                      if d["phy_loopback"] else "")})
        if d["phy_loopback"] and d["gen_running"] and (q["path"] == "fwd"):
            hazards.append({"port": n, "kind": "gen_flood",
                            "msg": f"P{n}'s generator runs into its PHY loopback and P{n ^ 1} "
                                   "forwards those frames out" + (" (LAN pair!)" if q["lan"] else "")})
    return {"lan_pairs": sorted(LAN_PAIRS), "ports": ports, "hazards": hazards,
            "safe": not hazards}


def cmd_safe(b, args):
    doc = safety_doc(b)
    if args.json:
        print(json.dumps(doc, indent=1))
    else:
        for d in doc["ports"]:
            phy = ("MDIO error" if d["phy_loopback"] is None else
                   "LOOPBACK" if d["phy_loopback"] else
                   "POWER-DOWN" if d["phy_powered_down"] else "normal")
            eff = "" if d["eff_path"] in (None, d["path"]) else f" (effective {d['eff_path']})"
            print(f"P{d['port']}: pair {d['pair']} {d['pair_mode']:<7}"
                  f"{' LAN' if d['lan'] else '    '}  path {d['path']:<6}{eff}  PHY {phy:<10}"
                  f"{'  held by watch' if d['watch_held'] else ''}"
                  f"{'  generator running' if d['gen_running'] else ''}")
        for h in doc["hazards"]:
            print(f"  UNSAFE P{h['port']}: {h['msg']}")
        print("SAFE: no reflecting combination" if doc["safe"] else
              f"UNSAFE: {len(doc['hazards'])} reflecting combination(s)")
    if not doc["safe"]:
        raise SystemExit(2)


def hold_link_down(b, n):
    """Take port n's copper link down the safe way (watch's hold, test linkdown).
    P1-P3: PHY power-down. P0 (never powered down): path 0 idle FIRST, wait until
    EFF_PATH confirms it (nothing is forwarded into P0 any more), THEN MII loopback.
    -> list of the steps done, in order."""
    if n != 0:
        b.phy_power_down(n)
        return [f"BMCR[11] power-down P{n}"]
    steps = []
    if b.path_of(0) != "idle":
        steps.append(f"path 0 {b.path_of(0)} -> idle")
        b.set_port_path(0, "idle")
    if not b.wait_eff_path(0, "idle"):
        raise RuntimeError("P0's EFF_PATH did not become idle within 0.2 s: MII loopback NOT set")
    steps.append("EFF_PATH P0 idle confirmed")
    b.phy_loopback(0, True)                   # re-checks tx_into(0) itself
    steps.append("BMCR[14] MII loopback P0")
    return steps


def release_link_down(b, n, restore_fwd=True):
    """Undo hold_link_down: power-up / loopback off (+ AN restart), SGMII re-trigger,
    BMCR re-check (one retry); for P0 last of all path 0 fwd again, if restore_fwd and
    pair 0 is (still) in TAP mode. -> (steps, recheck_ok)."""
    bit = BMCR_LOOPBACK if n == 0 else BMCR_PWRDN
    undo = (lambda: b.phy_loopback(0, False)) if n == 0 else (lambda: b.phy_power_on(n))
    undo()
    steps = ["BMCR[14] cleared + AN restart" if n == 0 else "BMCR[11] cleared + AN restart"]
    b.sgmii_retrigger(n)
    steps.append("SGMII re-trigger")
    ok = not b.mdio_rd(PHY_ADDR[n], BMCR) & bit
    if not ok:
        undo()
        ok = not b.mdio_rd(PHY_ADDR[n], BMCR) & bit
    steps.append("BMCR re-check " + ("ok" if ok else "FAILED after a retry"))
    if n == 0 and restore_fwd and ok and b.pair_modes()[0] == "tap" and b.path_of(0) == "idle":
        b.set_port_path(0, "fwd")
        steps.append("path 0 idle -> fwd")
    return steps, ok


def cmd_test(b, args):
    n = args.port
    if not 0 <= n <= 3:
        raise SystemExit("pktrec-phy: port must be 0..3")
    if args.test_cmd == "linkdown":
        b.need_tap()
        if n in LAN_PORTS:
            lan_gate([f"P{n} is on the LAN pair {n // 2} (router-facing): its link loss "
                      "reaches the LAN" + (" and P0's method is MII loopback" if n == 0 else "")],
                     f"test linkdown P{n}", args.i_accept_lan_loop)
        steps = hold_link_down(b, n)
        print(f"P{n}: copper link held down: " + ", ".join(steps))
    else:
        steps, ok = release_link_down(b, n)
        print(f"P{n}: released: " + ", ".join(steps))
        if not ok:
            raise SystemExit(1)


def init_phy(b, n, only1000, sfd):
    a = PHY_ADDR[n]
    id1, id2 = b.mdio_rd(a, PHYIDR1), b.mdio_rd(a, PHYIDR2)
    if id1 != 0x2000 or (id2 & 0xFFF0) != 0xA230:
        print(f"P{n}: PHY @0x{a:02x} ID {id1:04x}:{id2:04x} is not a DP83867 - skipped")
        return False
    cfg4 = b.mdio_rd(a, CFG4)
    # mirror mode (OP080 layout; Rev-A boards are not strapped for it) and SGMII AN
    # timer 16 ms (CFG4[6:5] = 00, as the Linux dp83867 driver sets)
    b.mdio_wr(a, CFG4, (cfg4 & ~0x0060) | 0x0001)
    b.mdio_rmw(a, PHYCR, 0, 0x0800)            # SGMII_EN
    b.mdio_rmw(a, SGMIICTL1, 0x4000, 0)        # 4-wire SGMII (no 625 MHz clock)
    b.mdio_rmw(a, CFG2, 0, 0x0080)             # SGMII auto-negotiation enable
    if only1000:
        b.mdio_rmw(a, ANAR, 0x01E0, 0)         # no 10/100
        b.mdio_rmw(a, CFG1, 0x0100, 0x0200)    # 1000FD only
    else:
        b.mdio_rmw(a, ANAR, 0, 0x01E0)         # strap default: 10/100/1000 HD+FD
        b.mdio_rmw(a, CFG1, 0, 0x0300)
    if sfd:
        # GPIO_MUX_CTRL 0x0012: GPIO_0 = RX SFD, GPIO_1 = TX SFD. Verified on the
        # bench (2026-10-13): GPIO0 edges == RX_GOOD and GPIO1 edges == TX_GOOD on
        # all ports. (0x0120, from a reading of TI SNLA242, only put RX SFD on
        # GPIO_1 and left GPIO_0 at its default.)
        b.mdio_wr(a, RXFCFG, 0x1080)
        b.mdio_wr(a, GPIO_MUX_CTRL, 0x0012)
        b.mdio_wr(a, SYNC_FIFO_CTRL, 0xDF22)
    b.mdio_rmw(a, BMCR, 0x4C00, 0x1000)        # AN on, not powered down / isolated / looped
    b.mdio_wr(a, CTRL, 0x4000)                 # SW_RESTART (registers kept)
    time.sleep(0.01)
    print(f"P{n}: PHY @0x{a:02x} configured (strap mirror={'on' if cfg4 & 1 else 'OFF (Rev-A)'}, "
          f"{'1000FD only' if only1000 else '10/100/1000'}, SFD {'on' if sfd else 'off'})")
    return True


def cmd_init(b, args):
    g = b.eth.rd(ETH_GCTRL)
    if args.reset:
        b.eth.wr(ETH_GCTRL, g & ~0x0F00)        # assert all PHY resets
        time.sleep(0.01)
    if args.reset or (g & 0x0F00) != 0x0F00:
        b.eth.wr(ETH_GCTRL, (g & ~0x0F00 & ~0x1) | 0x0F00)
        time.sleep(0.05)                       # >= 1 ms after reset release
    elif g & 1:
        b.eth.wr(ETH_GCTRL, g & ~0x1)          # release the transceivers
    ok = [init_phy(b, n, args.only1000, not args.no_sfd) for n in range(4)]
    if args.wait > 0:
        print(f"waiting up to {args.wait:.0f} s for copper links "
              "(re-triggering SGMII on each link-up)...")
        watch_loop(b, args.wait, 0.2, [n for n in range(4) if ok[n]], quiet=False)
    cmd_status(b, args)


def speed_str(code):
    return {0: "10M", 1: "100M", 2: "1G"}.get(code, "?")


def status_doc(b):
    """Link status as a dict (the JSON document of 'status --json')."""
    gs = b.eth.rd(ETH_GSTATUS)
    io = b.m0.rd(M0_IO_STATUS)
    mode = b.m0.rd(M0_PATH_CTRL)
    doc = {"gtpowergood": gs & 1, "qpll0_lock": (gs >> 1) & 1,
           "phy_reset_n": (b.eth.rd(ETH_GCTRL) >> 8) & 0xF,
           "pg_1v0": (io >> 8) & 1, "pg_2v5": (io >> 9) & 1, "ports": []}
    for n in range(4):
        a = PHY_ADDR[n]
        cu = {"up": None, "speed": None, "full_duplex": None, "error": None,
              "phy_loopback": None, "phy_powered_down": None}
        try:
            bmcr = b.mdio_rd(a, BMCR)
            if bmcr != 0xFFFF:
                cu["phy_loopback"] = bool(bmcr & BMCR_LOOPBACK)
                cu["phy_powered_down"] = bool(bmcr & BMCR_PWRDN)
            bmsr = b.mdio_rd(a, BMSR)
            bmsr = b.mdio_rd(a, BMSR)          # link bit latches low: read twice
            st = b.mdio_rd(a, PHYSTS)
            cu["up"] = bool(bmsr & 0x4)
            if cu["up"]:
                cu["speed"] = speed_str((st >> 14) & 3)
                cu["full_duplex"] = bool(st & 0x2000)
        except RuntimeError as e:
            cu["error"] = str(e)
        s = b.eth_port(n, P_STATUS)
        doc["ports"].append({
            "port": n, "phy_addr": a, "copper": cu,
            "pcs": {"sync": s & 1, "an": "done" if s & 2 else ("run" if s & 4 else "idle"),
                    "an_timeout": bool(s & 8), "lp_link": (s >> 5) & 1,
                    "speed": speed_str((s >> 6) & 3), "full_duplex": bool(s & 0x100)},
            "lp_adv": b.eth_port(n, P_LP_ADV), "link_up": (s >> 11) & 1,
            "gpio0": (io >> n) & 1, "gpio1": (io >> (4 + n)) & 1,
            "path": MODE_NAMES[(mode >> (2 * n)) & 3],
            "phy_loopback": cu["phy_loopback"], "phy_powered_down": cu["phy_powered_down"]})
    doc["pairs"] = [{"pair": p, "ports": [2 * p, 2 * p + 1], "mode": m}
                    for p, m in enumerate(b.pair_modes())]
    return doc


def cmd_status(b, args):
    doc = status_doc(b)
    if getattr(args, "json", False):
        print(json.dumps(doc, indent=1))
        return
    print(f"eth_ports: gtpowergood={doc['gtpowergood']} qpll0_lock={doc['qpll0_lock']} "
          f"phy_reset_n=0x{doc['phy_reset_n']:x} "
          f"PG_1V0={doc['pg_1v0']} PG_2V5={doc['pg_2v5']}")
    print("port phy  copper            sgmii/pcs                         lp_adv  link_up "
          "gpio0 gpio1 path")
    for p in doc["ports"]:
        cu = p["copper"]
        if cu["error"]:
            copper = f"MDIO error: {cu['error']}"
        elif cu["up"]:
            copper = f"up {cu['speed']:>4} {'FD' if cu['full_duplex'] else 'HD'}"
        else:
            copper = "down"
        if cu.get("phy_loopback"):
            copper += " (PHY loop)"
        elif cu.get("phy_powered_down"):
            copper += " (PHY PD)"
        c = p["pcs"]
        pcs = (f"sync={c['sync']} an={c['an']}{' TIMEOUT' if c['an_timeout'] else ''} "
               f"lp_link={c['lp_link']} {c['speed']} {'FD' if c['full_duplex'] else 'HD'}")
        print(f"P{p['port']}   0x{p['phy_addr']:02x} {copper:<17} {pcs:<33} 0x{p['lp_adv']:04x}  "
              f"{p['link_up']}       {p['gpio0']}     {p['gpio1']}     {p['path']}")
    print("pair modes: " + ", ".join(f"pair {q['pair']} (P{q['ports'][0]}/P{q['ports'][1]}) {q['mode']}"
                                     for q in doc["pairs"]))


def cmd_path(b, args):
    ports = range(4) if args.port == "all" else [int(args.port.lstrip("pP"))]
    m = b.m0.rd(M0_PATH_CTRL) & 0xFF
    rpl = b.replay_ports()
    for n in ports:
        if not 0 <= n <= 3:
            raise SystemExit("port must be 0..3 or all")
    for n in ports:                            # loop safety, before anything is written
        if args.mode == "idle":
            continue
        looped = b.phy_looped(n)
        if args.mode == "loop":
            why = [] if b.path_of(n) == "loop" else loop_hazards(b, n)
            if looped:
                why.append(f"P{n}'s PHY is in MII loopback: frames would circulate")
            if n in LAN_PORTS:
                why.append(f"P{n} is on the LAN pair {n // 2}: path loop sends the network's "
                           "own traffic back to it")
            lan_gate(why, f"path {n} loop", args.i_accept_lan_loop)
        elif looped:
            lan_gate([f"P{n}'s PHY is in MII loopback (BMCR[14]): whatever path {args.mode} "
                      f"sends into P{n} comes straight back on its RX"],
                     f"path {n} {args.mode}", args.i_accept_lan_loop)
    for n in ports:
        partner = n ^ 1
        if args.mode == "replay":
            if not b.has_replay():
                raise SystemExit("pktrec-phy: this bitstream has no replay path (m0 map < 1.3)")
            if ((m >> (2 * n)) & 3) == MODES["fwd"] or ((m >> (2 * partner)) & 3) == MODES["fwd"]:
                raise SystemExit(f"pktrec-phy: pair {n // 2} forwards (TAP): replay and TAP "
                                 f"forwarding on the same pair are mutually exclusive "
                                 f"(pktrec-phy mode {n // 2} monitor first)")
            m &= ~(3 << (2 * n))               # IDLE underneath the replay override
            rpl |= 1 << n
        else:
            if args.mode == "fwd" and (rpl >> partner) & 1 and partner not in ports:
                raise SystemExit(f"pktrec-phy: P{partner} is in replay: replay and TAP "
                                 "forwarding on the same pair are mutually exclusive")
            m = (m & ~(3 << (2 * n))) | (MODES[args.mode] << (2 * n))
            rpl &= ~(1 << n)
    b.write_path(m)
    if b.has_replay():
        b.m0.wr(M0_PATH_RPL, rpl)
    print("PATH_CTRL = 0x%02x (%s)" % (m, ", ".join(
        f"P{n}={'replay' if (rpl >> n) & 1 else MODE_NAMES[(m >> (2 * n)) & 3]}"
        for n in range(4))))


def cmd_counters(b, args):
    vals = {name: [b.m0.rd(M0_PORT_BASE + n * M0_PORT_STRIDE + 4 * i) for n in range(4)]
            for i, name in enumerate(M0_COUNTERS)}
    vals["MAC_STICKY"] = [b.eth_port(n, P_STICKY) for n in range(4)]
    if args.json:
        print(json.dumps({"ports": [{k.lower(): v[n] for k, v in vals.items()} | {"port": n}
                                    for n in range(4)], "cleared": bool(args.clear)}, indent=1))
    else:
        print(f"{'':14}" + "".join(f"{'P%d' % n:>12}" for n in range(4)))
        for name in M0_COUNTERS:
            print(f"{name:14}" + "".join(f"{v:>12}" for v in vals[name]))
        print(f"{'MAC_STICKY':14}" + "".join(f"{'0x%02x' % v:>12}" for v in vals["MAC_STICKY"]))
    if args.clear:
        b.m0.wr(M0_CNT_CTRL, 1)
        for n in range(4):
            b.eth.wr(ETH_PORT_BASE + n * ETH_PORT_STRIDE + P_STICKY, 0x1F)
        if not args.json:
            print("counters cleared")


class EventLog:
    """Timestamped action log for 'watch' (text, or one JSON object per line)."""

    def __init__(self, as_json=False):
        self.as_json = as_json

    def __call__(self, port, event, msg, **kw):
        if self.as_json:
            print(json.dumps({"time": time.strftime("%Y-%m-%dT%H:%M:%S"), "port": port,
                              "event": event, "msg": msg} | kw), flush=True)
        else:
            print(f"{time.strftime('%H:%M:%S')} " + (f"P{port}: " if port is not None else "")
                  + msg, flush=True)


def read_watch_state(path=None):
    try:
        with open(path or WATCH_STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_watch_state(doc, path=None):
    path = path or WATCH_STATE
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump(doc, f, indent=1)
            f.write("\n")
        os.replace(tmp, path)
    except OSError:
        pass


class Propagator:
    """Link-state propagation for pairs in TAP mode (watch).

    A port whose copper link has been down for `debounce` s makes us hold its
    partner with its copper link down, so the device on the partner's side sees
    link down, as on a direct cable (hold_link_down):
      - P1, P2, P3: PHY power-down (BMCR[11]). The MDI goes down; nothing can be
        reflected. MDIO keeps working.
      - P0 must never be powered down: its DP83867's CLK_OUT clocks P1-P3 (P0
        guard; bench 2026-10-13: a power-down of P0 silenced P1-P3). So, in this
        order: (1) path 0 idle - PATH_CTRL only, PAIR_MODE stays tap - and wait for
        EFF_PATH to confirm it (nothing is forwarded into P0 any more), (2) only
        then MII loopback (BMCR[14]). If EFF_PATH does not confirm, no loopback.
    When the port's link has been up again for `debounce` s, the partner is
    released (release_link_down), in this order: power-up / loopback cleared + AN
    restart, SGMII re-trigger, BMCR re-check (one retry), and for P0 last of all
    path 0 fwd again (only while pair 0 is still in TAP mode).

    Why not MII loopback everywhere (fix round 1): a loopback on a port that is
    forwarded into reflects the far side's traffic back at it. The hold itself was
    safe (the held port's partner had no link), but it made loopback look like a
    harmless way to drop a link, and that is how the LAN outage of 2026-10-13 was
    caused (MII loopback forced by hand on P1 while pair 0 forwarded). Loopback is
    now used only on P0, and only after its forward path is idle.

    Guards against ping-pong:
      - a port WE hold never propagates (its link-down is our doing);
      - a port we just released gets `grace` s (copper auto-negotiation takes
        ~3 s) before its own link-down counts;
      - at start every port gets `grace` s too.
    If someone else undoes a hold (pktrec-phy init, mdio), we notice and forget it
    (P0: path 0 fwd restored). When a pair leaves TAP mode, or watch exits, every
    port held here is released.

    The held ports are recorded in $PKTREC_RUN_DIR/phy-watch.json, so a restarted
    watch releases exactly the holds a previous instance left (and not a loopback
    or power-down somebody set by hand for a test, e.g. pktrec-phy test linkdown)."""

    def __init__(self, b, log, debounce=0.5, grace=6.0, saved=None):
        self.b, self.log, self.debounce, self.grace = b, log, debounce, grace
        now = time.monotonic()
        self.held = [False] * 4             # held link-down by us
        self.state = [None] * 4             # last copper link state
        self.t_change = [now] * 4
        self.grace_until = [now + grace] * 4
        prev = set((saved or {}).get("held", []))
        for n in sorted(prev):
            # a hold left by a previous watch (crash / restart): power-down (P1-P3),
            # loopback (P0; also an MII loopback left on P1-P3 by a fix-round-1 watch)
            bm = self.b.mdio_rd(PHY_ADDR[n], BMCR)
            if bm != 0xFFFF and bm & (BMCR_PWRDN | BMCR_LOOPBACK):
                if n != 0 and bm & BMCR_LOOPBACK:
                    self.b.phy_loopback(n, False)
                self.release(n, now, "left held by a previous watch")

    def held_ports(self):
        return [n for n in range(4) if self.held[n]]

    def hold(self, n, now, reason):
        try:
            steps = hold_link_down(self.b, n)
        except RuntimeError as e:
            if n == 0 and self.b.pair_modes()[0] == "tap" and not self.b.phy_looped(0):
                self.b.set_port_path(0, "fwd")
            self.log(n, "hold_failed", f"hold NOT applied ({reason}): {e}", reason=reason)
            return
        self.held[n] = True
        how = "path idle + MII loopback" if n == 0 else "PHY power-down"
        self.log(n, "hold", f"held link-down by {how}: copper link DOWN ({reason}) "
                 f"[{' -> '.join(steps)}]", reason=reason, method=how, steps=steps)

    def release(self, n, now, reason):
        steps, ok = release_link_down(self.b, n)
        self.held[n] = False
        self.grace_until[n] = now + self.grace
        self.log(n, "release", f"released ({reason}) [{' -> '.join(steps)}]",
                 reason=reason, recheck_ok=ok, steps=steps)

    def release_all(self, reason):
        now = time.monotonic()
        for n in range(4):
            if self.held[n]:
                self.release(n, now, reason)

    def still_held(self, n):
        bm = self.b.mdio_rd(PHY_ADDR[n], BMCR)
        return bool(bm & (BMCR_LOOPBACK if n == 0 else BMCR_PWRDN))

    def step(self, now, links):
        for n in range(4):
            if links.get(n) is None:
                continue
            if links[n] != self.state[n]:
                self.state[n] = links[n]
                self.t_change[n] = now
        tap = self.b.pair_modes()
        if not self.b.has_tap() and self.held[0]:
            tap[0] = "tap"                  # no PAIR_MODE register: P0's idle path is ours
        for pair in range(2):
            a, c = 2 * pair, 2 * pair + 1
            if tap[pair] != "tap":
                for x in (a, c):
                    if self.held[x]:
                        self.release(x, now, f"pair {pair} left TAP mode")
                continue
            for x in (a, c):                    # hold undone by someone else?
                if self.held[x] and not self.still_held(x):
                    self.held[x] = False
                    self.grace_until[x] = now + self.grace
                    extra = ""
                    if x == 0 and self.b.path_of(0) == "idle":
                        self.b.set_port_path(0, "fwd")
                        extra = "; path 0 fwd restored"
                    self.log(x, "external_release", "hold was undone by someone else; "
                             "no longer held" + extra)
            for x, y in ((a, c), (c, a)):
                if self.state[x] is None or now - self.t_change[x] < self.debounce:
                    continue
                if self.state[x] is False and not self.held[x] and not self.held[y] \
                        and now >= self.grace_until[x]:
                    self.hold(y, now, f"P{x} link down")
                elif self.state[x] is True and self.held[y]:
                    self.release(y, now, f"P{x} link up")


class SkewCorrector:
    """Per-link-up RX latency correction from the DP83867 skew FIFO status (0x0055).

    Bench 2026-10-13 (M2 session A, 19 link-ups of P2<->P3, TX-SFD -> RX-SFD of the
    same frames, 1 ns sampler): the latency of a link is constant within a link-up
    but takes one of two values per link-up. On the 1000BASE-T master's receive
    side it is 8 ns longer exactly when that PHY's 0x0055 reads non-zero (0x0111 /
    0x1011 in 6 of 16 link-ups, 244.5 instead of 236.5 ns); the slave's 0x0055 was
    always 0 and its RX latency never moved. The datasheet: [7:4] x 8 ns in leader,
    [3:0] x 8 ns in follower mode, constant per link-up. So `ns` (8) of extra RX
    latency is taken off this link-up's timestamps: RX_OFFSET = base - ns while
    0x0055 != 0, = base otherwise. The raw value is logged; it is not scaled by its
    fields (only the two non-zero values above were seen, both meaning +8 ns).

    base = the calibrated RX_OFFSET (pktrec-tb apply-calibration, sfd config). A
    register value we did not write is adopted as the new base and the current
    correction is re-applied on top (apply-calibration runs after watch at boot).
    State (base / correction / written) in $PKTREC_RUN_DIR/phy-watch.json:
    pktrec-tb save-calibration stores the base, not the corrected value."""

    def __init__(self, b, log, ns=8, settle=1.0, saved=None):
        self.b, self.log, self.ns, self.settle = b, log, int(ns), settle
        self.ok = True
        try:
            self.c = b.cap
        except SystemExit as e:
            self.ok = False
            log(None, "skew_off", f"0x0055 RX correction off: {e}")
            return
        self.base, self.corr, self.written = [0] * 4, [0] * 4, [0] * 4
        self.reg55, self.master = [None] * 4, [None] * 4
        self.pending = {}
        sv = (saved or {}).get("skew") or []
        for n in range(4):
            r = self.read(n)
            p = sv[n] if n < len(sv) and isinstance(sv[n], dict) else {}
            if p.get("written") == r and "base" in p:  # our own earlier correction
                self.base[n], self.corr[n] = p["base"], p.get("corr", 0)
                self.reg55[n], self.master[n] = p.get("reg55"), p.get("master")
            else:
                self.base[n] = r
            self.written[n] = r

    def off(self, n):
        return SFD_PORT_BASE + n * SFD_PORT_STRIDE + 0x38

    def read(self, n):
        return s32(self.c.rd(self.off(n)))

    def write(self, n):
        v = self.base[n] + self.corr[n]
        self.c.wr(self.off(n), v & 0xFFFFFFFF)
        self.written[n] = v

    def link_up(self, n, now):
        if self.ok:
            self.pending[n] = now + self.settle

    def link_down(self, n):
        self.pending.pop(n, None)

    def doc(self):
        if not self.ok:
            return None
        return [{"port": n, "base": self.base[n], "corr": self.corr[n], "written": self.written[n],
                 "reg55": self.reg55[n], "master": self.master[n]} for n in range(4)]

    def step(self, now):
        """-> True when something changed (state file update)."""
        if not self.ok:
            return False
        changed = False
        for n in range(4):
            r = self.read(n)
            if r != self.written[n]:
                self.base[n], self.written[n] = r, r
                msg = f"RX_OFFSET set to {r} ns by someone else: new calibration base"
                if self.corr[n]:
                    self.write(n)
                    msg += f", 0x0055 correction {self.corr[n]:+d} ns re-applied -> {self.written[n]} ns"
                self.log(n, "rx_offset_base", msg, base=r, rx_offset=self.written[n])
                changed = True
        for n, due in list(self.pending.items()):
            if now < due:
                continue
            del self.pending[n]
            a = PHY_ADDR[n]
            v = self.b.mdio_rd(a, SKEW_FIFO_STS)
            ms = (self.b.mdio_rd(a, STS1) >> 14) & 1
            corr = -self.ns if v else 0
            self.reg55[n], self.master[n] = v, bool(ms)
            old = self.written[n]
            self.corr[n] = corr
            if self.base[n] + corr != old:
                self.write(n)
            self.log(n, "rx_skew", f"link-up: 0x0055 = 0x{v:04x} (1000BASE-T "
                     f"{'master' if ms else 'slave'}) -> RX_OFFSET {self.base[n]} {corr:+d} = "
                     f"{self.written[n]} ns" + ("" if old == self.written[n] else f" (was {old})"),
                     reg55=v, master=bool(ms), base=self.base[n], corr=corr,
                     rx_offset=self.written[n])
            changed = True
        return changed


def watch_loop(b, duration, interval, ports, quiet, prop=None, log=None, skew=None,
               on_change=None):
    """Poll the copper link of each PHY; on every change re-trigger the SGMII config
    word. Also re-trigger when copper is up but the PCS has no SGMII link (missed
    word), at most once per second per port. With a Propagator, propagate link
    state across TAP pairs (see Propagator); with a SkewCorrector, apply the 0x0055
    RX correction after every link-up."""
    log = log or EventLog()
    last = {n: None for n in ports}
    last_fix = {n: 0.0 for n in ports}
    t_end = None if duration is None else time.monotonic() + duration
    while t_end is None or time.monotonic() < t_end:
        now = time.monotonic()
        links = {}
        changed = False
        for n in ports:
            try:
                up = b.copper_link(n)
            except RuntimeError as e:
                log(n, "mdio_error", str(e))
                continue
            links[n] = up
            s = b.eth_port(n, P_STATUS)
            stale = up and not (s & 0x20) and now - last_fix[n] > 1.0
            if up != last[n] or stale:
                b.sgmii_retrigger(n)
                last_fix[n] = now
                if last[n] is not None or up or not quiet:
                    why = "stale SGMII status" if (up == last[n]) else f"copper link {'up' if up else 'down'}"
                    log(n, "sgmii_retrigger", f"{why} -> SGMII re-triggered",
                        link=up, stale=bool(stale and up == last[n]))
                if skew is not None and up != last[n]:
                    skew.link_up(n, now) if up else skew.link_down(n)
                last[n] = up
        if prop is not None:
            held = prop.held_ports()
            try:
                prop.step(now, links)
            except RuntimeError as e:
                log(None, "mdio_error", f"propagation: {e}")
            changed |= held != prop.held_ports()
        if skew is not None:
            try:
                changed |= skew.step(now)
            except RuntimeError as e:
                log(None, "mdio_error", f"0x0055 correction: {e}")
        if changed and on_change:
            on_change()
        if t_end is not None and all(last[n] for n in ports) and \
                all(b.eth_port(n, P_STATUS) & 0x800 for n in ports):
            return
        time.sleep(interval)


def cmd_watch(b, args):
    import signal
    log = EventLog(args.json)
    saved = read_watch_state()
    prop = skew = None
    if not args.no_propagate:
        prop = Propagator(b, log, args.debounce, args.grace, saved)
    if not args.no_0055_correction:
        skew = SkewCorrector(b, log, args.skew_ns, saved=saved)

    def save():
        write_watch_state({"pid": os.getpid(), "updated": time.strftime("%Y-%m-%dT%H:%M:%S"),
                           "propagation": prop is not None,
                           "held": prop.held_ports() if prop else [],
                           "skew_correction_ns": None if skew is None or not skew.ok else skew.ns,
                           "skew": skew.doc() if skew else None})
    save()
    log(None, "start", f"watch: SGMII re-trigger on link changes, link-state propagation "
        f"{'OFF' if prop is None else f'ON (P1-P3 power-down, P0 path idle + MII loopback; debounce {args.debounce} s, grace {args.grace} s)'}"
        f", 0x0055 RX correction "
        f"{'OFF' if skew is None or not skew.ok else f'ON ({skew.ns} ns)'}"
        f"; pair modes {', '.join(b.pair_modes())}")
    # systemd stops the service with SIGTERM: leave no port held
    signal.signal(signal.SIGTERM, lambda *a: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        watch_loop(b, None, args.interval, list(range(4)), quiet=True, prop=prop, log=log,
                   skew=skew, on_change=save)
    except KeyboardInterrupt:
        pass
    finally:
        if prop is not None:
            prop.release_all("watch exiting")
        save()
        log(None, "stop", "watch stopped")


# ---------------------------------------------------------------------------
# TAP mode (m0 map 1.2): per-pair mode, dynamic IFG
# ---------------------------------------------------------------------------
def mode_doc(b):
    m = b.m0.rd(M0_PATH_CTRL)
    eff = b.m0.rd(M0_EFF_PATH) if b.has_tap() else None
    pairs = []
    for p, mode in enumerate(b.pair_modes()):
        ports = [2 * p, 2 * p + 1]
        path = [MODE_NAMES[(m >> (2 * n)) & 3] for n in ports]
        want = {"tap": "fwd", "monitor": "idle"}.get(mode)
        pairs.append({"pair": p, "ports": ports, "mode": mode, "path": path,
                      "eff_path": None if eff is None else [MODE_NAMES[(eff >> (2 * n)) & 3]
                                                           for n in ports],
                      "consistent": all(x == want for x in path)})
    return {"pair_mode_reg": b.m0.rd(M0_PAIR_MODE) if b.has_tap() else None,
            "path_ctrl": m, "capture_running": b.capture_running(), "pairs": pairs}


def print_mode(doc):
    for q in doc["pairs"]:
        note = "" if q["consistent"] else "  (ports not both " + \
            ("fwd" if q["mode"] == "tap" else "idle") + ": loop/gen/mixed)"
        eff = "" if q["eff_path"] is None or q["eff_path"] == q["path"] else \
            f"  effective now {'/'.join(q['eff_path'])}"
        print(f"pair {q['pair']} (P{q['ports'][0]}/P{q['ports'][1]}): {q['mode']:<8} "
              f"path {'/'.join(q['path'])}{eff}{note}")


def cmd_mode(b, args):
    if args.what == "status":
        doc = mode_doc(b)
        print(json.dumps(doc, indent=1)) if args.json else print_mode(doc)
        return
    try:
        pair = int(args.what)
        assert pair in (0, 1)
    except (ValueError, AssertionError):
        raise SystemExit("pktrec-phy: mode <pair 0|1> tap|monitor  or  mode status")
    if args.mode not in PAIR_MODES:
        raise SystemExit("pktrec-phy: mode <pair 0|1> tap|monitor")
    run = b.capture_running()
    if run and not args.force:
        raise SystemExit("pktrec-phy: a capture is running (capture CTRL.ENABLE = 1); stop it "
                         "first or use --force (frames in flight at the switch are flushed "
                         "and counted in FLUSH)")
    if run is None:
        print("note: capture state unknown (capture block not mapped)")
    rpl = b.replay_ports() & (3 << (2 * pair))
    if rpl and args.mode == "tap":
        if not args.force:
            raise SystemExit(f"pktrec-phy: a port of pair {pair} is in replay (PATH_RPL 0x{rpl:x}; "
                             "pktrec-replay running?): replay and TAP forwarding on the same pair "
                             "are mutually exclusive; --force takes the port out of replay")
        b.m0.wr(M0_PATH_RPL, b.replay_ports() & ~rpl)
    if args.mode == "tap":                     # loop safety: --force does not override
        held = watch_holds()
        why = [f"P{n}'s PHY is in MII loopback (BMCR[14])" +
               (" - held by pktrec-phy-watch until its partner's link returns" if n in held else "")
               for n in (2 * pair, 2 * pair + 1) if b.phy_looped(n)]
        lan_gate(why, f"mode {pair} tap (forwarding into a looped PHY)", args.i_accept_lan_loop)
    if not b.has_tap():
        print("note: no PAIR_MODE register in this bitstream (m0 map < 1.2): only PATH_CTRL is set")
    path = MODES["fwd" if args.mode == "tap" else "idle"]
    m = b.m0.rd(M0_PATH_CTRL) & 0xFF
    for n in (2 * pair, 2 * pair + 1):
        m = (m & ~(3 << (2 * n))) | (path << (2 * n))
    b.write_path(m)
    if b.has_tap():                            # TX side switches at the next frame boundary
        t0 = time.monotonic()
        while time.monotonic() - t0 < 0.2 and \
                (b.m0.rd(M0_EFF_PATH) >> (4 * pair)) & 0xF != (m >> (4 * pair)) & 0xF:
            time.sleep(0.005)
    if args.mode == "tap":
        # both sides must negotiate the same speed: the FIFO cannot bridge 1G <-> 100M
        sp = []
        for n in (2 * pair, 2 * pair + 1):
            s = b.eth_port(n, P_STATUS)
            sp.append(speed_str((s >> 6) & 3) if s & 0x800 else None)
        if sp[0] and sp[1] and sp[0] != sp[1]:
            print(f"WARNING: P{2 * pair} links at {sp[0]}, P{2 * pair + 1} at {sp[1]}: a TAP needs "
                  "the same speed on both sides (pktrec-phy init --1000-only)")
    print_mode(mode_doc(b))


def ifg_doc(b, n):
    m = b.m0
    base = M0_PORT_BASE + n * M0_PORT_STRIDE
    ctrl, thr, fill, st = (m.rd(base + P_IFG_CTRL), m.rd(base + P_IFG_THRESH),
                           m.rd(base + P_FWD_FILL), m.rd(base + P_IFG_STATUS))
    cyc = Board.rd64(m, base + P_IFG_RED_CYC)
    return {"port": n, "dyn_en": ctrl & 1, "ifg_nom": (ctrl >> 8) & 0xFF,
            "ifg_min": (ctrl >> 16) & 0xFF, "ifg_hi": thr & 0xFFFF, "ifg_lo": thr >> 16,
            "fwd_fill": fill & 0xFFFF, "fwd_fill_max": fill >> 16,
            "reduced": st & 1, "ifg_now": (st >> 8) & 0xFF,
            "reduced_cycles": cyc, "reduced_s": cyc * 16e-9,
            "reduced_entries": m.rd(base + P_IFG_RED_ENT), "flush": m.rd(base + P_FLUSH),
            "drop_fwd": m.rd(base + 0x14)}


def cmd_ifg(b, args):
    b.need_tap()
    ports = range(4) if args.port == "all" else [int(args.port.lstrip("pP"))]
    for n in ports:
        if not 0 <= n <= 3:
            raise SystemExit("port must be 0..3 or all")
        base = M0_PORT_BASE + n * M0_PORT_STRIDE
        ctrl, thr = b.m0.rd(base + P_IFG_CTRL), b.m0.rd(base + P_IFG_THRESH)
        if args.enable is not None:
            ctrl = (ctrl & ~1) | (args.enable == "on")
        for val, sh, what in ((args.nom, 8, "--nom"), (args.min, 16, "--min")):
            if val is not None:
                if not 2 <= val <= 255:
                    raise SystemExit(f"pktrec-phy: {what} must be 2..255 bytes")
                ctrl = (ctrl & ~(0xFF << sh)) | (val << sh)
        if args.hi is not None:
            thr = (thr & 0xFFFF0000) | (args.hi & 0xFFFF)
        if args.lo is not None:
            thr = (thr & 0xFFFF) | ((args.lo & 0xFFFF) << 16)
        if (thr >> 16) >= (thr & 0xFFFF):
            raise SystemExit("pktrec-phy: IFG_LO must be below IFG_HI")
        b.m0.wr(base + P_IFG_CTRL, ctrl)
        b.m0.wr(base + P_IFG_THRESH, thr)
    docs = [ifg_doc(b, n) for n in ports]
    if args.json:
        print(json.dumps({"ports": docs}, indent=1))
        return
    for d in docs:
        print(f"P{d['port']} TX: dynamic IFG {'on' if d['dyn_en'] else 'OFF'} "
              f"({d['ifg_nom']} B -> {d['ifg_min']} B above {d['ifg_hi']} B until below "
              f"{d['ifg_lo']} B FWD fill) | now {'REDUCED' if d['reduced'] else 'normal'} "
              f"gap {d['ifg_now']} B, FWD fill {d['fwd_fill']} B (max {d['fwd_fill_max']} of "
              f"16384) | reduced {d['reduced_s']:.6f} s in {d['reduced_entries']} episodes | "
              f"DROP_FWD {d['drop_fwd']} FLUSH {d['flush']}")


# ---------------------------------------------------------------------------
# TAP forwarding latency (SFD log FIFOs of the capture block)
# ---------------------------------------------------------------------------
def cmd_latency(b, args):
    c = b.cap
    if args.pair is not None:
        dirs = [(2 * args.pair + 1, 2 * args.pair), (2 * args.pair, 2 * args.pair + 1)]
    elif args.inp is not None and args.out is not None:
        dirs = [(args.inp, args.out)]
    else:
        raise SystemExit("pktrec-phy: latency needs --pair P or --in A --out B")
    ctrl0 = c.rd(SFD_CTRL) & 0x3
    c.wr(SFD_CTRL, ctrl0 | 0x2)                 # LOG_EN

    def pop(port, d):
        base = SFD_PORT_BASE + port * SFD_PORT_STRIDE
        st, ts = (SFD_RX_LOG_STATUS, SFD_RX_LOG_TS) if d == "rx" else (SFD_TX_LOG_STATUS, SFD_TX_LOG_TS)
        out = []
        while c.rd(base + st) & 0x1F:
            out.append(Board.rd64(c, base + ts))
        return out

    ins = sorted({i for i, _ in dirs})
    outs = sorted({o for _, o in dirs})
    for p in ins:
        pop(p, "rx")
    for p in outs:
        pop(p, "tx")
    ovf0 = {p: c.rd(SFD_PORT_BASE + p * SFD_PORT_STRIDE + SFD_RX_LOG_STATUS) >> 16 for p in ins}
    pend = {d: [] for d in dirs}
    lat = {d: [] for d in dirs}
    unmatched = {d: 0 for d in dirs}
    t_end = time.monotonic() + args.timeout
    try:
        while time.monotonic() < t_end and any(len(lat[d]) < args.count for d in dirs):
            rx = {p: pop(p, "rx") for p in ins}
            tx = {p: pop(p, "tx") for p in outs}
            for d in dirs:
                i, o = d
                pend[d].extend(rx[i])
                for t in tx[o]:
                    # the earliest pending RX frame that left on `o` within the window
                    while pend[d] and t - pend[d][0] > args.window:
                        pend[d].pop(0)
                        unmatched[d] += 1
                    if pend[d] and 0 < t - pend[d][0] <= args.window:
                        lat[d].append(t - pend[d].pop(0))
            time.sleep(0.005)
    except KeyboardInterrupt:
        pass
    finally:
        c.wr(SFD_CTRL, ctrl0)                   # LOG_EN back as it was
    res = []
    for (i, o) in dirs:
        v = sorted(lat[(i, o)])
        r = {"in": i, "out": o, "samples": len(v), "unmatched_rx": unmatched[(i, o)],
             "rx_offset_ns": s32(c.rd(SFD_PORT_BASE + i * SFD_PORT_STRIDE + 0x38)),
             "tx_offset_ns": s32(c.rd(SFD_PORT_BASE + o * SFD_PORT_STRIDE + 0xB8)),
             "rx_log_overflows": (c.rd(SFD_PORT_BASE + i * SFD_PORT_STRIDE + SFD_RX_LOG_STATUS) >> 16)
             - ovf0[i]}
        if v:
            med = v[len(v) // 2]
            inl = [x for x in v if abs(x - med) <= args.cluster]
            r.update(min_ns=v[0], median_ns=med, max_ns=v[-1], cluster_ns=args.cluster,
                     cluster_samples=len(inl), cluster_min_ns=inl[0], cluster_max_ns=inl[-1])
        res.append(r)
    if args.json:
        print(json.dumps({"label": args.label, "window_ns": args.window, "directions": res},
                         indent=1))
        return
    for r in res:
        if not r["samples"]:
            print(f"P{r['in']} -> P{r['out']}: no samples (traffic? 'pktrec-phy mode' tap? "
                  "SFD enabled by init?)")
            continue
        print(f"P{r['in']} -> P{r['out']}{' ' + args.label if args.label else ''}: "
              f"{r['samples']} frames, latency min {r['min_ns']} / median {r['median_ns']} / "
              f"max {r['max_ns']} ns; main cluster (median +-{r['cluster_ns']} ns): "
              f"{r['cluster_samples']} frames {r['cluster_min_ns']}..{r['cluster_max_ns']} ns "
              f"(TX SFD - RX SFD incl. RX_OFFSET {r['rx_offset_ns']} / TX_OFFSET "
              f"{r['tx_offset_ns']} ns; {r['unmatched_rx']} RX without TX in the window)")


def parse_int(s):
    return int(s, 0)


def cmd_mdio(b, args):
    p = args.phy.lower()
    phy = PHY_ADDR[int(p[1:])] if p.startswith("p") else parse_int(p)
    reg = parse_int(args.reg)
    if args.val is None:
        print(f"0x{b.mdio_rd(phy, reg):04x}")
        return
    val = parse_int(args.val)
    if reg == BMCR and val & BMCR_LOOPBACK and phy in PHY_ADDR:
        n = PHY_ADDR.index(phy)                # loop safety (no --force; see docstring)
        lan_gate(loop_hazards(b, n), f"mdio P{n} BMCR 0x{val:04x} (bit 14 MII loopback)",
                 args.i_accept_lan_loop)
    b.mdio_wr(phy, reg, val)


# ---------------------------------------------------------------------------
# SFD timestamping (capture block, PKTREC_SFD_*)
# ---------------------------------------------------------------------------
def s32(v):
    return v - (1 << 32) if v & 0x80000000 else v


def sfd_val(v, kind):
    if kind == "smin":                          # *_MIN reset value 0x7FFFFFFF = none yet
        return None if v in (SFD_NONE, 0x7FFFFFFF) else s32(v)
    if kind == "s":
        return None if v == SFD_NONE else s32(v)
    return v


def sfd_doc(b):
    c = b.cap
    st = c.rd(SFD_STATUS)
    ctrl = c.rd(SFD_CTRL)
    doc = {"match_en": ctrl & 1, "log_en": (ctrl >> 1) & 1, "sampler_locked": st & 1,
           "sampler": "iserdes" if st & 2 else "iddr", "resolution_ps": c.rd(SFD_RES_PS),
           "pipe_ns": c.rd(SFD_PIPE_NS),
           "rx_window_ns": [s32(c.rd(SFD_RX_WIN_MIN)), s32(c.rd(SFD_RX_WIN_MAX))],
           "tx_window_ns": [s32(c.rd(SFD_TX_WIN_MIN)), s32(c.rd(SFD_TX_WIN_MAX))],
           "min_low_cycles": c.rd(SFD_MIN_LOW), "min_high_cycles": c.rd(SFD_MIN_HIGH),
           "mac_offset_ns": s32(c.rd(0x0A8)), "tb_now_ns": Board.rd64(c, 0x090), "ports": []}
    for n in range(4):
        base = SFD_PORT_BASE + n * SFD_PORT_STRIDE
        p = {"port": n, "rx_level": (st >> (8 + n)) & 1, "tx_level": (st >> (12 + n)) & 1}
        for name, off, kind in SFD_PORT_REGS:
            p[name] = Board.rd64(c, base + off) if kind == 64 else sfd_val(c.rd(base + off), kind)
        p["rx_log_entries"] = c.rd(base + SFD_RX_LOG_STATUS) & 0x1F
        p["tx_log_entries"] = c.rd(base + SFD_TX_LOG_STATUS) & 0x1F
        # in-order pairing check: TX SFD edges vs MAC TX completions
        p["tx_edges_minus_cpl"] = p["tx_edges"] - p["tx_cpl"]
        doc["ports"].append(p)
    return doc


def fmt_ns(v):
    return "-" if v is None else str(v)


def cmd_sfd(b, args):
    c = b.cap
    if args.sfd_cmd == "status":
        doc = sfd_doc(b)
        if args.clear:
            c.wr(SFD_CTRL, (c.rd(SFD_CTRL) & 0x3) | 0x100)
        if args.json:
            print(json.dumps(doc, indent=1))
            return
        print(f"SFD sampler: {doc['sampler']} locked={doc['sampler_locked']} "
              f"resolution {doc['resolution_ps']} ps, pipe {doc['pipe_ns']} ns; "
              f"match={'on' if doc['match_en'] else 'OFF'} log={'on' if doc['log_en'] else 'off'}; "
              f"RX window {doc['rx_window_ns']} ns, TX window {doc['tx_window_ns']} ns; "
              f"filter low>={doc['min_low_cycles']} high>={doc['min_high_cycles']} cycles; "
              f"MAC_OFFSET {doc['mac_offset_ns']} ns")
        rows = [("rx_edges", "RX_EDGES"), ("rx_matched", "RX_MATCHED"), ("rx_mismatch", "RX_MISMATCH"),
                ("rx_stale", "RX_STALE"), ("rx_glitch", "RX_GLITCH"), ("rx_fifo_ovf", "RX_FIFO_OVF"),
                ("rx_delta_last", "RX_DELTA_LAST"), ("rx_delta_min", "RX_DELTA_MIN"),
                ("rx_delta_max", "RX_DELTA_MAX"), ("rx_head_delta", "RX_HEAD_DELTA"),
                ("rx_offset", "RX_OFFSET"), ("rx_last_ts", "RX_LAST_TS"),
                ("tx_edges", "TX_EDGES"), ("tx_cpl", "TX_CPL"), ("tx_edges_minus_cpl", "TX_EDGES-CPL"),
                ("tx_paired", "TX_PAIRED"), ("tx_unpaired", "TX_UNPAIRED"),
                ("tx_cpl_stale", "TX_CPL_STALE"), ("tx_glitch", "TX_GLITCH"),
                ("tx_cpl_ovf", "TX_CPL_OVF"), ("tx_lat_last", "TX_LAT_LAST"),
                ("tx_lat_min", "TX_LAT_MIN"), ("tx_lat_max", "TX_LAT_MAX"),
                ("tx_head_lat", "TX_HEAD_LAT"), ("tx_offset", "TX_OFFSET"), ("tx_last_ts", "TX_LAST_TS")]
        print(f"{'':15}" + "".join(f"{'P%d' % n:>21}" for n in range(4)))
        for key, label in rows:
            print(f"{label:15}" + "".join(f"{fmt_ns(p[key]):>21}" for p in doc["ports"]))
        print("(deltas/latencies in ns, raw: MAC cycle stamp vs SFD pin, no offsets; '-' = none yet)")
        if args.clear:
            print("SFD counters cleared")
    elif args.sfd_cmd == "config":
        ctrl = c.rd(SFD_CTRL) & 0x3
        if args.match is not None:
            ctrl = (ctrl & ~1) | (args.match == "on")
        if args.log is not None:
            ctrl = (ctrl & ~2) | ((args.log == "on") << 1)
        c.wr(SFD_CTRL, ctrl)
        if args.rx_win:
            c.wr(SFD_RX_WIN_MIN, args.rx_win[0]); c.wr(SFD_RX_WIN_MAX, args.rx_win[1])
        if args.tx_win:
            c.wr(SFD_TX_WIN_MIN, args.tx_win[0]); c.wr(SFD_TX_WIN_MAX, args.tx_win[1])
        if args.min_low is not None:
            c.wr(SFD_MIN_LOW, args.min_low)
        if args.min_high is not None:
            c.wr(SFD_MIN_HIGH, args.min_high)
        if args.mac_offset is not None:
            c.wr(0x0A8, args.mac_offset & 0xFFFFFFFF)
        for (port, ns) in args.rx_offset or []:
            c.wr(SFD_PORT_BASE + port * SFD_PORT_STRIDE + 0x38, ns)
        for (port, ns) in args.tx_offset or []:
            c.wr(SFD_PORT_BASE + port * SFD_PORT_STRIDE + 0xB8, ns)
        args.json, args.clear, args.sfd_cmd = False, False, "status"
        cmd_sfd(b, args)
    elif args.sfd_cmd == "log":
        base = SFD_PORT_BASE + args.port * SFD_PORT_STRIDE
        entries = []
        if args.dir == "rx":
            ovf = c.rd(base + SFD_RX_LOG_STATUS) >> 16
            while c.rd(base + SFD_RX_LOG_STATUS) & 0x1F:
                entries.append({"ts_ns": Board.rd64(c, base + SFD_RX_LOG_TS)})
        else:
            ovf = c.rd(base + SFD_TX_LOG_STATUS) >> 16
            while c.rd(base + SFD_TX_LOG_STATUS) & 0x1F:
                ts = Board.rd64(c, base + SFD_TX_LOG_TS)
                entries.append({"ts_ns": ts, "lat_ns": sfd_val(c.rd(base + SFD_TX_LOG_LAT), "s")})
        if args.json:
            print(json.dumps({"port": args.port, "dir": args.dir, "overflows": ovf,
                              "entries": entries}, indent=1))
        else:
            for e in entries:
                print(e["ts_ns"], fmt_ns(e.get("lat_ns")) if args.dir == "tx" else "")
            print(f"# {len(entries)} entries, {ovf} overflows"
                  + ("" if c.rd(SFD_CTRL) & 2 else " (logging is off: sfd config --log on)"))


# ---------------------------------------------------------------------------
# traffic generator / checker (m0 path, PKTREC_M0_GEN_* / _CHK_*)
# ---------------------------------------------------------------------------
def mac_int(s):
    b_ = [int(x, 16) for x in s.split(":")]
    if len(b_) != 6:
        raise SystemExit(f"pktrec-phy: bad MAC address {s}")
    v = 0
    for x in b_:
        v = (v << 8) | x
    return v


def mac_str(v):
    return ":".join(f"{(v >> (8 * i)) & 0xFF:02x}" for i in range(5, -1, -1))


def gen_doc(b, n):
    m, g = b.m0, GEN_BASE + n * GEN_STRIDE
    ctrl, st, cc = m.rd(g + G_CTRL), m.rd(g + G_STATUS), m.rd(g + C_CTRL)
    length = m.rd(g + G_LEN)
    return {"port": n, "path": MODE_NAMES[(m.rd(M0_PATH_CTRL) >> (2 * n)) & 3],
            "gen": {"enable": ctrl & 1, "format": "raw" if ctrl & 2 else "prsq",
                    "rand_len": (ctrl >> 2) & 1, "bad": (ctrl >> 3) & 1, "running": st & 1, "done": (st >> 1) & 1,
                    "len": length, "size_with_fcs": length + 4,
                    "len_mask": m.rd(g + G_LEN_MASK), "ifg": m.rd(g + G_IFG),
                    "count": m.rd(g + G_COUNT),
                    "dst": mac_str(m.rd(g + G_DST_LO) | (m.rd(g + G_DST_HI) << 32)),
                    "src": mac_str(m.rd(g + G_SRC_LO) | (m.rd(g + G_SRC_HI) << 32)),
                    "etype": m.rd(g + G_ETYPE), "stream": m.rd(g + G_STREAM),
                    "seq_first": m.rd(g + G_SEQ_FIRST),
                    "frames": Board.rd64(m, g + G_FRAMES), "bytes": Board.rd64(m, g + G_BYTES)},
            "chk": {"enable": cc & 1, "format": "raw" if cc & 2 else "prsq", "etype": cc >> 16,
                    "frames": m.rd(g + C_FRAMES), "lost": m.rd(g + C_LOST),
                    "errors": m.rd(g + C_ERRORS), "bad": m.rd(g + C_BAD),
                    "last_seq": Board.rd64(m, g + C_LAST_SEQ)}}


def print_gen(doc, what):
    if what in ("gen", "both"):
        gd = doc["gen"]
        print(f"P{doc['port']} gen: path={doc['path']} {'RUNNING' if gd['running'] else 'stopped'}"
              f"{' (done)' if gd['done'] else ''} format={gd['format']} size={gd['size_with_fcs']}"
              f"{' +rand&0x%x' % gd['len_mask'] if gd['rand_len'] else ''}"
              f"{' BAD' if gd['bad'] else ''} ifg={gd['ifg']} "
              f"count={gd['count'] or 'endless'} dst={gd['dst']} src={gd['src']} "
              f"{'etype=0x%04x' % gd['etype'] if gd['format'] == 'raw' else 'stream=%d' % gd['stream']} "
              f"seq_first={gd['seq_first']} | sent {gd['frames']} frames {gd['bytes']} bytes")
    if what in ("chk", "both"):
        cd = doc["chk"]
        print(f"P{doc['port']} chk: {'on' if cd['enable'] else 'off'} format={cd['format']} "
              f"frames={cd['frames']} lost={cd['lost']} errors={cd['errors']} bad={cd['bad']} "
              f"last_seq={cd['last_seq']}")


def cmd_gen(b, args):
    b.need_gen()
    m, n = b.m0, args.port
    g = GEN_BASE + n * GEN_STRIDE
    if args.gen_cmd == "start":
        size = args.size
        if b.phy_looped(n):                    # loop safety: --force does not override
            lan_gate([f"P{n}'s PHY is in MII loopback (BMCR[14]): the generated frames come "
                      f"back on P{n}'s RX" + (", and P{} forwards them out".format(n ^ 1)
                                              if b.path_of(n ^ 1) == "fwd" else "")],
                     f"gen {n} start", args.i_accept_lan_loop)
        if not 64 <= size <= 16387:
            raise SystemExit("pktrec-phy: --size must be 64..16387 (wire size incl. FCS)")
        length = size - 4
        # The MAC cuts frames above its TX_MAX_LEN (1518 B incl. FCS by default) and
        # sends them error-terminated: the far end counts them as RX_BAD, silently from
        # the generator's point of view (bench 2026-10-13: --rand-mask 0x5ff, up to
        # 1599 B, gave ~7.8 % bad frames). Refuse unless --force.
        tx_max = (b.eth_port(n, P_TX_MAX_LEN) & 0xFFFF) + 1
        if tx_max <= 64:
            tx_max = 1518                      # register not implemented: design default
        biggest = size + (args.rand_mask or 0)
        if biggest > tx_max:
            msg = (f"--size {size}" + (f" + --rand-mask 0x{args.rand_mask:x}" if args.rand_mask else "")
                   + f" gives frames up to {biggest} B, beyond P{n}'s TX_MAX_LEN {tx_max} B "
                   "(incl. FCS): the MAC sends those error-terminated, the receiver counts them "
                   "as bad frames")
            if not args.force:
                raise SystemExit(f"pktrec-phy: {msg}. Use a smaller size/mask, or --force")
            print(f"WARNING: {msg}")
        ifg = args.ifg
        if args.rate:
            ifg = max(12, round(1e9 / 8 / args.rate) - (size + 8))
        m.wr(g + G_CTRL, 0)                    # stop (a running frame completes)
        time.sleep(0.001)
        m.wr(g + G_LEN, length)
        m.wr(g + G_LEN_MASK, args.rand_mask or 0)
        m.wr(g + G_IFG, ifg)
        m.wr(g + G_COUNT, args.count)
        dst, src = mac_int(args.dst), mac_int(args.src or f"02:00:00:00:00:{n:02x}")
        m.wr(g + G_DST_LO, dst & 0xFFFFFFFF); m.wr(g + G_DST_HI, dst >> 32)
        m.wr(g + G_SRC_LO, src & 0xFFFFFFFF); m.wr(g + G_SRC_HI, src >> 32)
        m.wr(g + G_ETYPE, args.etype)
        m.wr(g + G_STREAM, n if args.stream is None else args.stream)
        m.wr(g + G_SEQ_FIRST, args.seq_first)
        if not args.no_select:
            mode = m.rd(M0_PATH_CTRL) & 0xFF
            b.write_path((mode & ~(3 << (2 * n))) | (3 << (2 * n)))
        time.sleep(0.001)                      # config settles in tx_clk before ENABLE
        if args.bad:
            b.need_tap()
        m.wr(g + G_CTRL, 1 | (2 if args.raw else 0) | (4 if args.rand_mask else 0) |
             (8 if args.bad else 0))
        print_gen(gen_doc(b, n), "gen")
    elif args.gen_cmd == "stop":
        m.wr(g + G_CTRL, m.rd(g + G_CTRL) & ~1)
        time.sleep(0.01)
        print_gen(gen_doc(b, n), "gen")
    else:
        doc = gen_doc(b, n)
        print(json.dumps(doc, indent=1)) if args.json else print_gen(doc, "both")


def cmd_chk(b, args):
    b.need_gen()
    m, n = b.m0, args.port
    g = GEN_BASE + n * GEN_STRIDE
    if args.chk_cmd == "start":
        m.wr(g + C_CTRL, 0)
        time.sleep(0.001)
        m.wr(g + C_CTRL, 1 | (2 if args.raw else 0) | (args.etype << 16))
    elif args.chk_cmd == "stop":
        m.wr(g + C_CTRL, m.rd(g + C_CTRL) & ~1)
    time.sleep(0.001)
    doc = gen_doc(b, n)
    if getattr(args, "json", False):
        print(json.dumps({"port": n, "chk": doc["chk"]}, indent=1))
    else:
        print_gen(doc, "chk")


LAN_HELP = ("override the loop-safety check (prints a warning); --force never does. Only "
            "with nothing but test equipment on the pair")


def main():
    ap = argparse.ArgumentParser(prog="pktrec-phy", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("Commands:", 1)[1])
    ap.add_argument("--devmem", action="store_true", help="use /dev/mem instead of UIO")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="configure the four DP83867s")
    p.add_argument("--1000-only", dest="only1000", action="store_true",
                   help="advertise 1000BASE-T full duplex only (TAP)")
    p.add_argument("--reset", action="store_true", help="pulse the PHY reset pins first")
    p.add_argument("--no-sfd", action="store_true", help="leave GPIO_0/1 at their defaults")
    p.add_argument("--wait", type=float, default=6.0,
                   help="seconds to watch for link-up after init (default 6, 0 = none)")
    p = sub.add_parser("status", help="link status of all ports")
    p.add_argument("--json", action="store_true", help="one JSON document (stable keys)")
    p = sub.add_parser("path", help="select the TX source of a port")
    p.add_argument("port", help="0..3 or all")
    p.add_argument("mode", choices=sorted(MODES) + ["replay"])
    p.add_argument("--i-accept-lan-loop", action="store_true", help=LAN_HELP)
    p = sub.add_parser("counters", help="M0 frame counters")
    p.add_argument("--clear", action="store_true")
    p.add_argument("--json", action="store_true")
    port_t = lambda s: int(s.lstrip("pP")) if 0 <= int(s.lstrip("pP")) <= 3 else \
        (_ for _ in ()).throw(argparse.ArgumentTypeError("port 0..3"))
    p = sub.add_parser("sfd", help="PHY SFD timestamping (M2)")
    ss = p.add_subparsers(dest="sfd_cmd", required=True)
    q = ss.add_parser("status", help="counters, deltas, latencies, latest timestamps")
    q.add_argument("--json", action="store_true")
    q.add_argument("--clear", action="store_true", help="clear the SFD counters after reading")
    q = ss.add_parser("config", help="windows, offsets, filter, match/log enables")
    q.add_argument("--rx-win", nargs=2, type=int, metavar=("MIN", "MAX"))
    q.add_argument("--tx-win", nargs=2, type=int, metavar=("MIN", "MAX"))
    q.add_argument("--rx-offset", nargs=2, type=int, action="append", metavar=("PORT", "NS"))
    q.add_argument("--tx-offset", nargs=2, type=int, action="append", metavar=("PORT", "NS"))
    q.add_argument("--match", choices=["on", "off"])
    q.add_argument("--log", choices=["on", "off"])
    q.add_argument("--min-low", type=int)
    q.add_argument("--min-high", type=int)
    q.add_argument("--mac-offset", type=int, metavar="NS",
                   help="MAC_OFFSET (0x0A8): signed ns added to MAC-fallback timestamps")
    q = ss.add_parser("log", help="pop a port's SFD log FIFO")
    q.add_argument("port", type=port_t)
    q.add_argument("--dir", choices=["rx", "tx"], default="tx")
    q.add_argument("--json", action="store_true")
    p = sub.add_parser("gen", help="per-port hardware traffic generator (M2)")
    p.add_argument("port", type=port_t)
    gs = p.add_subparsers(dest="gen_cmd", required=True)
