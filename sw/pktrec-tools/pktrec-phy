class Regs:
    """32-bit register window (UIO map or /dev/mem)."""

    def __init__(self, base, size, devmem=False):
        self.base = base
        if devmem:
            fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
            self.mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE,
                                offset=base)
            self.src = "/dev/mem"
        else:
            dev = find_uio(base)
            if dev is None:
                raise SystemExit(f"pktrec-phy: no UIO device maps 0x{base:x} "
                                 "(generic-uio binding missing? try --devmem)")
            fd = os.open(dev, os.O_RDWR | os.O_SYNC)
            self.mm = mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE,
                                offset=0)
            self.src = dev
        os.close(fd)
        # typed view: every access is a single aligned 32-bit load/store
        self.words = memoryview(self.mm).cast("I")

    def rd(self, off):
        return self.words[off >> 2]

    def wr(self, off, val):
        self.words[off >> 2] = val & 0xFFFFFFFF


def find_uio(base):
    root = "/sys/class/uio"
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return None
    for n in names:
        try:
            with open(f"{root}/{n}/maps/map0/addr") as f:
                if int(f.read().strip(), 16) == base:
                    return f"/dev/{n}"
        except (OSError, ValueError):
            continue
    return None


class Board:
    def __init__(self, devmem=False):
        self.eth = Regs(ETH_BASE, ETH_SIZE, devmem)
        self.m0 = Regs(M0_BASE, M0_SIZE, devmem)
        if self.eth.rd(ETH_ID) != ETH_ID_VALUE:
            raise SystemExit(f"pktrec-phy: eth_ports ID 0x{self.eth.rd(ETH_ID):08x}, "
                             f"expected 0x{ETH_ID_VALUE:08x} (wrong bitstream?)")
        if self.m0.rd(M0_ID) != M0_ID_VALUE:
            raise SystemExit(f"pktrec-phy: m0_path ID 0x{self.m0.rd(M0_ID):08x}, "
                             f"expected 0x{M0_ID_VALUE:08x}")
        self.devmem = devmem
        self._cap = None

    @property
    def cap(self):
        """Capture block (SFD registers), mapped on first use."""
        if self._cap is None:
            self._cap = Regs(CAP_BASE, CAP_SIZE, self.devmem)
            if self._cap.rd(0) != CAP_ID_VALUE:
                raise SystemExit(f"pktrec-phy: capture ID 0x{self._cap.rd(0):08x}, "
                                 f"expected 0x{CAP_ID_VALUE:08x}")
            if self._cap.rd(CAP_VERSION) < 0x00010002:
                raise SystemExit("pktrec-phy: capture register map "
                                 f"0x{self._cap.rd(CAP_VERSION):08x} has no SFD block (needs 1.2)")
        return self._cap

    def need_gen(self):
        if self.m0.rd(M0_VERSION) < 0x00010001:
            raise SystemExit("pktrec-phy: this bitstream has no traffic generator (m0 map 1.0)")

    def has_tap(self):
        """m0 map 1.2 (M3): PAIR_MODE, EFF_PATH, dynamic IFG."""
        return self.m0.rd(M0_VERSION) >= 0x00010002

    def need_tap(self):
        if not self.has_tap():
            raise SystemExit("pktrec-phy: this bitstream has no TAP-mode registers "
                             f"(m0 map 0x{self.m0.rd(M0_VERSION):08x}, needs 1.2)")

    def capture_running(self):
        """True while the capture block records (CTRL.ENABLE); None if unknown."""
        try:
            c = self._cap if self._cap is not None else Regs(CAP_BASE, CAP_SIZE, self.devmem)
        except (SystemExit, OSError):
            return None
        if c.rd(0) != CAP_ID_VALUE:
            return None
        return bool(c.rd(CAP_CTRL) & CAP_CTRL_ENABLE)

    def write_path(self, m):
        """PATH_CTRL = m, and PAIR_MODE derived from it (pair = tap iff both ports fwd)."""
        self.m0.wr(M0_PATH_CTRL, m & 0xFF)
        if self.has_tap():
            pm = 0
            for p in range(2):
                if all(((m >> (2 * n)) & 3) == MODES["fwd"] for n in (2 * p, 2 * p + 1)):
                    pm |= PAIR_MODES["tap"] << (2 * p)
            self.m0.wr(M0_PAIR_MODE, pm)

    def pair_modes(self):
        """Mode name of pair 0 and 1 (PAIR_MODE on 1.2, else derived from PATH_CTRL)."""
        if self.has_tap():
            pm = self.m0.rd(M0_PAIR_MODE)
            return [PAIR_MODE_NAMES[(pm >> (2 * p)) & 3] for p in range(2)]
        m = self.m0.rd(M0_PATH_CTRL)
        return ["tap" if all(((m >> (2 * n)) & 3) == MODES["fwd"] for n in (2 * p, 2 * p + 1))
                else "monitor" for p in range(2)]

    @staticmethod
    def rd64(regs, off):
        lo = regs.rd(off)                     # the LO read latches HI
        return lo | (regs.rd(off + 4) << 32)

    # ---- MDIO bus lock (flock, re-entrant within this process) ----
    MDIO_LOCK = "/run/lock/pktrec-mdio"
    _lock_fd = None
    _lock_depth = 0

    @contextlib.contextmanager
    def mdio_lock(self):
        if self._lock_depth == 0:
            try:
                os.makedirs(os.path.dirname(self.MDIO_LOCK), exist_ok=True)
                self._lock_fd = os.open(self.MDIO_LOCK, os.O_RDWR | os.O_CREAT, 0o666)
                fcntl.flock(self._lock_fd, fcntl.LOCK_EX)
            except OSError:
                self._lock_fd = None          # no lock directory: run unlocked
        self._lock_depth += 1
        try:
            yield
        finally:
            self._lock_depth -= 1
            if self._lock_depth == 0 and self._lock_fd is not None:
                fcntl.flock(self._lock_fd, fcntl.LOCK_UN)
                os.close(self._lock_fd)
                self._lock_fd = None

    # ---- MDIO (Taxi taxi_mdio_master behind the shell's MDIO_CMD/STATUS/RDATA) ----
    def _mdio_wait(self, want_rd, timeout=0.05):
        t0 = time.monotonic()
        while True:
            st = self.eth.rd(ETH_MDIO_STATUS)
            if st & 0x4:
                raise RuntimeError("MDIO command dropped (master busy)")
            if not (st & 0x1) and (not want_rd or (st & 0x2)):
                return
            if time.monotonic() - t0 > timeout:
                raise RuntimeError(f"MDIO timeout (status 0x{st:x})")

    def _mdio(self, op, phy, reg, data=0):
        # [31:30]=01 start, [29:28] op (01 write, 10 read), [27:23] phy, [22:18] reg, [15:0] data
        self._mdio_wait(False)
        self.eth.wr(ETH_MDIO_CMD, (1 << 30) | (op << 28) | ((phy & 0x1F) << 23) |
                    ((reg & 0x1F) << 18) | (data & 0xFFFF))
        self._mdio_wait(op == 2)
        return self.eth.rd(ETH_MDIO_RDATA) & 0xFFFF if op == 2 else None

    def mdio_rd(self, phy, reg):
        with self.mdio_lock():
            if reg <= 0x1F:
                return self._mdio(2, phy, reg)
            self._mdio(1, phy, REGCR, 0x001F)
            self._mdio(1, phy, ADDAR, reg)
            self._mdio(1, phy, REGCR, 0x401F)
            return self._mdio(2, phy, ADDAR)

    def mdio_wr(self, phy, reg, val):
        with self.mdio_lock():
            if reg <= 0x1F:
                self._mdio(1, phy, reg, val)
                return
            self._mdio(1, phy, REGCR, 0x001F)
            self._mdio(1, phy, ADDAR, reg)
            self._mdio(1, phy, REGCR, 0x401F)
            self._mdio(1, phy, ADDAR, val)

    def mdio_rmw(self, phy, reg, clr, setb):
        with self.mdio_lock():
            v = self.mdio_rd(phy, reg)
            n = (v & ~clr) | setb
            if n != v:
                self.mdio_wr(phy, reg, n)
            return v

    # ---- helpers ----
    def eth_port(self, n, off):
        return self.eth.rd(ETH_PORT_BASE + n * ETH_PORT_STRIDE + off)

    def copper_link(self, n):
        return bool(self.mdio_rd(PHY_ADDR[n], PHYSTS) & 0x0400)

    def phy_power(self, n, up):
        """BMCR[11] power-down off (up=True) / on. Registers are kept."""
        self.mdio_rmw(PHY_ADDR[n], BMCR, 0x0800 if up else 0, 0 if up else 0x0800)

    def phy_powered_down(self, n):
        return bool(self.mdio_rd(PHY_ADDR[n], BMCR) & 0x0800)

    def sgmii_retrigger(self, n):
        """Make the DP83867 send a fresh SGMII config word (CFG2[7] 0 -> 1)."""
        a = PHY_ADDR[n]
        v = self.mdio_rd(a, CFG2)
        self.mdio_wr(a, CFG2, v & ~0x0080)
        self.mdio_wr(a, CFG2, v | 0x0080)


def init_phy(b, n, only1000, sfd):
    a = PHY_ADDR[n]
    id1, id2 = b.mdio_rd(a, PHYIDR1), b.mdio_rd(a, PHYIDR2)
    if id1 != 0x2000 or (id2 & 0xFFF0) != 0xA230:
        print(f"P{n}: PHY @0x{a:02x} ID {id1:04x}:{id2:04x} is not a DP83867 - skipped")
        return False
    cfg4 = b.mdio_rd(a, CFG4)
    # mirror mode (OP080 layout; Rev-A boards are not strapped for it) and SGMII AN
    # timer 16 ms (CFG4[6:5] = 00, as the Linux dp83867 driver sets)
    b.mdio_wr(a, CFG4, (cfg4 & ~0x0060) | 0x0001)
    b.mdio_rmw(a, PHYCR, 0, 0x0800)            # SGMII_EN
    b.mdio_rmw(a, SGMIICTL1, 0x4000, 0)        # 4-wire SGMII (no 625 MHz clock)
    b.mdio_rmw(a, CFG2, 0, 0x0080)             # SGMII auto-negotiation enable
    if only1000:
        b.mdio_rmw(a, ANAR, 0x01E0, 0)         # no 10/100
        b.mdio_rmw(a, CFG1, 0x0100, 0x0200)    # 1000FD only
    else:
        b.mdio_rmw(a, ANAR, 0, 0x01E0)         # strap default: 10/100/1000 HD+FD
        b.mdio_rmw(a, CFG1, 0, 0x0300)
    if sfd:
        # GPIO_MUX_CTRL 0x0012: GPIO_0 = RX SFD, GPIO_1 = TX SFD. Verified on the
        # bench (2026-10-13): GPIO0 edges == RX_GOOD and GPIO1 edges == TX_GOOD on
        # all ports. (0x0120, from a reading of TI SNLA242, only put RX SFD on
        # GPIO_1 and left GPIO_0 at its default.)
        b.mdio_wr(a, RXFCFG, 0x1080)
        b.mdio_wr(a, GPIO_MUX_CTRL, 0x0012)
        b.mdio_wr(a, SYNC_FIFO_CTRL, 0xDF22)
    b.mdio_rmw(a, BMCR, 0x0C00, 0x1000)        # AN on, not powered down / isolated
    b.mdio_wr(a, CTRL, 0x4000)                 # SW_RESTART (registers kept)
    time.sleep(0.01)
    print(f"P{n}: PHY @0x{a:02x} configured (strap mirror={'on' if cfg4 & 1 else 'OFF (Rev-A)'}, "
          f"{'1000FD only' if only1000 else '10/100/1000'}, SFD {'on' if sfd else 'off'})")
    return True


def cmd_init(b, args):
    g = b.eth.rd(ETH_GCTRL)
    if args.reset:
        b.eth.wr(ETH_GCTRL, g & ~0x0F00)        # assert all PHY resets
        time.sleep(0.01)
    if args.reset or (g & 0x0F00) != 0x0F00:
        b.eth.wr(ETH_GCTRL, (g & ~0x0F00 & ~0x1) | 0x0F00)
        time.sleep(0.05)                       # >= 1 ms after reset release
    elif g & 1:
        b.eth.wr(ETH_GCTRL, g & ~0x1)          # release the transceivers
    ok = [init_phy(b, n, args.only1000, not args.no_sfd) for n in range(4)]
    if args.wait > 0:
        print(f"waiting up to {args.wait:.0f} s for copper links "
              "(re-triggering SGMII on each link-up)...")
        watch_loop(b, args.wait, 0.2, [n for n in range(4) if ok[n]], quiet=False)
    cmd_status(b, args)


def speed_str(code):
    return {0: "10M", 1: "100M", 2: "1G"}.get(code, "?")


def status_doc(b):
    """Link status as a dict (the JSON document of 'status --json')."""
    gs = b.eth.rd(ETH_GSTATUS)
    io = b.m0.rd(M0_IO_STATUS)
    mode = b.m0.rd(M0_PATH_CTRL)
    doc = {"gtpowergood": gs & 1, "qpll0_lock": (gs >> 1) & 1,
           "phy_reset_n": (b.eth.rd(ETH_GCTRL) >> 8) & 0xF,
           "pg_1v0": (io >> 8) & 1, "pg_2v5": (io >> 9) & 1, "ports": []}
    for n in range(4):
        a = PHY_ADDR[n]
        cu = {"up": None, "speed": None, "full_duplex": None, "error": None}
        try:
            bmsr = b.mdio_rd(a, BMSR)
            bmsr = b.mdio_rd(a, BMSR)          # link bit latches low: read twice
            st = b.mdio_rd(a, PHYSTS)
            cu["up"] = bool(bmsr & 0x4)
            if cu["up"]:
                cu["speed"] = speed_str((st >> 14) & 3)
                cu["full_duplex"] = bool(st & 0x2000)
        except RuntimeError as e:
            cu["error"] = str(e)
        s = b.eth_port(n, P_STATUS)
        doc["ports"].append({
            "port": n, "phy_addr": a, "copper": cu,
            "pcs": {"sync": s & 1, "an": "done" if s & 2 else ("run" if s & 4 else "idle"),
                    "an_timeout": bool(s & 8), "lp_link": (s >> 5) & 1,
                    "speed": speed_str((s >> 6) & 3), "full_duplex": bool(s & 0x100)},
            "lp_adv": b.eth_port(n, P_LP_ADV), "link_up": (s >> 11) & 1,
            "gpio0": (io >> n) & 1, "gpio1": (io >> (4 + n)) & 1,
            "path": MODE_NAMES[(mode >> (2 * n)) & 3]})
    doc["pairs"] = [{"pair": p, "ports": [2 * p, 2 * p + 1], "mode": m}
                    for p, m in enumerate(b.pair_modes())]
    return doc


