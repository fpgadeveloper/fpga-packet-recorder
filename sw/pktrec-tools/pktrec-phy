class EventLog:
    """Timestamped action log for 'watch' (text, or one JSON object per line)."""

    def __init__(self, as_json=False):
        self.as_json = as_json

    def __call__(self, port, event, msg, **kw):
        if self.as_json:
            print(json.dumps({"time": time.strftime("%Y-%m-%dT%H:%M:%S"), "port": port,
                              "event": event, "msg": msg} | kw), flush=True)
        else:
            print(f"{time.strftime('%H:%M:%S')} " + (f"P{port}: " if port is not None else "")
                  + msg, flush=True)


class Propagator:
    """Link-state propagation for pairs in TAP mode (watch).

    A port whose copper link has been down for `debounce` s makes us power down its
    partner PHY (BMCR[11]) so the device on the partner's side sees link down, as on
    a direct cable; when the port's link has been up again for `debounce` s, the
    partner is powered up (and SGMII re-triggered). Guards against ping-pong:
      - a port WE powered down never propagates (its link-down is our doing);
      - a port we just powered up gets `grace` s (copper auto-negotiation takes
        ~3 s) before its own link-down counts;
      - at start every port gets `grace` s too.
    If someone else powers a PHY back up (pktrec-phy init, mdio), we notice and
    forget it. When a pair leaves TAP mode, or watch exits, every PHY powered down
    here is powered up again."""

    def __init__(self, b, log, debounce=0.5, grace=6.0):
        self.b, self.log, self.debounce, self.grace = b, log, debounce, grace
        now = time.monotonic()
        self.pd = [False] * 4               # powered down by us
        self.state = [None] * 4             # last copper link state
        self.t_change = [now] * 4
        self.grace_until = [now + grace] * 4
        # a PHY left powered down by a previous watch (crash/restart) in a TAP pair
        tap = self.b.pair_modes()
        for n in range(4):
            if tap[n // 2] == "tap" and self.b.phy_powered_down(n):
                self.b.phy_power(n, True)
                self.log(n, "power_up", "PHY was powered down at start (previous watch?) "
                         "-> powered up", reason="startup")

    def power(self, n, up, now, reason):
        self.b.phy_power(n, up)
        self.pd[n] = not up
        if up:
            self.grace_until[n] = now + self.grace
            self.b.sgmii_retrigger(n)
        self.log(n, "power_up" if up else "power_down",
                 f"PHY powered {'UP (+SGMII re-trigger)' if up else 'DOWN'} ({reason})",
                 reason=reason)

    def release_all(self, reason):
        now = time.monotonic()
        for n in range(4):
            if self.pd[n]:
                self.power(n, True, now, reason)

    def step(self, now, links):
        for n in range(4):
            if links.get(n) is None:
                continue
            if links[n] != self.state[n]:
                self.state[n] = links[n]
                self.t_change[n] = now
        tap = self.b.pair_modes()
        for pair in range(2):
            a, c = 2 * pair, 2 * pair + 1
            if tap[pair] != "tap":
                for x in (a, c):
                    if self.pd[x]:
                        self.power(x, True, now, f"pair {pair} left TAP mode")
                continue
            for x in (a, c):                    # externally powered up again?
                if self.pd[x] and not self.b.phy_powered_down(x):
                    self.pd[x] = False
                    self.grace_until[x] = now + self.grace
                    self.log(x, "external_power_up", "PHY was powered up by someone else; "
                             "no longer held down")
            for x, y in ((a, c), (c, a)):
                if self.state[x] is None or now - self.t_change[x] < self.debounce:
                    continue
                if self.state[x] is False and not self.pd[x] and not self.pd[y] \
                        and now >= self.grace_until[x]:
                    self.power(y, False, now, f"P{x} link down")
                elif self.state[x] is True and self.pd[y]:
                    self.power(y, True, now, f"P{x} link up")


def watch_loop(b, duration, interval, ports, quiet, prop=None, log=None):
    """Poll the copper link of each PHY; on every change re-trigger the SGMII config
    word. Also re-trigger when copper is up but the PCS has no SGMII link (missed
    word), at most once per second per port. With a Propagator, propagate link
    state across TAP pairs (see Propagator)."""
    log = log or EventLog()
    last = {n: None for n in ports}
    last_fix = {n: 0.0 for n in ports}
    t_end = None if duration is None else time.monotonic() + duration
    while t_end is None or time.monotonic() < t_end:
        now = time.monotonic()
        links = {}
        for n in ports:
            try:
                up = b.copper_link(n)
            except RuntimeError as e:
                log(n, "mdio_error", str(e))
                continue
            links[n] = up
            s = b.eth_port(n, P_STATUS)
            stale = up and not (s & 0x20) and now - last_fix[n] > 1.0
            if up != last[n] or stale:
                b.sgmii_retrigger(n)
                last_fix[n] = now
                if last[n] is not None or up or not quiet:
                    why = "stale SGMII status" if (up == last[n]) else f"copper link {'up' if up else 'down'}"
                    log(n, "sgmii_retrigger", f"{why} -> SGMII re-triggered",
                        link=up, stale=bool(stale and up == last[n]))
                last[n] = up
        if prop is not None:
            try:
                prop.step(now, links)
            except RuntimeError as e:
                log(None, "mdio_error", f"propagation: {e}")
        if t_end is not None and all(last[n] for n in ports) and \
                all(b.eth_port(n, P_STATUS) & 0x800 for n in ports):
            return
        time.sleep(interval)


def cmd_watch(b, args):
    import signal
    log = EventLog(args.json)
    prop = None
    if not args.no_propagate:
        prop = Propagator(b, log, args.debounce, args.grace)
    log(None, "start", f"watch: SGMII re-trigger on link changes, link-state propagation "
        f"{'OFF' if prop is None else f'ON (debounce {args.debounce} s, grace {args.grace} s)'}"
        f"; pair modes {', '.join(b.pair_modes())}")
    # systemd stops the service with SIGTERM: leave no PHY powered down
    signal.signal(signal.SIGTERM, lambda *a: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        watch_loop(b, None, args.interval, list(range(4)), quiet=True, prop=prop, log=log)
    except KeyboardInterrupt:
        pass
    finally:
        if prop is not None:
            prop.release_all("watch exiting")
        log(None, "stop", "watch stopped")


# ---------------------------------------------------------------------------
# TAP mode (m0 map 1.2): per-pair mode, dynamic IFG
# ---------------------------------------------------------------------------
def mode_doc(b):
    m = b.m0.rd(M0_PATH_CTRL)
    eff = b.m0.rd(M0_EFF_PATH) if b.has_tap() else None
    pairs = []
    for p, mode in enumerate(b.pair_modes()):
        ports = [2 * p, 2 * p + 1]
        path = [MODE_NAMES[(m >> (2 * n)) & 3] for n in ports]
        want = {"tap": "fwd", "monitor": "idle"}.get(mode)
        pairs.append({"pair": p, "ports": ports, "mode": mode, "path": path,
                      "eff_path": None if eff is None else [MODE_NAMES[(eff >> (2 * n)) & 3]
                                                           for n in ports],
                      "consistent": all(x == want for x in path)})
    return {"pair_mode_reg": b.m0.rd(M0_PAIR_MODE) if b.has_tap() else None,
            "path_ctrl": m, "capture_running": b.capture_running(), "pairs": pairs}


def print_mode(doc):
    for q in doc["pairs"]:
        note = "" if q["consistent"] else "  (ports not both " + \
            ("fwd" if q["mode"] == "tap" else "idle") + ": loop/gen/mixed)"
        eff = "" if q["eff_path"] is None or q["eff_path"] == q["path"] else \
            f"  effective now {'/'.join(q['eff_path'])}"
        print(f"pair {q['pair']} (P{q['ports'][0]}/P{q['ports'][1]}): {q['mode']:<8} "
              f"path {'/'.join(q['path'])}{eff}{note}")


def cmd_mode(b, args):
    if args.what == "status":
        doc = mode_doc(b)
        print(json.dumps(doc, indent=1)) if args.json else print_mode(doc)
        return
    try:
        pair = int(args.what)
        assert pair in (0, 1)
    except (ValueError, AssertionError):
        raise SystemExit("pktrec-phy: mode <pair 0|1> tap|monitor  or  mode status")
    if args.mode not in PAIR_MODES:
        raise SystemExit("pktrec-phy: mode <pair 0|1> tap|monitor")
    run = b.capture_running()
    if run and not args.force:
        raise SystemExit("pktrec-phy: a capture is running (capture CTRL.ENABLE = 1); stop it "
                         "first or use --force (frames in flight at the switch are flushed "
                         "and counted in FLUSH)")
    if run is None:
        print("note: capture state unknown (capture block not mapped)")
    if not b.has_tap():
        print("note: no PAIR_MODE register in this bitstream (m0 map < 1.2): only PATH_CTRL is set")
    path = MODES["fwd" if args.mode == "tap" else "idle"]
    m = b.m0.rd(M0_PATH_CTRL) & 0xFF
    for n in (2 * pair, 2 * pair + 1):
        m = (m & ~(3 << (2 * n))) | (path << (2 * n))
    b.write_path(m)
    if b.has_tap():                            # TX side switches at the next frame boundary
        t0 = time.monotonic()
        while time.monotonic() - t0 < 0.2 and \
                (b.m0.rd(M0_EFF_PATH) >> (4 * pair)) & 0xF != (m >> (4 * pair)) & 0xF:
            time.sleep(0.005)
    if args.mode == "tap":
        # both sides must negotiate the same speed: the FIFO cannot bridge 1G <-> 100M
        sp = []
        for n in (2 * pair, 2 * pair + 1):
            s = b.eth_port(n, P_STATUS)
            sp.append(speed_str((s >> 6) & 3) if s & 0x800 else None)
        if sp[0] and sp[1] and sp[0] != sp[1]:
            print(f"WARNING: P{2 * pair} links at {sp[0]}, P{2 * pair + 1} at {sp[1]}: a TAP needs "
                  "the same speed on both sides (pktrec-phy init --1000-only)")
    print_mode(mode_doc(b))


def ifg_doc(b, n):
    m = b.m0
    base = M0_PORT_BASE + n * M0_PORT_STRIDE
    ctrl, thr, fill, st = (m.rd(base + P_IFG_CTRL), m.rd(base + P_IFG_THRESH),
                           m.rd(base + P_FWD_FILL), m.rd(base + P_IFG_STATUS))
    cyc = Board.rd64(m, base + P_IFG_RED_CYC)
    return {"port": n, "dyn_en": ctrl & 1, "ifg_nom": (ctrl >> 8) & 0xFF,
            "ifg_min": (ctrl >> 16) & 0xFF, "ifg_hi": thr & 0xFFFF, "ifg_lo": thr >> 16,
            "fwd_fill": fill & 0xFFFF, "fwd_fill_max": fill >> 16,
            "reduced": st & 1, "ifg_now": (st >> 8) & 0xFF,
            "reduced_cycles": cyc, "reduced_s": cyc * 16e-9,
            "reduced_entries": m.rd(base + P_IFG_RED_ENT), "flush": m.rd(base + P_FLUSH),
            "drop_fwd": m.rd(base + 0x14)}


def cmd_ifg(b, args):
    b.need_tap()
    ports = range(4) if args.port == "all" else [int(args.port.lstrip("pP"))]
    for n in ports:
        if not 0 <= n <= 3:
            raise SystemExit("port must be 0..3 or all")
        base = M0_PORT_BASE + n * M0_PORT_STRIDE
        ctrl, thr = b.m0.rd(base + P_IFG_CTRL), b.m0.rd(base + P_IFG_THRESH)
        if args.enable is not None:
            ctrl = (ctrl & ~1) | (args.enable == "on")
        for val, sh, what in ((args.nom, 8, "--nom"), (args.min, 16, "--min")):
            if val is not None:
                if not 2 <= val <= 255:
                    raise SystemExit(f"pktrec-phy: {what} must be 2..255 bytes")
                ctrl = (ctrl & ~(0xFF << sh)) | (val << sh)
        if args.hi is not None:
            thr = (thr & 0xFFFF0000) | (args.hi & 0xFFFF)
        if args.lo is not None:
            thr = (thr & 0xFFFF) | ((args.lo & 0xFFFF) << 16)
        if (thr >> 16) >= (thr & 0xFFFF):
            raise SystemExit("pktrec-phy: IFG_LO must be below IFG_HI")
        b.m0.wr(base + P_IFG_CTRL, ctrl)
        b.m0.wr(base + P_IFG_THRESH, thr)
    docs = [ifg_doc(b, n) for n in ports]
    if args.json:
        print(json.dumps({"ports": docs}, indent=1))
        return
    for d in docs:
        print(f"P{d['port']} TX: dynamic IFG {'on' if d['dyn_en'] else 'OFF'} "
              f"({d['ifg_nom']} B -> {d['ifg_min']} B above {d['ifg_hi']} B until below "
              f"{d['ifg_lo']} B FWD fill) | now {'REDUCED' if d['reduced'] else 'normal'} "
              f"gap {d['ifg_now']} B, FWD fill {d['fwd_fill']} B (max {d['fwd_fill_max']} of "
              f"16384) | reduced {d['reduced_s']:.6f} s in {d['reduced_entries']} episodes | "
              f"DROP_FWD {d['drop_fwd']} FLUSH {d['flush']}")


# ---------------------------------------------------------------------------
# TAP forwarding latency (SFD log FIFOs of the capture block)
# ---------------------------------------------------------------------------
def cmd_latency(b, args):
    c = b.cap
    if args.pair is not None:
        dirs = [(2 * args.pair + 1, 2 * args.pair), (2 * args.pair, 2 * args.pair + 1)]
    elif args.inp is not None and args.out is not None:
        dirs = [(args.inp, args.out)]
    else:
        raise SystemExit("pktrec-phy: latency needs --pair P or --in A --out B")
    ctrl0 = c.rd(SFD_CTRL) & 0x3
    c.wr(SFD_CTRL, ctrl0 | 0x2)                 # LOG_EN

    def pop(port, d):
        base = SFD_PORT_BASE + port * SFD_PORT_STRIDE
        st, ts = (SFD_RX_LOG_STATUS, SFD_RX_LOG_TS) if d == "rx" else (SFD_TX_LOG_STATUS, SFD_TX_LOG_TS)
        out = []
        while c.rd(base + st) & 0x1F:
            out.append(Board.rd64(c, base + ts))
        return out

    ins = sorted({i for i, _ in dirs})
    outs = sorted({o for _, o in dirs})
    for p in ins:
        pop(p, "rx")
    for p in outs:
        pop(p, "tx")
    ovf0 = {p: c.rd(SFD_PORT_BASE + p * SFD_PORT_STRIDE + SFD_RX_LOG_STATUS) >> 16 for p in ins}
    pend = {d: [] for d in dirs}
    lat = {d: [] for d in dirs}
    unmatched = {d: 0 for d in dirs}
    t_end = time.monotonic() + args.timeout
    try:
        while time.monotonic() < t_end and any(len(lat[d]) < args.count for d in dirs):
            rx = {p: pop(p, "rx") for p in ins}
            tx = {p: pop(p, "tx") for p in outs}
            for d in dirs:
                i, o = d
                pend[d].extend(rx[i])
                for t in tx[o]:
                    # the earliest pending RX frame that left on `o` within the window
                    while pend[d] and t - pend[d][0] > args.window:
                        pend[d].pop(0)
                        unmatched[d] += 1
                    if pend[d] and 0 < t - pend[d][0] <= args.window:
                        lat[d].append(t - pend[d].pop(0))
            time.sleep(0.005)
    except KeyboardInterrupt:
        pass
    finally:
        c.wr(SFD_CTRL, ctrl0)                   # LOG_EN back as it was
    res = []
    for (i, o) in dirs:
        v = sorted(lat[(i, o)])
        r = {"in": i, "out": o, "samples": len(v), "unmatched_rx": unmatched[(i, o)],
             "rx_offset_ns": s32(c.rd(SFD_PORT_BASE + i * SFD_PORT_STRIDE + 0x38)),
             "tx_offset_ns": s32(c.rd(SFD_PORT_BASE + o * SFD_PORT_STRIDE + 0xB8)),
             "rx_log_overflows": (c.rd(SFD_PORT_BASE + i * SFD_PORT_STRIDE + SFD_RX_LOG_STATUS) >> 16)
             - ovf0[i]}
        if v:
            med = v[len(v) // 2]
            inl = [x for x in v if abs(x - med) <= args.cluster]
            r.update(min_ns=v[0], median_ns=med, max_ns=v[-1], cluster_ns=args.cluster,
                     cluster_samples=len(inl), cluster_min_ns=inl[0], cluster_max_ns=inl[-1])
        res.append(r)
    if args.json:
        print(json.dumps({"label": args.label, "window_ns": args.window, "directions": res},
                         indent=1))
        return
    for r in res:
        if not r["samples"]:
            print(f"P{r['in']} -> P{r['out']}: no samples (traffic? 'pktrec-phy mode' tap? "
                  "SFD enabled by init?)")
            continue
        print(f"P{r['in']} -> P{r['out']}{' ' + args.label if args.label else ''}: "
              f"{r['samples']} frames, latency min {r['min_ns']} / median {r['median_ns']} / "
              f"max {r['max_ns']} ns; main cluster (median +-{r['cluster_ns']} ns): "
              f"{r['cluster_samples']} frames {r['cluster_min_ns']}..{r['cluster_max_ns']} ns "
              f"(TX SFD - RX SFD incl. RX_OFFSET {r['rx_offset_ns']} / TX_OFFSET "
              f"{r['tx_offset_ns']} ns; {r['unmatched_rx']} RX without TX in the window)")


def parse_int(s):
    return int(s, 0)


def cmd_mdio(b, args):
    p = args.phy.lower()
    phy = PHY_ADDR[int(p[1:])] if p.startswith("p") else parse_int(p)
    reg = parse_int(args.reg)
    if args.val is None:
        print(f"0x{b.mdio_rd(phy, reg):04x}")
    else:
        b.mdio_wr(phy, reg, parse_int(args.val))


# ---------------------------------------------------------------------------
# SFD timestamping (capture block, PKTREC_SFD_*)
# ---------------------------------------------------------------------------
def s32(v):
    return v - (1 << 32) if v & 0x80000000 else v


def sfd_val(v, kind):
    if kind == "s":
        return None if v == SFD_NONE else s32(v)
    return v


def sfd_doc(b):
    c = b.cap
    st = c.rd(SFD_STATUS)
    ctrl = c.rd(SFD_CTRL)
    doc = {"match_en": ctrl & 1, "log_en": (ctrl >> 1) & 1, "sampler_locked": st & 1,
           "sampler": "iserdes" if st & 2 else "iddr", "resolution_ps": c.rd(SFD_RES_PS),
           "pipe_ns": c.rd(SFD_PIPE_NS),
           "rx_window_ns": [s32(c.rd(SFD_RX_WIN_MIN)), s32(c.rd(SFD_RX_WIN_MAX))],
           "tx_window_ns": [s32(c.rd(SFD_TX_WIN_MIN)), s32(c.rd(SFD_TX_WIN_MAX))],
           "min_low_cycles": c.rd(SFD_MIN_LOW), "min_high_cycles": c.rd(SFD_MIN_HIGH),
           "mac_offset_ns": s32(c.rd(0x0A8)), "tb_now_ns": Board.rd64(c, 0x090), "ports": []}
    for n in range(4):
        base = SFD_PORT_BASE + n * SFD_PORT_STRIDE
        p = {"port": n, "rx_level": (st >> (8 + n)) & 1, "tx_level": (st >> (12 + n)) & 1}
        for name, off, kind in SFD_PORT_REGS:
            p[name] = Board.rd64(c, base + off) if kind == 64 else sfd_val(c.rd(base + off), kind)
        p["rx_log_entries"] = c.rd(base + SFD_RX_LOG_STATUS) & 0x1F
        p["tx_log_entries"] = c.rd(base + SFD_TX_LOG_STATUS) & 0x1F
        # in-order pairing check: TX SFD edges vs MAC TX completions
        p["tx_edges_minus_cpl"] = p["tx_edges"] - p["tx_cpl"]
        doc["ports"].append(p)
    return doc


def fmt_ns(v):
    return "-" if v is None else str(v)


def cmd_sfd(b, args):
    c = b.cap
    if args.sfd_cmd == "status":
        doc = sfd_doc(b)
        if args.clear:
            c.wr(SFD_CTRL, (c.rd(SFD_CTRL) & 0x3) | 0x100)
        if args.json:
            print(json.dumps(doc, indent=1))
            return
        print(f"SFD sampler: {doc['sampler']} locked={doc['sampler_locked']} "
              f"resolution {doc['resolution_ps']} ps, pipe {doc['pipe_ns']} ns; "
              f"match={'on' if doc['match_en'] else 'OFF'} log={'on' if doc['log_en'] else 'off'}; "
              f"RX window {doc['rx_window_ns']} ns, TX window {doc['tx_window_ns']} ns; "
              f"filter low>={doc['min_low_cycles']} high>={doc['min_high_cycles']} cycles; "
              f"MAC_OFFSET {doc['mac_offset_ns']} ns")
        rows = [("rx_edges", "RX_EDGES"), ("rx_matched", "RX_MATCHED"), ("rx_mismatch", "RX_MISMATCH"),
                ("rx_stale", "RX_STALE"), ("rx_glitch", "RX_GLITCH"), ("rx_fifo_ovf", "RX_FIFO_OVF"),
                ("rx_delta_last", "RX_DELTA_LAST"), ("rx_delta_min", "RX_DELTA_MIN"),
                ("rx_delta_max", "RX_DELTA_MAX"), ("rx_head_delta", "RX_HEAD_DELTA"),
                ("rx_offset", "RX_OFFSET"), ("rx_last_ts", "RX_LAST_TS"),
                ("tx_edges", "TX_EDGES"), ("tx_cpl", "TX_CPL"), ("tx_edges_minus_cpl", "TX_EDGES-CPL"),
                ("tx_paired", "TX_PAIRED"), ("tx_unpaired", "TX_UNPAIRED"),
                ("tx_cpl_stale", "TX_CPL_STALE"), ("tx_glitch", "TX_GLITCH"),
                ("tx_cpl_ovf", "TX_CPL_OVF"), ("tx_lat_last", "TX_LAT_LAST"),
                ("tx_lat_min", "TX_LAT_MIN"), ("tx_lat_max", "TX_LAT_MAX"),
                ("tx_head_lat", "TX_HEAD_LAT"), ("tx_offset", "TX_OFFSET"), ("tx_last_ts", "TX_LAST_TS")]
        print(f"{'':15}" + "".join(f"{'P%d' % n:>21}" for n in range(4)))
        for key, label in rows:
            print(f"{label:15}" + "".join(f"{fmt_ns(p[key]):>21}" for p in doc["ports"]))
        print("(deltas/latencies in ns, raw: MAC cycle stamp vs SFD pin, no offsets; '-' = none yet)")
        if args.clear:
            print("SFD counters cleared")
    elif args.sfd_cmd == "config":
        ctrl = c.rd(SFD_CTRL) & 0x3
        if args.match is not None:
            ctrl = (ctrl & ~1) | (args.match == "on")
        if args.log is not None:
            ctrl = (ctrl & ~2) | ((args.log == "on") << 1)
        c.wr(SFD_CTRL, ctrl)
        if args.rx_win:
            c.wr(SFD_RX_WIN_MIN, args.rx_win[0]); c.wr(SFD_RX_WIN_MAX, args.rx_win[1])
        if args.tx_win:
            c.wr(SFD_TX_WIN_MIN, args.tx_win[0]); c.wr(SFD_TX_WIN_MAX, args.tx_win[1])
        if args.min_low is not None:
            c.wr(SFD_MIN_LOW, args.min_low)
        if args.min_high is not None:
            c.wr(SFD_MIN_HIGH, args.min_high)
        for (port, ns) in args.rx_offset or []:
            c.wr(SFD_PORT_BASE + port * SFD_PORT_STRIDE + 0x38, ns)
        for (port, ns) in args.tx_offset or []:
            c.wr(SFD_PORT_BASE + port * SFD_PORT_STRIDE + 0xB8, ns)
        args.json, args.clear, args.sfd_cmd = False, False, "status"
        cmd_sfd(b, args)
    elif args.sfd_cmd == "log":
        base = SFD_PORT_BASE + args.port * SFD_PORT_STRIDE
        entries = []
        if args.dir == "rx":
            ovf = c.rd(base + SFD_RX_LOG_STATUS) >> 16
            while c.rd(base + SFD_RX_LOG_STATUS) & 0x1F:
                entries.append({"ts_ns": Board.rd64(c, base + SFD_RX_LOG_TS)})
        else:
            ovf = c.rd(base + SFD_TX_LOG_STATUS) >> 16
            while c.rd(base + SFD_TX_LOG_STATUS) & 0x1F:
                ts = Board.rd64(c, base + SFD_TX_LOG_TS)
                entries.append({"ts_ns": ts, "lat_ns": sfd_val(c.rd(base + SFD_TX_LOG_LAT), "s")})
        if args.json:
            print(json.dumps({"port": args.port, "dir": args.dir, "overflows": ovf,
                              "entries": entries}, indent=1))
        else:
            for e in entries:
                print(e["ts_ns"], fmt_ns(e.get("lat_ns")) if args.dir == "tx" else "")
            print(f"# {len(entries)} entries, {ovf} overflows"
                  + ("" if c.rd(SFD_CTRL) & 2 else " (logging is off: sfd config --log on)"))


# ---------------------------------------------------------------------------
# traffic generator / checker (m0 path, PKTREC_M0_GEN_* / _CHK_*)
# ---------------------------------------------------------------------------
def mac_int(s):
    b_ = [int(x, 16) for x in s.split(":")]
    if len(b_) != 6:
        raise SystemExit(f"pktrec-phy: bad MAC address {s}")
    v = 0
    for x in b_:
        v = (v << 8) | x
    return v


def mac_str(v):
    return ":".join(f"{(v >> (8 * i)) & 0xFF:02x}" for i in range(5, -1, -1))


def gen_doc(b, n):
    m, g = b.m0, GEN_BASE + n * GEN_STRIDE
    ctrl, st, cc = m.rd(g + G_CTRL), m.rd(g + G_STATUS), m.rd(g + C_CTRL)
    length = m.rd(g + G_LEN)
    return {"port": n, "path": MODE_NAMES[(m.rd(M0_PATH_CTRL) >> (2 * n)) & 3],
            "gen": {"enable": ctrl & 1, "format": "raw" if ctrl & 2 else "prsq",
                    "rand_len": (ctrl >> 2) & 1, "bad": (ctrl >> 3) & 1, "running": st & 1, "done": (st >> 1) & 1,
                    "len": length, "size_with_fcs": length + 4,
                    "len_mask": m.rd(g + G_LEN_MASK), "ifg": m.rd(g + G_IFG),
                    "count": m.rd(g + G_COUNT),
                    "dst": mac_str(m.rd(g + G_DST_LO) | (m.rd(g + G_DST_HI) << 32)),
                    "src": mac_str(m.rd(g + G_SRC_LO) | (m.rd(g + G_SRC_HI) << 32)),
                    "etype": m.rd(g + G_ETYPE), "stream": m.rd(g + G_STREAM),
                    "seq_first": m.rd(g + G_SEQ_FIRST),
                    "frames": Board.rd64(m, g + G_FRAMES), "bytes": Board.rd64(m, g + G_BYTES)},
            "chk": {"enable": cc & 1, "format": "raw" if cc & 2 else "prsq", "etype": cc >> 16,
                    "frames": m.rd(g + C_FRAMES), "lost": m.rd(g + C_LOST),
                    "errors": m.rd(g + C_ERRORS), "bad": m.rd(g + C_BAD),
                    "last_seq": Board.rd64(m, g + C_LAST_SEQ)}}


def print_gen(doc, what):
    if what in ("gen", "both"):
        gd = doc["gen"]
        print(f"P{doc['port']} gen: path={doc['path']} {'RUNNING' if gd['running'] else 'stopped'}"
              f"{' (done)' if gd['done'] else ''} format={gd['format']} size={gd['size_with_fcs']}"
              f"{' +rand&0x%x' % gd['len_mask'] if gd['rand_len'] else ''}"
              f"{' BAD' if gd['bad'] else ''} ifg={gd['ifg']} "
              f"count={gd['count'] or 'endless'} dst={gd['dst']} src={gd['src']} "
              f"{'etype=0x%04x' % gd['etype'] if gd['format'] == 'raw' else 'stream=%d' % gd['stream']} "
              f"seq_first={gd['seq_first']} | sent {gd['frames']} frames {gd['bytes']} bytes")
    if what in ("chk", "both"):
        cd = doc["chk"]
        print(f"P{doc['port']} chk: {'on' if cd['enable'] else 'off'} format={cd['format']} "
              f"frames={cd['frames']} lost={cd['lost']} errors={cd['errors']} bad={cd['bad']} "
              f"last_seq={cd['last_seq']}")


def cmd_gen(b, args):
    b.need_gen()
    m, n = b.m0, args.port
    g = GEN_BASE + n * GEN_STRIDE
    if args.gen_cmd == "start":
        size = args.size
        if not 64 <= size <= 16387:
            raise SystemExit("pktrec-phy: --size must be 64..16387 (wire size incl. FCS)")
        length = size - 4
        ifg = args.ifg
        if args.rate:
            ifg = max(12, round(1e9 / 8 / args.rate) - (size + 8))
        m.wr(g + G_CTRL, 0)                    # stop (a running frame completes)
        time.sleep(0.001)
        m.wr(g + G_LEN, length)
        m.wr(g + G_LEN_MASK, args.rand_mask or 0)
        m.wr(g + G_IFG, ifg)
        m.wr(g + G_COUNT, args.count)
        dst, src = mac_int(args.dst), mac_int(args.src or f"02:00:00:00:00:{n:02x}")
        m.wr(g + G_DST_LO, dst & 0xFFFFFFFF); m.wr(g + G_DST_HI, dst >> 32)
        m.wr(g + G_SRC_LO, src & 0xFFFFFFFF); m.wr(g + G_SRC_HI, src >> 32)
        m.wr(g + G_ETYPE, args.etype)
        m.wr(g + G_STREAM, n if args.stream is None else args.stream)
        m.wr(g + G_SEQ_FIRST, args.seq_first)
        if not args.no_select:
            mode = m.rd(M0_PATH_CTRL) & 0xFF
            b.write_path((mode & ~(3 << (2 * n))) | (3 << (2 * n)))
        time.sleep(0.001)                      # config settles in tx_clk before ENABLE
        if args.bad:
            b.need_tap()
        m.wr(g + G_CTRL, 1 | (2 if args.raw else 0) | (4 if args.rand_mask else 0) |
             (8 if args.bad else 0))
        print_gen(gen_doc(b, n), "gen")
    elif args.gen_cmd == "stop":
        m.wr(g + G_CTRL, m.rd(g + G_CTRL) & ~1)
        time.sleep(0.01)
        print_gen(gen_doc(b, n), "gen")
    else:
        doc = gen_doc(b, n)
        print(json.dumps(doc, indent=1)) if args.json else print_gen(doc, "both")


def cmd_chk(b, args):
    b.need_gen()
    m, n = b.m0, args.port
    g = GEN_BASE + n * GEN_STRIDE
    if args.chk_cmd == "start":
        m.wr(g + C_CTRL, 0)
        time.sleep(0.001)
        m.wr(g + C_CTRL, 1 | (2 if args.raw else 0) | (args.etype << 16))
    elif args.chk_cmd == "stop":
        m.wr(g + C_CTRL, m.rd(g + C_CTRL) & ~1)
    time.sleep(0.001)
    doc = gen_doc(b, n)
    if getattr(args, "json", False):
        print(json.dumps({"port": n, "chk": doc["chk"]}, indent=1))
    else:
        print_gen(doc, "chk")


def main():
    ap = argparse.ArgumentParser(prog="pktrec-phy", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("Commands:", 1)[1])
    ap.add_argument("--devmem", action="store_true", help="use /dev/mem instead of UIO")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="configure the four DP83867s")
    p.add_argument("--1000-only", dest="only1000", action="store_true",
                   help="advertise 1000BASE-T full duplex only (TAP)")
    p.add_argument("--reset", action="store_true", help="pulse the PHY reset pins first")
    p.add_argument("--no-sfd", action="store_true", help="leave GPIO_0/1 at their defaults")
    p.add_argument("--wait", type=float, default=6.0,
                   help="seconds to watch for link-up after init (default 6, 0 = none)")
    p = sub.add_parser("status", help="link status of all ports")
    p.add_argument("--json", action="store_true", help="one JSON document (stable keys)")
    p = sub.add_parser("path", help="select the TX source of a port")
    p.add_argument("port", help="0..3 or all")
    p.add_argument("mode", choices=sorted(MODES))
    p = sub.add_parser("counters", help="M0 frame counters")
    p.add_argument("--clear", action="store_true")
    p.add_argument("--json", action="store_true")
    port_t = lambda s: int(s.lstrip("pP")) if 0 <= int(s.lstrip("pP")) <= 3 else \
        (_ for _ in ()).throw(argparse.ArgumentTypeError("port 0..3"))
    p = sub.add_parser("sfd", help="PHY SFD timestamping (M2)")
    ss = p.add_subparsers(dest="sfd_cmd", required=True)
    q = ss.add_parser("status", help="counters, deltas, latencies, latest timestamps")
    q.add_argument("--json", action="store_true")
    q.add_argument("--clear", action="store_true", help="clear the SFD counters after reading")
    q = ss.add_parser("config", help="windows, offsets, filter, match/log enables")
    q.add_argument("--rx-win", nargs=2, type=int, metavar=("MIN", "MAX"))
    q.add_argument("--tx-win", nargs=2, type=int, metavar=("MIN", "MAX"))
    q.add_argument("--rx-offset", nargs=2, type=int, action="append", metavar=("PORT", "NS"))
    q.add_argument("--tx-offset", nargs=2, type=int, action="append", metavar=("PORT", "NS"))
    q.add_argument("--match", choices=["on", "off"])
    q.add_argument("--log", choices=["on", "off"])
    q.add_argument("--min-low", type=int)
    q.add_argument("--min-high", type=int)
    q = ss.add_parser("log", help="pop a port's SFD log FIFO")
    q.add_argument("port", type=port_t)
    q.add_argument("--dir", choices=["rx", "tx"], default="tx")
    q.add_argument("--json", action="store_true")
    p = sub.add_parser("gen", help="per-port hardware traffic generator (M2)")
    p.add_argument("port", type=port_t)
    gs = p.add_subparsers(dest="gen_cmd", required=True)
    q = gs.add_parser("start")
    q.add_argument("--size", type=int, default=64, help="wire size incl. FCS (64)")
    q.add_argument("--count", type=int, default=0, help="frames, 0 = until stopped")
    q.add_argument("--ifg", type=int, default=12, help="inter-frame gap in bytes (12 = line rate)")
    q.add_argument("--rate", type=float, help="frames/s (sets --ifg)")
    q.add_argument("--raw", action="store_true", help="raw EtherType frames instead of PRSQ/UDP")
    q.add_argument("--etype", type=parse_int, default=0x88B5)
    q.add_argument("--dst", default="ff:ff:ff:ff:ff:ff")
    q.add_argument("--src", help="default 02:00:00:00:00:0<port>")
    q.add_argument("--stream", type=parse_int, help="PRSQ stream id (default the port)")
    q.add_argument("--seq-first", type=parse_int, default=0)
    q.add_argument("--rand-mask", type=parse_int, help="random extra length: size + (LFSR & mask)")
    q.add_argument("--no-select", action="store_true", help="do not set PATH_CTRL to gen")
    q.add_argument("--bad", action="store_true",
                   help="send every frame error-terminated (bad-frame forwarding test, m0 map 1.2)")
    gs.add_parser("stop")
    q = gs.add_parser("status")
    q.add_argument("--json", action="store_true")
    p = sub.add_parser("chk", help="per-port receive checker for generator traffic (M2)")
    p.add_argument("port", type=port_t)
    cs = p.add_subparsers(dest="chk_cmd", required=True)
    q = cs.add_parser("start")
    q.add_argument("--raw", action="store_true")
    q.add_argument("--etype", type=parse_int, default=0x88B5)
    cs.add_parser("stop")
    q = cs.add_parser("status")
    q.add_argument("--json", action="store_true")
    p = sub.add_parser("watch", help="re-trigger SGMII on link changes; TAP link propagation")
    p.add_argument("--interval", type=float, default=0.25)
    p.add_argument("--no-propagate", action="store_true",
                   help="do not propagate link state across TAP pairs")
    p.add_argument("--debounce", type=float, default=0.5,
                   help="s a link change must persist before it is propagated (0.5)")
    p.add_argument("--grace", type=float, default=6.0,
                   help="s a freshly powered-up PHY gets to negotiate before its link-down "
                        "counts (6)")
    p.add_argument("--json", action="store_true", help="log one JSON object per line")
    p = sub.add_parser("mode", help="per-pair TAP / monitor mode (M3)")
    p.add_argument("what", help="pair 0|1, or status")
    p.add_argument("mode", nargs="?", choices=sorted(PAIR_MODES))
    p.add_argument("--force", action="store_true", help="switch even while a capture runs")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("ifg", help="dynamic inter-frame gap of the TAP forward path (M3)")
    p.add_argument("port", help="0..3 or all")
    p.add_argument("--enable", choices=["on", "off"])
    p.add_argument("--nom", type=int, help="normal gap, bytes (12)")
    p.add_argument("--min", type=int, help="reduced gap, bytes (8)")
    p.add_argument("--hi", type=int, help="FWD fill (bytes) that starts the reduced gap (3072)")
    p.add_argument("--lo", type=int, help="FWD fill (bytes) that ends it (2048; > largest frame)")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("latency", help="TAP forwarding latency from the SFD logs (M3)")
    p.add_argument("--pair", type=int, choices=[0, 1], help="both directions of a pair")
    p.add_argument("--in", dest="inp", type=port_t, help="receiving port")
    p.add_argument("--out", type=port_t, help="forwarding port")
    p.add_argument("--count", type=int, default=200, help="samples per direction (200)")
    p.add_argument("--timeout", type=float, default=30.0, help="s (30)")
    p.add_argument("--window", type=int, default=30000,
                   help="max TX-RX ns for a match (30000; keep frames >= 2x apart)")
    p.add_argument("--cluster", type=int, default=500,
                   help="ns around the median that count as the main cluster (500)")
    p.add_argument("--label", default="", help="free text in the output (e.g. the frame size)")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("mdio", help="raw PHY register access")
    p.add_argument("phy", help="p0..p3 or an MDIO address")
    p.add_argument("reg")
    p.add_argument("val", nargs="?")
    args = ap.parse_args()

    b = Board(args.devmem)
    try:
        {"init": cmd_init, "status": cmd_status, "path": cmd_path, "counters": cmd_counters,
         "watch": cmd_watch, "mdio": cmd_mdio, "sfd": cmd_sfd, "gen": cmd_gen,
         "chk": cmd_chk, "mode": cmd_mode, "ifg": cmd_ifg,
         "latency": cmd_latency}[args.cmd](b, args)
    except KeyboardInterrupt:
        pass
    except RuntimeError as e:
        raise SystemExit(f"pktrec-phy: {e}")


if __name__ == "__main__":
    main()
