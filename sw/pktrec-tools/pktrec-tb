def write_json_atomic(path, obj):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def read_state(path=TB_STATE, now_ns=None):
    """The daemon's state, with 'fresh' = updated recently by a live process."""
    try:
        with open(path) as f:
            st = json.load(f)
    except (OSError, ValueError):
        return None
    now_ns = now_ns or time.time_ns()
    age = (now_ns - st.get("updated_ns", 0)) / 1e9
    alive = True
    pid = st.get("pid")
    if pid:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            alive = False
        except PermissionError:
            pass
    st["age_s"] = round(age, 3)
    st["fresh"] = bool(alive and st.get("running") and
                       -5 < age < 3 * st.get("interval_s", 1.0) + 5)
    return st


class Servo:
    """PI controller on the timebase frequency (ppb); offset in ns, dt in s."""

    def __init__(self, kp, ki, max_ppb):
        self.kp, self.ki, self.max = kp, ki, max_ppb
        self.i = 0.0

    def reset(self, ppb):
        self.i = max(-self.max, min(self.max, ppb))

    def update(self, x_ns, dt, integrate=True):
        dt = max(dt, 1e-3)
        p = -self.kp * x_ns / dt
        i = self.i - self.ki * x_ns / dt if integrate else self.i
        i = max(-self.max, min(self.max, i))
        out = i + p
        if out > self.max or out < -self.max:
            out = max(-self.max, min(self.max, out))
            # anti-windup: integrate only toward the unsaturated side
            if integrate and abs(i) > abs(self.i):
                i = self.i
        self.i = i
        return out


class Daemon:
    def __init__(self, hw, clock, o, out=sys.stdout, state_path=TB_STATE):
        self.hw, self.clock, self.o, self.out, self.state_path = hw, clock, o, out, state_path
        self.max_ppb = o.max_ppm * 1e3
        self.servo = Servo(o.kp, o.ki, self.max_ppb)
        self.st = {
            "version": STATE_VERSION, "pid": os.getpid(), "running": True,
            "state": "startup", "locked": False, "locked_since_ns": None,
            "offset_ns": None, "offset_abs_max_30s_ns": None, "offset_rms_30s_ns": None,
            "latency_ns": None, "freq_ppb": None, "freq_est_ppb": None, "ppm": None,
            "inc_raw": None, "inc_ns": None, "dp_clk_hz": hw.dp_clk_hz,
            "last_set_ns": None, "last_set_reason": None, "sets": 0, "adj_steps": 0,
            "adj_total_ns": 0, "steps_detected": 0, "ntp_synced": None,
            "capture_running": None, "started_ns": clock.realtime_ns(),
            "interval_s": o.interval, "lock_threshold_ns": o.lock_threshold,
            "lock_time_s": o.lock_time, "max_ppm": o.max_ppm,
            "max_adj_ns": o.max_adj, "step_threshold_ns": o.step_threshold,
            "source": hw.src, "message": None, "seeded_from_calibration": None,
            "kernel_freq_ppm": None, "kernel_esterror_us": None,
            "stable_window_s": getattr(o, "stable_window", 600.0),
            "freq_est_window_s": 0.0, "freq_est_min_ppb": None, "freq_est_max_ppb": None,
            "freq_est_mean_ppb": None,
        }
        self.good = 0.0             # seconds with |offset| < lock threshold
        self.bad = 0                # consecutive samples beyond the unlock threshold
        self.hist = []              # (mono, offset) of the last lock_time seconds
        self.fhist = []             # (mono, freq_est_ppb) while locked, last stable_window s
        self.est = []               # (mono, offset) while estimating the frequency
        self.prev = None            # (mono, offset, adj applied after it)
        self.inc_written = None
        self.stop = False
        self.ntp_t = -1e9
        self.warned_cap = False
        self.next_summary = 0.0

    # ---- helpers ----
    def log(self, msg):
        self.st["message"] = msg
        print(f"pktrec-tb: {msg}", file=self.out, flush=True)

    def write_freq(self, ppb):
        ppb = max(-self.max_ppb, min(self.max_ppb, ppb))
        inc = ppb_to_inc(ppb, self.hw.dp_clk_hz)
        if inc != self.inc_written:
            self.hw.set_inc_raw(inc)
            self.inc_written = inc
        self.st.update(freq_ppb=round(ppb, 3), ppm=round(ppb / 1e3, 6), inc_raw=f"0x{inc:010x}",
                       inc_ns=inc / 2 ** 32)
        return ppb

    def do_set(self, reason):
        t = self.clock.realtime_ns()
        self.hw.set_ns(t)
        x, _, _ = measure(self.hw, self.clock, self.o.samples)
        if abs(x) < 1e6:            # the register writes took a few us: one ADJ for the rest
            self.hw.adj_ns(-x)
        self.st["sets"] += 1
        self.st["last_set_ns"] = t
        self.st["last_set_reason"] = reason
        self.prev = None
        self.unlock("timebase set")
        self.log(f"TB_SET from CLOCK_REALTIME ({reason}), residual {fmt_ns(x)} corrected")

    def unlock(self, why):
        if self.st["locked"]:
            self.log(f"lock lost: {why}")
        self.st["locked"] = False
        self.st["locked_since_ns"] = None
        self.good = 0.0
        self.bad = 0
        self.hist = []
        self.fhist = []
        self.st.update(freq_est_window_s=0.0, freq_est_min_ppb=None, freq_est_max_ppb=None,
                       freq_est_mean_ppb=None)

    # ---- start-up ----
    def startup(self):
        inc = self.hw.inc_raw()
        f0 = inc_to_ppb(inc, self.hw.dp_clk_hz)
        if abs(f0) > self.max_ppb:
            self.log(f"INC 0x{inc:010x} = {f0 / 1e3:+.3f} ppm is outside +-{self.o.max_ppm} ppm; "
                     "starting from 0")
            f0 = 0.0
        self.servo.reset(f0)
        self.inc_written = None
        self.write_freq(f0)
        # A calibrated INC (pktrec-calibration.service ran before us) seeds the
        # controller: no start-up estimate against a possibly untrained system clock,
        # whose 8-s slope would replace it (bench 2026-10-13: +11.67 ppm calibration
        # -> -0.05 ppm after the estimate, because CLOCK_REALTIME itself ran -11.7 ppm).
        seeded = abs(f0) >= 1.0 and not getattr(self.o, "estimate_always", False)
        self.st["seeded_from_calibration"] = seeded
        self.log(f"start: dp_clk {self.hw.dp_clk_hz} Hz, INC from calibration "
                 f"{f0 / 1e3:+.3f} ppm" + (" (seeds the controller, no start-up estimate)"
                                           if seeded else "") +
                 f", interval {self.o.interval} s, kp {self.o.kp} ki {self.o.ki}, "
                 f"lock < {fmt_ns(self.o.lock_threshold)} for {self.o.lock_time} s"
                 + self.kernel_note())
        x, _, _ = measure(self.hw, self.clock, self.o.samples)
        if self.hw.capture_running():
            self.log(f"a capture is running: no TB_SET at start-up (offset {fmt_ns(x)})")
            self.st["state"] = "estimating" if abs(x) < self.o.step_threshold else "waiting"
        elif self.o.no_set:
            self.log(f"--no-set: offset {fmt_ns(x)} left as is")
            self.st["state"] = "estimating"
        else:
            self.do_set("start-up")
            self.st["state"] = "estimating"
        if seeded and self.st["state"] == "estimating":
            self.st["state"] = "tracking"
        self.est = []

    def kernel_note(self):
        k = kernel_clock()
        if k is None:
            return ""
        self.st["kernel_freq_ppm"] = k["total_ppm"]
        self.st["kernel_esterror_us"] = k["esterror_us"]
        return (f"; kernel clock correction {k['total_ppm']:+.3f} ppm "
                f"({'NTP synced' if k['synced'] else 'NTP not synced'})")

    # ---- one control step ----
    def step(self):
        o, hw = self.o, self.hw
        mono = self.clock.monotonic()
        x, lat, t_rt = measure(hw, self.clock, o.samples)
        held = steps_held()
        cap = hw.capture_running() or held
        self.st["steps_held"] = held
        if mono - self.ntp_t > 10:
            k = kernel_clock()
            self.st["ntp_synced"] = k["synced"] if k else ntp_synced()
            if k:
                self.st["kernel_freq_ppm"] = k["total_ppm"]
                self.st["kernel_esterror_us"] = k["esterror_us"]
            self.ntp_t = mono
        self.st.update(offset_ns=int(x), latency_ns=int(lat), capture_running=cap,
                       measured_ns=t_rt)
        # external change of INC (pktrec-tb trim / apply-calibration): adopt it
        inc = hw.inc_raw()
        if self.inc_written is not None and inc != self.inc_written:
            f = inc_to_ppb(inc, hw.dp_clk_hz)
            self.log(f"INC changed externally to 0x{inc:010x} ({f / 1e3:+.3f} ppm): adopted")
            self.servo.reset(f)
            self.inc_written = inc
            self.prev = None

        # huge offset: system clock stepped (NTP sync after boot), or someone SET us
        if abs(x) > o.step_threshold:
            if not cap and not o.no_set:
                self.do_set(f"offset {fmt_ns(x)} > step threshold")
                if self.st["state"] == "waiting":
                    self.st["state"] = "estimating"
                    self.est = []
                return self.finish(mono)
            if self.st["state"] == "waiting":
                return self.finish(mono)
            if not self.warned_cap:
                self.log(f"offset {fmt_ns(x)} beyond the step threshold"
                         + (" while a capture runs: slewing only, TB_SET once it has ended"
                            if cap else " (--no-set): slewing only"))
                self.warned_cap = True
        else:
            self.warned_cap = False
            if self.st["state"] == "waiting":
                self.st["state"] = "estimating"
                self.est = []

        if self.st["state"] == "estimating" and self.st.get("seeded_from_calibration"):
            self.st["state"] = "tracking"          # seeded: no estimate (startup())
            self.prev = None
        if self.st["state"] == "estimating":
            self.est.append((mono, x))
            span = self.est[-1][0] - self.est[0][0]
            if span >= o.estimate and len(self.est) >= 3:
                slope = lsq_slope(self.est)          # ns/s = ppb (timebase too fast > 0)
                f = self.servo.i - slope
                self.servo.reset(f)
                f = self.write_freq(self.servo.i)
                self.log(f"frequency estimate: timebase {slope / 1e3:+.3f} ppm vs CLOCK_REALTIME "
                         f"over {span:.1f} s -> INC trim {f / 1e3:+.3f} ppm")
                self.st["state"] = "tracking"
                self.est = []
                if not cap and not o.no_set and abs(x) > o.lock_threshold / 2:
                    self.do_set("start-up, after the frequency estimate")
            return self.finish(mono)

        # ---- tracking ----
        integrate = True
        if self.prev is not None:
            pm, px, padj = self.prev
            dtp = mono - pm
            jump = x - (px + padj)
            bound = 1e6 + 2 * self.max_ppb * dtp           # 1 ms + worst-case slew
            if abs(jump) > bound:
                self.st["steps_detected"] += 1
                self.log(f"step of {fmt_ns(jump)} detected (system clock or timebase set "
                         "by someone else)")
                self.unlock("step")
                integrate = False
            dt = dtp
        else:
            dt = o.interval
        adj = 0
        if not cap and abs(x) > o.adj_threshold:
            adj = -max(-o.max_adj, min(o.max_adj, x))
            hw.adj_ns(adj)
            self.st["adj_steps"] += 1
            self.st["adj_total_ns"] += int(adj)
        f = self.servo.update(x, dt, integrate)
        self.write_freq(f)
        self.st["freq_est_ppb"] = round(self.servo.i, 3)
        self.prev = (mono, x, adj)

        # lock state
        self.hist = [(m, v) for m, v in self.hist if mono - m < o.lock_time] + [(mono, x)]
        vals = [v for _, v in self.hist]
        self.st["offset_abs_max_30s_ns"] = int(max(abs(v) for v in vals))
        self.st["offset_rms_30s_ns"] = int(math.sqrt(sum(v * v for v in vals) / len(vals)))
        if abs(x) < o.lock_threshold:
            self.good += dt
            self.bad = 0
        else:
            self.good = 0.0
            if abs(x) > 5 * o.lock_threshold:
                self.bad += 1
        if not self.st["locked"] and self.good >= o.lock_time:
            self.st["locked"] = True
            self.st["locked_since_ns"] = t_rt
            self.log(f"locked: |offset| < {fmt_ns(o.lock_threshold)} for {o.lock_time} s, "
                     f"rms {fmt_ns(self.st['offset_rms_30s_ns'])}, "
                     f"frequency trim {self.servo.i / 1e3:+.3f} ppm")
        elif self.st["locked"] and self.bad >= 3:
            self.unlock(f"|offset| {fmt_ns(x)} > {fmt_ns(5 * o.lock_threshold)} for 3 samples")
        if self.st["locked"]:
            win = getattr(o, "stable_window", 600.0)
            self.fhist = [(m, v) for m, v in self.fhist if mono - m <= win] + [(mono, self.servo.i)]
            fv = [v for _, v in self.fhist]
            self.st.update(freq_est_window_s=round(mono - self.fhist[0][0], 1),
                           freq_est_min_ppb=round(min(fv), 3), freq_est_max_ppb=round(max(fv), 3),
                           freq_est_mean_ppb=round(sum(fv) / len(fv), 3))
        return self.finish(mono)

    def finish(self, mono):
        st = self.st
        st["updated_ns"] = self.clock.realtime_ns()
        st["updated"] = iso_ns(st["updated_ns"])
        st["last_set"] = iso_ns(st["last_set_ns"])
        st["locked_since"] = iso_ns(st["locked_since_ns"])
        if self.state_path:
            try:
                write_json_atomic(self.state_path, st)
            except OSError as e:
                self.log(f"cannot write {self.state_path}: {e}")
        if self.o.verbose:
            print(f"pktrec-tb: {st['state']:10s} offset {fmt_ns(st['offset_ns']):>13} "
                  f"lat {st['latency_ns']} ns freq {st['freq_ppb']} ppb"
                  f"{' LOCKED' if st['locked'] else ''}{' CAPTURE' if st['capture_running'] else ''}",
                  file=self.out, flush=True)
        elif mono >= self.next_summary and st["state"] == "tracking":
            self.next_summary = mono + self.o.summary
            kf = st.get("kernel_freq_ppm")
            print(f"pktrec-tb: {'locked' if st['locked'] else 'tracking'}, offset "
                  f"{fmt_ns(st['offset_ns'])} (rms {fmt_ns(st['offset_rms_30s_ns'])}, max "
                  f"{fmt_ns(st['offset_abs_max_30s_ns'])} over {self.o.lock_time} s), trim "
                  f"{(st['freq_ppb'] or 0) / 1e3:+.3f} ppm (estimate "
                  f"{(st['freq_est_ppb'] or 0) / 1e3:+.3f}), kernel clock correction "
                  + (f"{kf:+.3f} ppm" if kf is not None else "?")
                  + f", NTP {({True: 'synced', False: 'NOT synced', None: '?'})[st['ntp_synced']]}",
                  file=self.out, flush=True)
        return st

    def shutdown(self):
        self.st.update(running=False, state="stopped", locked=False)
        self.log("stopped (INC left at the last trim: free-running holdover)")
        self.finish(self.clock.monotonic())

    def run(self, duration=None):
        self.startup()
        t_next = self.clock.monotonic()
        t_end = t_next + duration if duration else None
        while not self.stop:
            self.step()
            t_next += self.o.interval
            now = self.clock.monotonic()
            if t_next < now:                       # overrun: skip, keep the phase
                t_next = now + self.o.interval
            if t_end is not None and t_next > t_end:
                break
            self.clock.sleep(t_next - now)
        self.shutdown()


def lsq_slope(pts):
    n = len(pts)
    mx = sum(p[0] for p in pts) / n
    my = sum(p[1] for p in pts) / n
    sxx = sum((p[0] - mx) ** 2 for p in pts)
    sxy = sum((p[0] - mx) * (p[1] - my) for p in pts)
    return sxy / sxx if sxx > 0 else 0.0


