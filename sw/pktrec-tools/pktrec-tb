def open_hw(a):
    if a.sim is not None:
        return SimHw(a.sim, noise_ns=a.sim_noise)
    return Hw(a.devmem)


def status_doc(hw, clock, samples=15):
    x, lat, t_rt = measure(hw, clock, samples)
    inc = hw.inc_raw()
    ppb = inc_to_ppb(inc, hw.dp_clk_hz)
    d = st_daemon = read_state()
    doc = {
        "time_ns": t_rt, "time": iso_ns(t_rt), "timebase_ns": hw.now_ns(),
        "offset_ns": int(x), "latency_ns": int(lat),
        "inc_raw": f"0x{inc:010x}", "inc_ns": inc / 2 ** 32,
        "nominal_inc_ns": nominal_inc_raw(hw.dp_clk_hz) / 2 ** 32, "dp_clk_hz": hw.dp_clk_hz,
        "freq_ppb": round(ppb, 3), "ppm": round(ppb / 1e3, 6), "tb_status": f"0x{hw.tb_status():02x}",
        "capture_running": hw.capture_running(), "ntp_synced": ntp_synced(),
        "kernel_clock": kernel_clock(),
        "cap_version": f"0x{hw.version:08x}", "source": hw.src,
        "daemon": None, "locked": False, "calibration": calibration_info(),
    }
    if d is not None:
        doc["daemon"] = {k: d.get(k) for k in (
            "fresh", "state", "locked", "locked_since", "offset_ns", "offset_rms_30s_ns",
            "offset_abs_max_30s_ns", "freq_ppb", "freq_est_ppb", "last_set", "last_set_reason",
            "sets", "adj_steps", "steps_detected", "updated", "age_s", "pid", "message",
            "seeded_from_calibration", "kernel_freq_ppm", "freq_est_window_s", "freq_est_min_ppb",
            "freq_est_max_ppb", "freq_est_mean_ppb")}
        doc["locked"] = bool(st_daemon.get("fresh") and st_daemon.get("locked"))
    return doc


def calibration_info(path=CAL_FILE, applied_path=CAL_STATE):
    info = {"file": path, "present": os.path.isfile(path), "mtime": None, "applied": None}
    if info["present"]:
        info["mtime"] = iso_ns(int(os.stat(path).st_mtime * 1e9))
    try:
        with open(applied_path) as f:
            ap = json.load(f)
        info["applied"] = {k: ap.get(k) for k in ("applied", "file", "ok", "errors", "warnings")}
    except (OSError, ValueError):
        pass
    return info


def cmd_status(a):
    hw = open_hw(a)
    doc = status_doc(hw, SysClock())
    if a.json:
        print(json.dumps(doc, indent=1))
        return 0
    yn = {True: "yes", False: "NO", None: "unknown"}
    print(f"timebase      {doc['timebase_ns']} ns ({iso_ns(doc['timebase_ns'])})")
    print(f"offset        {fmt_ns(doc['offset_ns'])} vs CLOCK_REALTIME (read latency "
          f"{doc['latency_ns']} ns)")
    print(f"INC           {doc['inc_raw']} = {doc['inc_ns']:.9f} ns/cycle, nominal "
          f"{doc['nominal_inc_ns']:.9f} (dp_clk {doc['dp_clk_hz']} Hz): {doc['ppm']:+.3f} ppm")
    k = doc.get("kernel_clock")
    print(f"system clock  NTP synchronised: {yn[doc['ntp_synced']]}" +
          (f"; kernel frequency correction {k['total_ppm']:+.3f} ppm, estimated error "
           f"{k['esterror_us']} us" if k else ""))
    print(f"capture       {'RUNNING' if doc['capture_running'] else 'idle'}, TB_STATUS "
          f"{doc['tb_status']}, capture map {doc['cap_version']} ({doc['source']})")
    d = doc["daemon"]
    if d is None:
        print("daemon        not running (no state file " + TB_STATE + ")")
    else:
        print(f"daemon        {'running' if d['fresh'] else 'NOT running (stale state, age %ss)' % d['age_s']}"
              f", state {d['state']}, {'LOCKED since ' + str(d['locked_since']) if d['locked'] else 'not locked'}")
        print(f"              last offset {fmt_ns(d['offset_ns'])}, rms {fmt_ns(d['offset_rms_30s_ns'])}"
              f", max {fmt_ns(d['offset_abs_max_30s_ns'])} (30 s); frequency estimate "
              f"{(d['freq_est_ppb'] or 0) / 1e3:+.3f} ppm")
        print(f"              {d['sets']} TB_SET (last {d['last_set']}: {d['last_set_reason']}), "
              f"{d['adj_steps']} ADJ steps, {d['steps_detected']} steps detected")
    c = doc["calibration"]
    ap = c["applied"]
    print(f"calibration   {c['file']}: {'present' if c['present'] else 'MISSING'}"
          + (f", applied {ap['applied']} ({'ok' if ap['ok'] else 'with errors'})" if ap else
             ", not applied since boot"))
    return 0


def daemon_running():
    st = read_state()
    return st is not None and st.get("fresh")


def cmd_set(a):
    hw = open_hw(a)
    clock = SysClock()
    if hw.capture_running() and not a.force:
        print("pktrec-tb: a capture is running: a TB_SET would mis-stamp the frames in the "
              "FIFOs and break the file's time scale (use --force)", file=sys.stderr)
        return 1
    if daemon_running():
        print("pktrec-tb: note: pktrec-tb daemon is running; it will see this as a step",
              file=sys.stderr)
    x0, _, _ = measure(hw, clock)
    t = clock.realtime_ns()
    hw.set_ns(t)
    x1, _, _ = measure(hw, clock)
    print(f"timebase set to CLOCK_REALTIME {iso_ns(t)}: offset {fmt_ns(x0)} -> {fmt_ns(x1)}")
    return 0


def cmd_trim(a):
    hw = open_hw(a)
    if a.inc is not None:
        inc = int(a.inc, 0)
    else:
        ppb = a.ppm * 1e3 if a.ppm is not None else a.ppb
        inc = ppb_to_inc(ppb, hw.dp_clk_hz)
    ppb = inc_to_ppb(inc, hw.dp_clk_hz)
    if not 0 < inc < (1 << 40):
        print(f"pktrec-tb: INC 0x{inc:x} out of range", file=sys.stderr)
        return 1
    if abs(ppb) > 200e3 and not a.force:
        print(f"pktrec-tb: {ppb / 1e3:+.3f} ppm is beyond +-200 ppm (use --force)", file=sys.stderr)
        return 1
    old = hw.inc_raw()
    hw.set_inc_raw(inc)
    print(f"INC 0x{old:010x} ({inc_to_ppb(old, hw.dp_clk_hz) / 1e3:+.3f} ppm) -> 0x{inc:010x} "
          f"({ppb / 1e3:+.3f} ppm)")
    if daemon_running():
        print("pktrec-tb: note: the running daemon adopts this value and keeps disciplining "
              "from it", file=sys.stderr)
    return 0


def cmd_daemon(a):
    hw = open_hw(a)
    d = Daemon(hw, SysClock(), a, state_path=a.state)

    def on_sig(signum, frame):
        d.stop = True
    signal.signal(signal.SIGTERM, on_sig)
    signal.signal(signal.SIGINT, on_sig)
    try:
        d.run(a.duration)
    except KeyboardInterrupt:
        d.shutdown()
    return 0


def cmd_apply(a):
    hw = open_hw(a)
    try:
        v, errs = parse_cal(a.file)
    except FileNotFoundError:
        print(f"pktrec-tb: {a.file}: no such file (registers left at their reset values)",
              file=sys.stderr)
        return 1
    except configparser.Error as e:
        print(f"pktrec-tb: {a.file}: {e}", file=sys.stderr)
        return 1
    if hw.capture_running() and not a.force and not a.dry_run:
        print("pktrec-tb: a capture is running: calibration changes would apply in the middle "
              "of it (use --force)", file=sys.stderr)
        return 1
    applied, warns, errs2 = apply_cal(hw, v, timebase=not a.no_timebase, dry=a.dry_run)
    errs += errs2
    for w in warns:
        print(f"pktrec-tb: warning: {w}", file=sys.stderr)
    for e in errs:
        print(f"pktrec-tb: error: {e}", file=sys.stderr)
    print(f"pktrec-tb: {'would apply' if a.dry_run else 'applied'} {a.file}: " +
          ", ".join(f"{k}={val}" for k, val in applied.items()))
    if not a.dry_run:
        now = time.time_ns()
        try:
            write_json_atomic(a.state, {"applied_ns": now, "applied": iso_ns(now), "file": a.file,
                                        "ok": not errs, "values": applied, "errors": errs,
                                        "warnings": warns})
        except OSError as e:
            print(f"pktrec-tb: cannot write {a.state}: {e}", file=sys.stderr)
    return 1 if errs else 0


def timebase_save_verdict(st, now_ns, min_locked_s, max_delta_ppb):
    """-> (ppb or None, reason): the daemon's frequency estimate when it is good
    enough to persist, else None and why not."""
    if not st or not st.get("fresh"):
        return None, "the pktrec-tb daemon is not running"
    if not st.get("locked") or not st.get("locked_since_ns"):
        return None, "the pktrec-tb daemon is not locked"
    locked_s = (now_ns - st["locked_since_ns"]) / 1e9
    if locked_s < min_locked_s:
        return None, (f"the daemon has been locked for {locked_s / 60:.1f} min only "
                      f"(needs {min_locked_s / 60:.0f} min)")
    span = st.get("freq_est_window_s") or 0.0
    need = min(min_locked_s, st.get("stable_window_s") or min_locked_s) - 3 * (st.get("interval_s") or 1)
    lo, hi = st.get("freq_est_min_ppb"), st.get("freq_est_max_ppb")
    if lo is None or hi is None or span < need:
        return None, f"the daemon's frequency history covers {span:.0f} s only (needs {need:.0f} s)"
    if hi - lo >= max_delta_ppb:
        return None, (f"the frequency estimate moved {(hi - lo) / 1e3:.3f} ppm over the last "
                      f"{span:.0f} s (limit {max_delta_ppb / 1e3:.3f} ppm): not stable yet")
    ppb = st.get("freq_est_mean_ppb")
    if ppb is None:
        ppb = st.get("freq_est_ppb")
    return ppb, (f"daemon locked {locked_s / 60:.1f} min, estimate within {(hi - lo) / 1e3:.3f} ppm "
                 f"over {span:.0f} s")


def cmd_save(a):
    if a.defaults:
        v, origin, dp = cal_defaults(), "design defaults (register reset values)", DP_CLK_HZ_DEFAULT
    else:
        hw = open_hw(a)
        skew = skew_corrections(hw)
        v, dp = cal_from_regs(hw, skew), hw.dp_clk_hz
        for n, (r, base, corr) in sorted(skew.items()):
            print(f"pktrec-tb: port{n}.rx_offset_ns: saving the calibration base {base} ns "
                  f"(register {r} ns includes pktrec-phy watch's 0x0055 correction {corr:+d} ns)",
                  file=sys.stderr)
        live = v[("timebase", "ppm")]
        st = read_state()
        ppb, why = timebase_save_verdict(st, time.time_ns(), a.min_locked * 60.0,
                                         a.max_ppm_delta * 1e3)
        if ppb is not None:
            # the daemon's (window-averaged) frequency estimate, not the momentary
            # P-term-loaded INC
            v[("timebase", "ppm")] = round(ppb / 1e3, 6)
            print(f"pktrec-tb: timebase.ppm = {ppb / 1e3:+.6f} ({why})", file=sys.stderr)
        elif a.force_timebase:
            if st and st.get("fresh") and st.get("freq_est_ppb") is not None:
                v[("timebase", "ppm")] = round(st["freq_est_ppb"] / 1e3, 6)
            print(f"pktrec-tb: warning: {why}; --force-timebase: saving timebase.ppm = "
                  f"{v[('timebase', 'ppm')]:+.6f}", file=sys.stderr)
        else:
            old = None
            try:
                fv, _ = parse_cal(a.file)
                old = tb_ppb_from_cal(fv, dp)
            except (OSError, configparser.Error):
                pass
            if old is not None:
                v[("timebase", "ppm")] = round(old / 1e3, 6)
                keep = f"keeping the file's timebase.ppm = {old / 1e3:+.6f}"
            else:
                v[("timebase", "ppm")] = 0.0
                keep = "the file has no timebase value: writing the design default 0"
            print(f"pktrec-tb: timebase.ppm NOT updated: {why}; {keep} (the live INC is "
                  f"{live:+.6f} ppm; --force-timebase stores it anyway)", file=sys.stderr)
        origin = (f"saved {iso_ns(time.time_ns())} on {socket.gethostname()} by "
                  f"'pktrec-tb save-calibration', capture map 0x{hw.version:08x}")
    text = render_cal(v, origin, dp)
    if a.stdout:
        sys.stdout.write(text)
        return 0
    os.makedirs(os.path.dirname(a.file) or ".", exist_ok=True)
    if os.path.exists(a.file):
        try:
            os.replace(a.file, a.file + ".bak")
        except OSError:
            pass
    tmp = a.file + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, a.file)
    print(f"pktrec-tb: wrote {a.file}" + (" (previous version: .bak)" if
                                          os.path.exists(a.file + ".bak") else ""))
    return 0


def cmd_show(a):
    hw = open_hw(a)
    skew = skew_corrections(hw)
    cur = cal_from_regs(hw, skew)
    try:
        filev, errs = parse_cal(a.file)
    except (OSError, configparser.Error) as e:
        filev, errs = {}, [str(e)]
    if ("timebase", "ppm") not in filev:
        p = tb_ppb_from_cal(filev, hw.dp_clk_hz)
        if p is not None:
            filev[("timebase", "ppm")] = round(p / 1e3, 6)
    keys = [("timebase", "ppm")] + [(s, k) for s, k, _, _, _ in CAL_REGS]
    dflt = cal_defaults()
    rows = [{"key": f"{s}.{k}", "register": cur.get((s, k)), "file": filev.get((s, k)),
             "default": dflt.get((s, k))} for s, k in keys]
    if a.json:
        print(json.dumps({"file": a.file, "errors": errs, "keys": rows,
                          "rx_skew_corrections": {f"port{n}": {"register": r, "base": b, "corr": c}
                                                  for n, (r, b, c) in skew.items()},
                          "calibration": calibration_info(a.file)}, indent=1))
        return 0
    print(f"{'key':26} {'register':>12} {'file':>12} {'default':>10}")
    for r in rows:
        mark = "" if r["file"] is None or r["file"] == r["register"] else "   <- differs"
        if r["key"] == "timebase.ppm" and r["file"] is not None and r["register"] is not None:
            mark = "   (daemon trims it)" if abs(r["file"] - r["register"]) > 1e-3 else ""
        for n, (reg, base, corr) in skew.items():
            if r["key"] == f"port{n}.rx_offset_ns":
                mark += f"   (base; register {reg} = base {corr:+d} ns 0x0055 correction)"
        print(f"{r['key']:26} {str(r['register']):>12} {str(r['file'] if r['file'] is not None else '-'):>12}"
              f" {str(r['default']):>10}{mark}")
    for e in errs:
        print(f"file error: {e}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="pktrec-tb", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("Commands:", 1)[1])
    ap.add_argument("--devmem", action="store_true", help="use /dev/mem instead of UIO")
    ap.add_argument("--sim", type=float, metavar="PPM",
                    help="host test: simulated timebase whose clock is off by PPM")
    ap.add_argument("--sim-noise", type=float, default=300.0, metavar="NS",
                    help="--sim: read jitter, ns rms (default 300)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("status", help="timebase vs CLOCK_REALTIME, daemon state")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("set", help="TB_SET from CLOCK_REALTIME")
    p.add_argument("--force", action="store_true", help="even while a capture runs")
    p = sub.add_parser("trim", help="write INC (frequency)")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--ppm", type=float)
    g.add_argument("--ppb", type=float)
    g.add_argument("--inc", help="raw 32.32 value, e.g. 0x0400068db8")
    p.add_argument("--force", action="store_true", help="allow beyond +-200 ppm")
    p = sub.add_parser("daemon", help="discipline the timebase to CLOCK_REALTIME")
    p.add_argument("--interval", type=float, default=1.0, help="seconds per sample (1)")
    p.add_argument("--samples", type=int, default=7, help="read pairs per sample, min latency kept (7)")
    p.add_argument("--kp", type=float, default=0.2)
    p.add_argument("--ki", type=float, default=0.02)
    p.add_argument("--max-ppm", type=float, default=200.0, help="frequency bound (200)")
    p.add_argument("--estimate", type=float, default=8.0,
                   help="seconds of frequency estimation at start-up (8); skipped when the "
                        "calibration set the INC (see --estimate-always)")
    p.add_argument("--estimate-always", action="store_true",
                   help="estimate the frequency at start-up even when the calibration set it")
    p.add_argument("--stable-window", type=float, default=600.0,
                   help="seconds of frequency-estimate history kept while locked, for "
                        "save-calibration (600)")
    p.add_argument("--lock-threshold", type=float, default=10000.0, help="ns (10000)")
    p.add_argument("--lock-time", type=float, default=30.0, help="seconds (30)")
    p.add_argument("--adj-threshold", type=float, default=20000.0,
                   help="TB_ADJ only above this |offset|, ns (20000)")
    p.add_argument("--max-adj", type=float, default=1000.0, help="largest TB_ADJ step, ns (1000)")
    p.add_argument("--step-threshold", type=float, default=1e9,
                   help="TB_SET above this |offset|, ns (1e9 = 1 s)")
    p.add_argument("--no-set", action="store_true", help="never TB_SET (not even at start-up)")
    p.add_argument("--state", default=TB_STATE, help=f"state file ({TB_STATE})")
    p.add_argument("--summary", type=float, default=60.0, help="log a summary every S s (60)")
    p.add_argument("--duration", type=float, help="exit after S seconds (tests)")
    p.add_argument("-v", "--verbose", action="store_true", help="log every sample")
    p = sub.add_parser("apply-calibration", help="calibration file -> registers")
    p.add_argument("--file", default=CAL_FILE)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--force", action="store_true", help="even while a capture runs")
    p.add_argument("--no-timebase", action="store_true", help="leave INC alone")
    p.add_argument("--state", default=CAL_STATE, help=f"result record ({CAL_STATE})")
    p = sub.add_parser("save-calibration", help="registers -> calibration file")
    p.add_argument("--file", default=CAL_FILE)
    p.add_argument("--stdout", action="store_true")
    p.add_argument("--defaults", action="store_true",
                   help="the design defaults instead of the registers (no hardware)")
    p.add_argument("--min-locked", type=float, default=10.0,
                   help="minutes the daemon must have been locked before its frequency "
                        "estimate is saved (10)")
    p.add_argument("--max-ppm-delta", type=float, default=0.2,
                   help="largest change of the frequency estimate over that time, ppm (0.2)")
    p.add_argument("--force-timebase", action="store_true",
                   help="save the timebase ppm even when the daemon is not locked/stable "
                        "(the daemon's estimate if it runs, else the live INC)")
    p = sub.add_parser("show-calibration", help="registers vs the calibration file")
    p.add_argument("--file", default=CAL_FILE)
    p.add_argument("--json", action="store_true")
    a = ap.parse_args()
    fn = {"status": cmd_status, "set": cmd_set, "trim": cmd_trim, "daemon": cmd_daemon,
          "apply-calibration": cmd_apply, "save-calibration": cmd_save,
          "show-calibration": cmd_show}[a.cmd]
    return fn(a)


if __name__ == "__main__":
    sys.exit(main())
