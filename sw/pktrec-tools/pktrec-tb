def load_pktrec_phy():
    """Import pktrec-phy (same directory, else /usr/bin) for its Regs/UIO helper."""
    import importlib.machinery
    import importlib.util
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "pktrec-phy"), "/usr/bin/pktrec-phy"):
        if os.path.isfile(path):
            sys.dont_write_bytecode = True        # no __pycache__ next to /usr/bin
            loader = importlib.machinery.SourceFileLoader("pktrec_phy", path)
            spec = importlib.util.spec_from_loader("pktrec_phy", loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    raise SystemExit("pktrec-tb: pktrec-phy not found (needed for the register access)")


class Hw:
    """Timebase + calibration registers of the capture block (UIO or /dev/mem)."""

    def __init__(self, devmem=False):
        phy = load_pktrec_phy()
        self.r = phy.Regs(CAP_BASE, CAP_SIZE, devmem)
        cid = self.r.rd(CAP_ID)
        if cid != CAP_ID_VALUE:
            raise SystemExit(f"pktrec-tb: capture block ID 0x{cid:08x}, expected "
                             f"0x{CAP_ID_VALUE:08x} (wrong bitstream?)")
        self.version = self.r.rd(CAP_VERSION)
        self.dp_clk_hz = self.r.rd(CAP_DP_CLK_HZ) or DP_CLK_HZ_DEFAULT
        self.has_sfd = self.version >= 0x00010002
        self.src = self.r.src

    def rd(self, off):
        return self.r.rd(off)

    def wr(self, off, v):
        self.r.wr(off, v & 0xFFFFFFFF)

    def now_ns(self):
        lo = self.r.rd(TB_NOW_LO)                 # the LO read latches HI
        return lo | (self.r.rd(TB_NOW_LO + 4) << 32)

    def set_ns(self, t):
        self.wr(TB_SET_LO, t)
        self.wr(TB_SET_LO + 4, t >> 32)
        self.wr(TB_CTRL, TB_CTRL_SET)

    def adj_ns(self, d):
        v = int(d) & 0xFFFFFFFFFFFFFFFF
        self.wr(TB_ADJ_LO, v)
        self.wr(TB_ADJ_LO + 4, v >> 32)
        self.wr(TB_CTRL, TB_CTRL_ADJ)

    def inc_raw(self):
        return ((self.r.rd(TB_INC_NS) & 0xFF) << 32) | self.r.rd(TB_INC_FRAC)

    def set_inc_raw(self, v):
        self.wr(TB_INC_FRAC, v)
        self.wr(TB_INC_NS, (v >> 32) & 0xFF)       # the NS write applies both

    def tb_status(self):
        return self.r.rd(TB_STATUS) & 0xFF

    def capture_running(self):
        """Frames are being stamped into a recording (ENABLE) or drained (FILL)."""
        return bool(self.r.rd(CAP_CTRL) & (CTRL_ENABLE | CTRL_FILL))


class SimHw(Hw):
    """Simulated capture block for host tests: a timebase whose oscillator is off by
    err_ppm, measurement jitter noise_ns, registers persisted in RUN_DIR (so that
    separate CLI invocations see one board)."""

    def __init__(self, err_ppm, clock=None, noise_ns=0.0, persist=True, seed=1):
        self.clock = clock or SysClock()
        self.err = err_ppm * 1e-6
        self.noise = noise_ns
        self.rng = random.Random(seed)
        self.version = 0x00010002
        self.dp_clk_hz = DP_CLK_HZ_DEFAULT
        self.has_sfd = True
        self.src = "simulation"
        self.path = os.path.join(RUN_DIR, "sim-regs.json") if persist else None
        self.cap_ctrl = 0
        self.log = []                               # (what, value) of every SET/ADJ/INC
        st = None
        if self.path:
            try:
                with open(self.path) as f:
                    st = json.load(f)
            except (OSError, ValueError):
                st = None
        if st and st.get("err_ppm") == err_ppm:
            self.regs = {int(k): v for k, v in st["regs"].items()}
            self.base_true, self.base_tb = st["base_true"], st["base_tb"]
        else:
            self.regs = {off: (dflt if kind != "en" else 1) & 0xFFFFFFFF
                         for _, _, off, kind, dflt in CAL_REGS}
            self.regs[SFD_CTRL] = 1
            self.regs[TB_INC_FRAC], self.regs[TB_INC_NS] = nominal_inc_raw(self.dp_clk_hz) & \
                0xFFFFFFFF, nominal_inc_raw(self.dp_clk_hz) >> 32
            self.base_true, self.base_tb = self.clock.true_ns(), 0
        self.save()

    def save(self):
        if self.path:
            os.makedirs(RUN_DIR, exist_ok=True)
            tmp = self.path + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"err_ppm": self.err * 1e6, "regs": self.regs,
                           "base_true": self.base_true, "base_tb": self.base_tb}, f)
            os.replace(tmp, self.path)

    def _rate(self):
        return self.inc_raw() / nominal_inc_raw(self.dp_clk_hz) * (1 + self.err)

    def _tb(self):
        return self.base_tb + (self.clock.true_ns() - self.base_true) * self._rate()

    def _rebase(self, tb):
        self.base_true, self.base_tb = self.clock.true_ns(), tb

    def rd(self, off):
        if off == CAP_CTRL:
            return self.cap_ctrl
        return self.regs.get(off, 0)

    def wr(self, off, v):
        if off == CAP_CTRL:
            self.cap_ctrl = v
            return
        self.regs[off] = v & 0xFFFFFFFF
        self.save()

    def now_ns(self):
        n = self.rng.gauss(0, self.noise) if self.noise else 0.0
        return int(self._tb() + n)

    def set_ns(self, t):
        self._rebase(int(t))
        self.log.append((self.clock.true_ns(),) + ("set", int(t)))
        self.save()

    def adj_ns(self, d):
        self._rebase(self._tb() + int(d))
        self.log.append((self.clock.true_ns(),) + ("adj", int(d)))
        self.save()

    def inc_raw(self):
        return ((self.regs[TB_INC_NS] & 0xFF) << 32) | self.regs[TB_INC_FRAC]

    def set_inc_raw(self, v):
        self._rebase(self._tb())
        self.regs[TB_INC_FRAC], self.regs[TB_INC_NS] = v & 0xFFFFFFFF, (v >> 32) & 0xFF
        self.log.append((self.clock.true_ns(),) + ("inc", v))
        self.save()

    def tb_status(self):
        return 0xFF

    def capture_running(self):
        return bool(self.cap_ctrl & (CTRL_ENABLE | CTRL_FILL))


class SysClock:
    """CLOCK_REALTIME / CLOCK_MONOTONIC of this system."""
    realtime_ns = staticmethod(time.time_ns)
    true_ns = staticmethod(time.monotonic_ns)     # the simulation's reference

    @staticmethod
    def monotonic():
        return time.monotonic()

    @staticmethod
    def sleep(s):
        if s > 0:
            time.sleep(s)


def nominal_inc_raw(dp_clk_hz):
    return round((1 << 32) * 1e9 / dp_clk_hz)


def inc_to_ppb(inc, dp_clk_hz):
    return (inc / nominal_inc_raw(dp_clk_hz) - 1.0) * 1e9


def ppb_to_inc(ppb, dp_clk_hz):
    return round(nominal_inc_raw(dp_clk_hz) * (1.0 + ppb * 1e-9))


def steps_held(run_dir=None):
    """True while a tb-hold[.<pid>] file asks the daemon not to step the timebase."""
    run_dir = run_dir or RUN_DIR
    try:
        names = os.listdir(run_dir)
    except OSError:
        return False
    for n in names:
        if n == "tb-hold":
            return True
        if n.startswith("tb-hold."):
            try:
                os.kill(int(n[8:]), 0)
                return True
            except ProcessLookupError:
                continue
            except PermissionError:
                return True
            except ValueError:
                continue
    return False


def measure(hw, clock, samples=7):
    """Timebase - CLOCK_REALTIME (ns) from the read pair with the shortest latency."""
    best = None
    for _ in range(max(1, samples)):
        t1 = clock.realtime_ns()
        tb = hw.now_ns()
        t2 = clock.realtime_ns()
        lat = t2 - t1
        if best is None or lat < best[1]:
            best = (tb - (t1 + lat // 2), lat, t2)
    return best                                    # (offset_ns, latency_ns, realtime_ns)


def kernel_clock():
    """Read-only adjtimex(): the kernel's NTP state and frequency correction of
    CLOCK_REALTIME vs the raw clock (set by chronyd / timesyncd), or None.
    freq_ppm = timex.freq / 2^16 (PLL / FLL frequency), tick_ppm = the tick length
    offset (chronyd uses it for corrections beyond +-500 ppm), total = both."""
    try:
        import ctypes
        c_long, c_int = ctypes.c_long, ctypes.c_int

        class Timex(ctypes.Structure):          # struct timex, LP64 (aarch64 / x86_64)
            _fields_ = [("modes", ctypes.c_uint), ("offset", c_long), ("freq", c_long),
                        ("maxerror", c_long), ("esterror", c_long), ("status", c_int),
                        ("constant", c_long), ("precision", c_long), ("tolerance", c_long),
                        ("time_sec", c_long), ("time_usec", c_long), ("tick", c_long),
                        ("ppsfreq", c_long), ("jitter", c_long), ("shift", c_int),
                        ("stabil", c_long), ("jitcnt", c_long), ("calcnt", c_long),
                        ("errcnt", c_long), ("stbcnt", c_long), ("tai", c_int),
                        ("pad", c_int * 11)]
        libc = ctypes.CDLL(None, use_errno=True)
        tx = Timex()                               # modes = 0: read only
        r = libc.adjtimex(ctypes.byref(tx))
        if r < 0:
            return None
    except (ImportError, OSError, AttributeError):
        return None
    hz = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100
    nominal_tick = round(1e6 / hz)
    freq_ppm = tx.freq / 65536.0
    tick_ppm = (tx.tick - nominal_tick) / nominal_tick * 1e6 if tx.tick else 0.0
    return {"synced": r != 5,                      # TIME_ERROR = STA_UNSYNC
            "freq_ppm": round(freq_ppm, 4), "tick_ppm": round(tick_ppm, 4),
            "total_ppm": round(freq_ppm + tick_ppm, 4), "status": tx.status,
            "maxerror_us": tx.maxerror, "esterror_us": tx.esterror}


def ntp_synced():
    """True/False from adjtimex (STA_UNSYNC -> TIME_ERROR), else None."""
    k = kernel_clock()
    if k is not None:
        return k["synced"]
    if os.path.isdir("/run/systemd/timesync"):
        return os.path.exists("/run/systemd/timesync/synchronized")
    return None


