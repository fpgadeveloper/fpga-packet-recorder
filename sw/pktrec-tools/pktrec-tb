RUN_DIR = os.environ.get("PKTREC_RUN_DIR", "/run/pktrec")
TB_STATE = os.path.join(RUN_DIR, "tb.json")
CAL_STATE = os.path.join(RUN_DIR, "calibration.json")
CAL_FILE = os.environ.get("PKTREC_CAL_FILE", "/etc/pktrec/calibration.conf")
STATE_VERSION = 1

# capture block, include/pktrec_regs.h (map 1.2)
CAP_BASE, CAP_SIZE = 0x4_2003_0000, 0x1000
CAP_ID, CAP_ID_VALUE, CAP_VERSION = 0x000, 0x504B4350, 0x004
CAP_CTRL, CTRL_ENABLE, CTRL_FILL = 0x008, 0x1, 0x2
CAP_DP_CLK_HZ = 0x018
TB_CTRL, TB_CTRL_SET, TB_CTRL_ADJ = 0x080, 0x1, 0x2
TB_INC_FRAC, TB_INC_NS, TB_STATUS = 0x084, 0x088, 0x08C
TB_NOW_LO, TB_SET_LO, TB_ADJ_LO = 0x090, 0x098, 0x0A0
MAC_OFFSET = 0x0A8
SFD_CTRL, SFD_MATCH_EN = 0x400, 0x1
SFD_RX_WIN_MIN, SFD_RX_WIN_MAX, SFD_TX_WIN_MIN, SFD_TX_WIN_MAX = 0x410, 0x414, 0x418, 0x41C
SFD_MIN_LOW, SFD_MIN_HIGH = 0x420, 0x424
SFD_PORT_BASE, SFD_PORT_STRIDE, SFD_P_RX_OFFSET, SFD_P_TX_OFFSET = 0x800, 0x100, 0x38, 0xB8
DP_CLK_HZ_DEFAULT = 249975006
NUM_PORTS = 4
FRAME_TIME_64B_NS = 672           # minimum frame start-to-start at 1 Gb/s (SFD window bound)

# Calibration registers: key -> (section, offset, kind, design default)
#   kind "s" = signed 32-bit ns, "u8" = 8-bit cycles, "en" = SFD_CTRL.MATCH_EN bit
CAL_REGS = [
    ("capture", "mac_offset_ns", MAC_OFFSET, "s", 52),
    ("sfd", "match", SFD_CTRL, "en", 1),
    ("sfd", "rx_window_min_ns", SFD_RX_WIN_MIN, "s", 100),
    ("sfd", "rx_window_max_ns", SFD_RX_WIN_MAX, "s", 700),
    ("sfd", "tx_window_min_ns", SFD_TX_WIN_MIN, "s", 0),
    ("sfd", "tx_window_max_ns", SFD_TX_WIN_MAX, "s", 900),
    ("sfd", "min_low_cycles", SFD_MIN_LOW, "u8", 25),
    ("sfd", "min_high_cycles", SFD_MIN_HIGH, "u8", 8),
] + [(f"port{n}", f"{d}_offset_ns", SFD_PORT_BASE + n * SFD_PORT_STRIDE + off, "s", 0)
     for n in range(NUM_PORTS) for d, off in (("rx", SFD_P_RX_OFFSET), ("tx", SFD_P_TX_OFFSET))]


def s32(v):
    v &= 0xFFFFFFFF
    return v - (1 << 32) if v & 0x80000000 else v


def iso_ns(ns):
    if not ns:
        return None
    return datetime.datetime.fromtimestamp(ns / 1e9, datetime.timezone.utc) \
        .isoformat(timespec="milliseconds").replace("+00:00", "Z")


def fmt_ns(v):
    """Signed nanoseconds, human scale."""
    if v is None:
        return "-"
    a = abs(v)
    if a >= 1e9:
        return f"{v / 1e9:+.6f} s"
    if a >= 1e6:
        return f"{v / 1e6:+.3f} ms"
    if a >= 1e3:
        return f"{v / 1e3:+.3f} us"
    return f"{v:+.0f} ns"


