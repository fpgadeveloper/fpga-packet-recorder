# calibration file
# ---------------------------------------------------------------------------
CAL_HEADER = """\
# FPGA Packet Recorder calibration ({origin})
#
# Applied at boot by pktrec-calibration.service ('pktrec-tb apply-calibration'),
# after the PHY init (pktrec-phy-watch.service) and before pktrec-tb.service and
# pktrec-web.service. Write it from the board's current registers with
# 'pktrec-tb save-calibration' once the bench calibration (docs: software.md,
# "Calibration") has set them; check with 'pktrec-tb show-calibration'.
# save-calibration takes [timebase] ppm from the pktrec-tb daemon only after it
# has been locked >= 10 min with a stable estimate (else it keeps this file's
# value), and [portN] rx_offset_ns without pktrec-phy watch's 0x0055 correction.
# A missing key leaves that register at its bitstream reset value (the design
# defaults below). The values hold for one bitstream build: re-calibrate after
# every bitstream change (the SFD sampler's clock phase moves between builds).
# Package updates never overwrite this file (CONFFILES).
"""

CAL_BODY = """
[timebase]
# Frequency of the 64-bit ns timebase (dp_clk, nominally {dp} Hz) relative to
# the nominal increment 1e9/DP_CLK_HZ: INC = nominal x (1 + ppm / 1e6);
# > 0 = the timebase runs faster. pktrec-tb.service starts from this value and
# keeps disciplining it to CLOCK_REALTIME (NTP); a good value makes it lock
# sooner and is the holdover frequency when the daemon is stopped. The M1 bench
# board needed about +10.4 ppm.
ppm = {ppm}

[capture]
# PKTREC_CAP_MAC_OFFSET (0x0A8), signed ns added to MAC-fallback timestamps
# (records with flags bit2 = TS_MAC). Calibrated: RX_OFFSET - median(RX_DELTA),
# so MAC-fallback records land on the SFD scale (+-16 ns). Design default 52.
mac_offset_ns = {mac_offset_ns}

[sfd]
# PHY SFD timestamping (PKTREC_SFD_*, capture map 1.2). The windows are global
# (all four ports share them).
# match: on = records carry the PHY RX SFD timestamp (SFD_CTRL.MATCH_EN),
# off = every record is MAC-stamped.
match = {match}
# RX match window, raw MAC - SFD ns (SFD_RX_WIN_MIN/MAX, defaults 100 / 700).
# Keep max - min below {ft} ns (one minimum frame time at 1 Gb/s).
rx_window_min_ns = {rx_window_min_ns}
rx_window_max_ns = {rx_window_max_ns}
# TX pairing window, MAC completion -> TX SFD pin ns (defaults 0 / 900).
tx_window_min_ns = {tx_window_min_ns}
tx_window_max_ns = {tx_window_max_ns}
# Glitch filter, dp_clk cycles (4 ns): low before an edge (25), high after (8).
min_low_cycles = {min_low_cycles}
min_high_cycles = {min_high_cycles}
"""

CAL_PORT = """
[port{n}]
# P{n}: signed ns added to the RX SFD (SFD_P_RX_OFFSET) and TX SFD
# (SFD_P_TX_OFFSET) times. TX SFD is the reference (tx 0); rx = -(PHY RX
# indication delay - TX indication delay), from the P2<->P3 loopback.
rx_offset_ns = {rx}
tx_offset_ns = {tx}
"""


def skew_corrections(hw, path=None):
    """{port: (register, base, correction)} for the RX_OFFSETs that pktrec-phy watch
    currently corrects for a non-zero DP83867 0x0055 (state file phy-watch.json);
    only entries whose register still holds the value watch wrote."""
    path = path or os.path.join(RUN_DIR, "phy-watch.json")
    try:
        with open(path) as f:
            sk = json.load(f).get("skew") or []
    except (OSError, ValueError, AttributeError):
        return {}
    out = {}
    for n, p in enumerate(sk[:NUM_PORTS]):
        if not isinstance(p, dict) or not p.get("corr"):
            continue
        r = s32(hw.rd(SFD_PORT_BASE + n * SFD_PORT_STRIDE + SFD_P_RX_OFFSET))
        if r == p.get("written") and p.get("base") is not None:
            out[n] = (r, p["base"], p["corr"])
    return out


def cal_from_regs(hw, skew=None):
    """Calibration values from the registers; RX offsets with a live 0x0055
    correction (skew_corrections) are taken as their calibration base."""
    v = {}
    for sec, key, off, kind, _ in CAL_REGS:
        if sec != "capture" and not hw.has_sfd:
            continue
        r = hw.rd(off)
        v[(sec, key)] = (r & SFD_MATCH_EN) if kind == "en" else (r & 0xFF if kind == "u8" else s32(r))
    for n, (_, base, _) in (skew or {}).items():
        v[(f"port{n}", "rx_offset_ns")] = base
    v[("timebase", "ppm")] = round(inc_to_ppb(hw.inc_raw(), hw.dp_clk_hz) / 1e3, 6)
    return v


def cal_defaults():
    v = {(sec, key): dflt for sec, key, _, _, dflt in CAL_REGS}
    v[("timebase", "ppm")] = 0.0
    return v


def render_cal(v, origin, dp_clk_hz=DP_CLK_HZ_DEFAULT):
    flat = {key: val for (sec, key), val in v.items() if not sec.startswith("port")}
    flat["match"] = "on" if flat.get("match", 1) else "off"
    flat["ppm"] = f"{flat.get('ppm', 0.0):.6f}"
    text = CAL_HEADER.format(origin=origin) + CAL_BODY.format(dp=dp_clk_hz, ft=FRAME_TIME_64B_NS,
                                                               **flat)
    for n in range(NUM_PORTS):
        text += CAL_PORT.format(n=n, rx=v.get((f"port{n}", "rx_offset_ns"), 0),
                                tx=v.get((f"port{n}", "tx_offset_ns"), 0))
    return text


def parse_cal(path):
    """-> ({(section, key): value}, [errors]); unknown keys are errors."""
    cp = configparser.ConfigParser(inline_comment_prefixes=("#", ";"), interpolation=None)
    with open(path) as f:
        cp.read_file(f)
    known = {(sec, key): kind for sec, key, _, kind, _ in CAL_REGS}
    known[("timebase", "ppm")] = "ppm"
    known[("timebase", "ppb")] = "ppb"
    known[("timebase", "inc")] = "inc"
    v, errs = {}, []
    for sec in cp.sections():
        for key, raw in cp.items(sec):
            kind = known.get((sec, key))
            if kind is None:
                errs.append(f"[{sec}] {key}: unknown key")
                continue
            try:
                if kind == "en":
                    val = {"on": 1, "1": 1, "true": 1, "yes": 1,
                           "off": 0, "0": 0, "false": 0, "no": 0}[raw.strip().lower()]
                elif kind in ("ppm", "ppb"):
                    val = float(raw)
                    if not math.isfinite(val):
                        raise ValueError
                else:
                    val = int(raw, 0)
            except (ValueError, KeyError):
                errs.append(f"[{sec}] {key} = {raw!r}: not a valid value")
                continue
            if kind == "u8" and not 0 <= val <= 255:
                errs.append(f"[{sec}] {key} = {val}: must be 0..255")
                continue
            if kind == "s" and not -2 ** 31 <= val < 2 ** 31 - 1:
                errs.append(f"[{sec}] {key} = {val}: out of the signed 32-bit range")
                continue
            v[(sec, key)] = val
    # one timebase form only; normalise to ppm
    tbk = [k for k in ("ppm", "ppb", "inc") if ("timebase", k) in v]
    if len(tbk) > 1:
        errs.append(f"[timebase] give one of ppm / ppb / inc, not {' and '.join(tbk)}")
    for lo, hi in (("rx_window_min_ns", "rx_window_max_ns"), ("tx_window_min_ns", "tx_window_max_ns")):
        a, b = v.get(("sfd", lo)), v.get(("sfd", hi))
        if a is not None and b is not None and a >= b:
            errs.append(f"[sfd] {lo} {a} must be < {hi} {b}")
    return v, errs


def tb_ppb_from_cal(v, dp_clk_hz):
    if ("timebase", "ppm") in v:
        return v[("timebase", "ppm")] * 1e3
    if ("timebase", "ppb") in v:
        return v[("timebase", "ppb")]
    if ("timebase", "inc") in v:
        return inc_to_ppb(v[("timebase", "inc")], dp_clk_hz)
    return None


def apply_cal(hw, v, timebase=True, dry=False, max_ppm=200.0):
    """Write the values to the registers -> (applied {name: value}, [warnings], [errors])."""
    applied, warns, errs = {}, [], []
    a, b = v.get(("sfd", "rx_window_min_ns")), v.get(("sfd", "rx_window_max_ns"))
    if a is not None and b is not None and b - a >= FRAME_TIME_64B_NS:
        warns.append(f"RX window {a}..{b} ns is {b - a} ns wide (>= {FRAME_TIME_64B_NS} ns): "
                     "a neighbouring frame's SFD can match")
    for sec, key, off, kind, _ in CAL_REGS:
        if (sec, key) not in v:
            continue
        if sec != "capture" and not hw.has_sfd:
            warns.append(f"[{sec}] {key}: this bitstream has no SFD block (capture map "
                         f"0x{hw.version:08x}), skipped")
            continue
        val = v[(sec, key)]
        if not dry:
            if kind == "en":
                # keep LOG_EN (bit 1), never write the self-clearing CLEAR bit
                hw.wr(off, (hw.rd(off) & 0x2) | (SFD_MATCH_EN if val else 0))
            else:
                hw.wr(off, val)
        applied[f"{sec}.{key}"] = val
    if timebase:
        ppb = tb_ppb_from_cal(v, hw.dp_clk_hz)
        if ppb is not None:
            if abs(ppb) > max_ppm * 1e3:
                errs.append(f"[timebase] {ppb / 1e3:+.3f} ppm is beyond +-{max_ppm} ppm: not applied")
            else:
                inc = ppb_to_inc(ppb, hw.dp_clk_hz)
                if not dry:
                    hw.set_inc_raw(inc)
                applied["timebase.ppm"] = round(ppb / 1e3, 6)
                applied["timebase.inc"] = f"0x{inc:010x}"
    return applied, warns, errs


