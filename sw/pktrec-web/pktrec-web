STATIC_TYPES = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
                ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml",
                ".ico": "image/x-icon"}


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "pktrec-web/" + VERSION
    backend = None
    static_dir = None
    quiet = False

    def log_message(self, fmt, *args):
        if not self.quiet:
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    # ---- responses ----
    def send_json(self, code, obj):
        body = json.dumps(obj, indent=None, separators=(",", ":")).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def send_error_json(self, code, msg):
        self.send_json(code, {"error": msg})

    def read_json(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            raise ApiError(413, "request body too large")
        raw = self.rfile.read(n) if n else b""
        if not raw.strip():
            return {}
        try:
            obj = json.loads(raw)
        except ValueError:
            raise ApiError(400, "body is not valid JSON")
        if not isinstance(obj, dict):
            raise ApiError(400, "body must be a JSON object")
        return obj

    # ---- dispatch ----
    def do_GET(self):
        self.dispatch("GET")

    def do_HEAD(self):
        self.dispatch("HEAD")

    def do_POST(self):
        self.dispatch("POST")

    def do_DELETE(self):
        self.dispatch("DELETE")

    def dispatch(self, method):
        path = urllib.parse.urlsplit(self.path).path
        try:
            if not path.startswith("/api/"):
                if method not in ("GET", "HEAD"):
                    raise ApiError(405, "method not allowed")
                return self.serve_static(path)
            if method == "POST":
                body = self.read_json()
            elif method in ("GET", "HEAD", "DELETE"):
                body = None
                # a DELETE may still carry a body; drain it to keep the connection usable
                n = int(self.headers.get("Content-Length") or 0)
                if n:
                    self.rfile.read(min(n, 65536))
            return self.route(method, path, body)
        except ApiError as e:
            self.send_error_json(e.code, e.msg)
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as e:                       # noqa: BLE001 - report, keep serving
            self.log_error("internal error: %r", e)
            try:
                self.send_error_json(500, f"internal error: {e}")
            except OSError:
                pass

    def route(self, method, path, body):
        b = self.backend
        if path == "/api/status" and method in ("GET", "HEAD"):
            return self.send_json(200, self.status())
        if path == "/api/stats" and method in ("GET", "HEAD"):
            return self.send_json(200, self.stats())
        if path == "/api/mode":
            if method != "POST":
                raise ApiError(405, "use POST")
            pair, mode = body.get("pair"), body.get("mode")
            if pair not in (0, 1) or isinstance(pair, bool):
                raise ApiError(400, "pair must be 0 (P0/P1) or 1 (P2/P3)")
            if mode not in ("tap", "monitor"):
                raise ApiError(400, "mode must be 'tap' or 'monitor'")
            b.set_mode(pair, mode)
            return self.send_json(200, {"pairs": self.pairs(b.phy_status(0))})
        if path == "/api/capture/start":
            if method != "POST":
                raise ApiError(405, "use POST")
            return self.send_json(202, b.start(body))
        if path == "/api/capture/stop":
            if method != "POST":
                raise ApiError(405, "use POST")
            return self.send_json(200, b.stop())
        if path == "/api/capture":
            return self.send_json(200, b.capture_state())
        if path in ("/api/captures", "/api/captures/"):
            if method not in ("GET", "HEAD"):
                raise ApiError(405, "use GET")
            return self.send_json(200, {"captures": b.captures(), "disk": b.disk()})
        m = re.match(r"^/api/captures/([^/]+?)(\.pcapng|\.cap|/info)?$", path)
        if m:
            name, kind = urllib.parse.unquote(m.group(1)), m.group(2)
            if kind is None and method == "DELETE":
                return self.send_json(200, b.delete(name))
            if method not in ("GET", "HEAD"):
                raise ApiError(405, "method not allowed")
            if kind == "/info":
                return self.send_json(200, b.capture_info(name))
            if kind == ".pcapng":
                return self.download_pcapng(name)
            if kind == ".cap":
                return self.download_raw(name)
            return self.send_json(200, b.capture_info(name))
        raise ApiError(404, "no such endpoint")

    # ---- views ----
    def pairs(self, phy):
        out = []
        modes = phy.get("pair_modes") or []
        for i, pp in enumerate(PAIRS):
            paths = [phy["ports"].get(p, {}).get("path") for p in pp]
            mode = pair_mode_from_paths(paths) if all(paths) else None
            if i < len(modes) and modes[i] in ("tap", "monitor") and mode != "other":
                mode = modes[i]                 # PAIR_MODE register (pktrec-phy --json)
            out.append({"pair": i, "ports": list(pp), "paths": paths, "mode": mode})
        return out

    def stats(self):
        b = self.backend
        hw = b.hw_stats()
        return {"time": iso_ns(time.time_ns()), "capture": b.capture_state(),
                "counters": hw, "disk": b.disk()}

    def status(self):
        b = self.backend
        hw = b.hw_stats()
        phy = b.phy_status()
        tb = b.timebase()
        ports = []
        for n in range(NUM_PORTS):
            p = dict(phy["ports"].get(n, {}))
            c = hw.get("ports", {}).get(n, {})
            if not p:                               # pktrec-phy unavailable: shell state
                lk = c.get("link")
                p = {"link": bool(lk and lk not in ("down", "?")),
                     "speed": lk if lk not in (None, "down", "?") else None}
            p["port"] = n
            p["counters"] = c
            ports.append(p)
        return {
            "version": dict(b.version, capture_block=hw.get("cap_version")),
            "time": {"system": iso_ns(time.time_ns()), "timebase_ns": hw.get("timebase_ns"),
                     "timebase": hw.get("timebase"), "tb_status": hw.get("tb_status"),
                     "tb_inc_ns": hw.get("tb_inc_ns"), "tb_freq_ppb": hw.get("tb_freq_ppb"),
                     "discipline": tb},
            "calibration": b.calibration(),
            "ports": ports, "pairs": self.pairs(phy),
            "capture": b.capture_state(), "disk": b.disk(),
            "errors": {"pktrec-phy": phy.get("error"), "pktrec-cap": hw.get("error")},
            "sources": {"pktrec-phy": phy.get("source"), "pktrec-cap": hw.get("source")},
        }

    # ---- downloads ----
    def _check_download(self, name):
        name, path = self.backend.cap_path(name)
        if not os.path.isfile(path):
            raise ApiError(404, f"no capture '{name}'")
        if name == self.backend.active_name():
            raise ApiError(409, "the capture is still being recorded")
        return name, path

    def _start_chunked(self, ctype, fname):
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Disposition", f'attachment; filename="{fname}"')
        self.send_header("Cache-Control", "no-store")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()

    def _chunk(self, data):
        self.wfile.write(b"%x\r\n" % len(data) + data + b"\r\n")

    def download_pcapng(self, name):
        name, path = self._check_download(name)
        try:
            proc = subprocess.Popen(self.backend.cmd_export + [path, "-o", "-"],
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    stdin=subprocess.DEVNULL)
        except OSError as e:
            raise ApiError(500, f"cannot run pktrec-export: {e}")
        errbuf = []
        t = threading.Thread(target=lambda: errbuf.append(proc.stderr.read()), daemon=True)
        t.start()
        ok = False
        try:
            first = proc.stdout.read1(CHUNK)
            if not first:
                code = proc.wait()
                t.join(2)
                raise ApiError(500, f"pktrec-export failed (exit {code}): " +
                               (errbuf[0] if errbuf else b"").decode(errors="replace")
                               .strip()[-300:])
            self._start_chunked("application/x-pcapng", name + ".pcapng")
            if self.command == "HEAD":
                self.wfile.write(b"0\r\n\r\n")
                ok = True
                return
            data = first
            while data:
                self._chunk(data)
                data = proc.stdout.read1(CHUNK)
            code = proc.wait()
            if code == 1:
                # error mid-stream: end without the terminating chunk, so the client
                # sees an incomplete transfer instead of a silently short file
                self.log_error("pktrec-export %s: exit 1 mid-stream", name)
                self.close_connection = True
                return
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()
            ok = True
        finally:
            if proc.poll() is None:
                proc.kill()
            proc.wait()
            proc.stdout.close()
            if not ok:
                self.close_connection = True

    def download_raw(self, name):
        name, path = self._check_download(name)
        size = os.path.getsize(path)
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Disposition", f'attachment; filename="{name}.cap"')
        self.send_header("Content-Length", str(size))
        self.end_headers()
        if self.command == "HEAD":
            return
        with open(path, "rb") as f:
            shutil.copyfileobj(f, self.wfile, CHUNK)

    def serve_static(self, path):
        if path in ("", "/"):
            path = "/index.html"
        rel = os.path.normpath(urllib.parse.unquote(path)).lstrip("/")
        full = os.path.join(self.static_dir, rel)
        if rel.startswith("..") or not os.path.isfile(full):
            raise ApiError(404, "not found")
        ctype = STATIC_TYPES.get(os.path.splitext(full)[1], "application/octet-stream")
        with open(full, "rb") as f:
            body = f.read()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, addr, handler, bind_dev=None):
        self.bind_dev = bind_dev
        super().__init__(addr, handler)

    def server_bind(self):
        if self.bind_dev:
            # listen on the interface, whatever address DHCP gives it (needs root)
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE,
                                   self.bind_dev.encode())
        super().server_bind()


def main():
    here = os.path.dirname(os.path.realpath(__file__))
    ap = argparse.ArgumentParser(prog="pktrec-web", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="API:" + __doc__.split("API", 1)[1].split("\n\n")[0][1:])
    ap.add_argument("--interface", default="end0",
                    help="serve on this interface only (SO_BINDTODEVICE, follows DHCP "
                         "address changes; default end0 = the ZCU106 GEM)")
    ap.add_argument("--bind", help="bind to this address instead of --interface "
                                   "(e.g. 0.0.0.0 or 127.0.0.1)")
    ap.add_argument("--port", type=int, default=8080)
    ap.add_argument("--rec-dir", default="/mnt/rec",
                    help="SSD mount point; captures go to <rec-dir>/captures")
    ap.add_argument("--mount-check", dest="mount_check", action="store_true", default=None,
                    help="refuse captures unless --rec-dir is a mount point (default, "
                         "except with --mock)")
    ap.add_argument("--no-mount-check", dest="mount_check", action="store_false")
    ap.add_argument("--static-dir", help="UI files (default: ./static next to the script, "
                                         "else /usr/share/pktrec-web/static)")
    ap.add_argument("--pktrec-cap", default="pktrec-cap")
    ap.add_argument("--pktrec-phy", default="pktrec-phy")
    ap.add_argument("--pktrec-export", default="pktrec-export")
    ap.add_argument("--tb-state", default=None,
                    help="pktrec-tb daemon state (default /run/pktrec/tb.json)")
    ap.add_argument("--cal-file", default=None,
                    help="calibration file (default /etc/pktrec/calibration.conf)")
    ap.add_argument("--cal-state", default=None,
                    help="calibration apply record (default /run/pktrec/calibration.json)")
    ap.add_argument("--mock", action="store_true",
                    help="fake pktrec-cap/pktrec-phy with mock_tools.py (host test); "
                         "pktrec-export is still run (give a host build)")
    ap.add_argument("--banner", action="store_true",
                    help="print 'pktrec web UI: http://<ip>:<port>/' once --interface has an "
                         "IPv4 address (boot banner), then exit")
    ap.add_argument("--wait", type=float, default=120,
                    help="seconds to wait for the interface address (--banner, --bind "
                         "fallback; default 120)")
    ap.add_argument("-q", "--quiet", action="store_true", help="no request log")
    a = ap.parse_args()

    if a.banner:
        ip = wait_iface_ipv4(a.interface, a.wait)
        if ip:
            print(f"pktrec web UI: http://{ip}:{a.port}/", flush=True)
            return 0
        print(f"pktrec web UI: {a.interface} has no IPv4 address yet "
              f"(port {a.port}; see 'ip addr show {a.interface}')", flush=True)
        return 1

    if a.mount_check is None:
        a.mount_check = not a.mock
    if a.static_dir is None:
        a.static_dir = os.path.join(here, "static")
        if not os.path.isdir(a.static_dir):
            a.static_dir = "/usr/share/pktrec-web/static"
    if a.mock:
        os.environ.setdefault("PKTREC_MOCK_STATE", os.path.join(a.rec_dir, ".mock-state"))
        os.makedirs(os.environ["PKTREC_MOCK_STATE"], exist_ok=True)
    ms = os.environ.get("PKTREC_MOCK_STATE", "") if a.mock else None
    a.tb_state = a.tb_state or (os.path.join(ms, "tb.json") if a.mock else "/run/pktrec/tb.json")
    a.cal_file = a.cal_file or (os.path.join(ms, "calibration.conf") if a.mock
                                else "/etc/pktrec/calibration.conf")
    a.cal_state = a.cal_state or (os.path.join(ms, "calibration.json") if a.mock
                                  else "/run/pktrec/calibration.json")

    backend = Backend(a)
    Handler.backend = backend
    Handler.static_dir = a.static_dir
    Handler.quiet = a.quiet

    if a.bind:
        srv, where = Server((a.bind, a.port), Handler), f"{a.bind}:{a.port}"
    else:
        try:
            srv = Server(("0.0.0.0", a.port), Handler, bind_dev=a.interface)
            ip = iface_ipv4(a.interface)
            where = f"{a.interface} ({ip or 'no address yet'}):{a.port}"
        except PermissionError:
            # not root: bind to the interface's current address instead
            ip = wait_iface_ipv4(a.interface, a.wait)
            if not ip:
                sys.exit(f"pktrec-web: {a.interface} has no IPv4 address")
            srv, where = Server((ip, a.port), Handler), f"{ip}:{a.port}"
        except OSError as e:
            if e.errno == errno.ENODEV:
                sys.exit(f"pktrec-web: no interface {a.interface} (use --interface/--bind)")
            raise
    print(f"pktrec-web {VERSION}: serving on {where}{' [MOCK]' if a.mock else ''}, "
          f"captures in {backend.cap_dir}", flush=True)

    def on_term(signum, frame):
        threading.Thread(target=srv.shutdown, daemon=True).start()
    signal.signal(signal.SIGTERM, on_term)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        backend.shutdown()          # a running capture is stopped cleanly
        srv.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
