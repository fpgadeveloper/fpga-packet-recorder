VERSION = "1.0"
PAIRS = ((0, 1), (2, 3))          # pair p = ports 2p, 2p+1 (include/pktrec_format.h)
NUM_PORTS = 4
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
CHUNK = 256 * 1024

# --------------------------------------------------------------------------
# Capture file header (include/pktrec_format.h, header version 1).
# Duplicated here (as in test/make_synth_capture.py) so that listing a
# directory of captures does not cost one 'pktrec-cap info' per file; the
# format is versioned and the parser refuses any other header_version.
# --------------------------------------------------------------------------
HDR_SIZE = 4096
HDR_FMT = "<8s10I9Q32s64s32s"
PORT_FMT = "<7QII16s"
TBD_FMT = "<IIqqQ"                # tb_disc_* after the port array (zeros = not recorded)
TBD_VALID, TBD_DAEMON, TBD_LOCKED, TBD_NTP, TBD_SET = 1, 2, 4, 8, 16
MAGIC = b"PKTRCAP\x00"
FF_COMPLETE, FF_TB_REALTIME, FF_LIMIT_SIZE, FF_LIMIT_TIME, FF_DMA_ERROR = 1, 2, 4, 8, 16
FPORT_ENABLED, FPORT_LINK_UP = 1, 2


def _cstr(b):
    return b.split(b"\0", 1)[0].decode("utf-8", "replace")


def parse_header(raw):
    """Parse the 4 KB pktrec capture file header; raise ValueError if invalid."""
    n = struct.calcsize(HDR_FMT)
    pn = struct.calcsize(PORT_FMT)
    if len(raw) < n + NUM_PORTS * pn:
        raise ValueError("file shorter than the 4 KB header")
    f = struct.unpack_from(HDR_FMT, raw, 0)
    if f[0] != MAGIC:
        raise ValueError("not a pktrec capture file (bad magic)")
    (hver, hsize, recfmt, flags, cap_ver, fdrec_ver, nports, mask, pair_mode,
     snaplen) = f[1:11]
    (t0, t1, tb0, tb1, tb_inc, data_bytes, records, drop_beats, dma_err) = f[11:20]
    if hver != 1:
        raise ValueError(f"unsupported header version {hver}")
    ports = []
    for i in range(min(nports, NUM_PORTS)):
        p = struct.unpack_from(PORT_FMT, raw, n + i * pn)
        ports.append({
            "port": i, "name": _cstr(p[9]) or f"P{i}",
            "enabled": bool(mask >> i & 1),
            "frames_rx": p[0], "frames_bad": p[1], "frames_drop": p[2], "bytes_rx": p[3],
            "bytes_drop": p[4], "frames_trunc": p[5], "records": p[6],
            "speed_mbps": p[7], "link_up": bool(p[8] & FPORT_LINK_UP),
        })
    complete = bool(flags & FF_COMPLETE)
    tf, tlock, toff, tppb, tt = struct.unpack_from(TBD_FMT, raw, n + NUM_PORTS * pn)
    tbd = None
    if tf & TBD_VALID:
        tbd = {"daemon": bool(tf & TBD_DAEMON), "locked": bool(tf & TBD_LOCKED),
               "ntp_synced": bool(tf & TBD_NTP), "set_at_start": bool(tf & TBD_SET),
               "locked_s": tlock, "offset_ns": toff, "freq_ppb": tppb, "ppm": tppb / 1e3,
               "measured": iso_ns(tt)}
    return {
        "header_version": hver, "record_format": recfmt, "complete": complete,
        "flags": {"tb_realtime": bool(flags & FF_TB_REALTIME),
                  "limit_size": bool(flags & FF_LIMIT_SIZE),
                  "limit_time": bool(flags & FF_LIMIT_TIME),
                  "dma_error": bool(flags & FF_DMA_ERROR)},
        "cap_version": f"0x{cap_ver:08x}", "fdrec_version": f"0x{fdrec_ver:08x}",
        "port_mask": mask, "ports_captured": [i for i in range(NUM_PORTS) if mask >> i & 1],
        "pair_modes": ["tap" if pair_mode >> p & 1 else "monitor" for p in range(2)],
        "snaplen": snaplen, "start_time_ns": t0, "stop_time_ns": t1,
        "start_time": iso_ns(t0), "stop_time": iso_ns(t1) if complete else None,
        "duration_s": (t1 - t0) / 1e9 if complete and t1 >= t0 else None,
        "tb_start_ns": tb0, "tb_stop_ns": tb1, "tb_inc_ns": tb_inc / 2 ** 32,
        "tb_discipline": tbd,
        "data_bytes": data_bytes, "records": records,
        "rec_drop_beats": drop_beats, "dma_errors": dma_err,
        "drops": sum(p["frames_drop"] for p in ports if p["enabled"]) if complete else None,
        "target": _cstr(f[20]), "hostname": _cstr(f[21]), "design": _cstr(f[22]),
        "ports": ports,
    }


def iso_ns(ns):
    if not ns:
        return None
    return datetime.datetime.fromtimestamp(ns / 1e9, datetime.timezone.utc) \
        .isoformat(timespec="milliseconds").replace("+00:00", "Z")


# --------------------------------------------------------------------------
# Text parsers for the CLI tools' output. The formats are those of
# sw/pktrec-tools/pktrec-phy 'status' and sw/pktrec-apps/pktrec-cap
# 'stats' / live statistics; the regexes only anchor on the fields used.
# --------------------------------------------------------------------------
RATE_RE = re.compile(r"^([\d.]+)([kMG]?)b?$")
LIVE_RE = re.compile(r"^\s*([\d.]+)s\s+([\d.]+) MB/s\s+([\d.]+) GB ring\s+(\d+)/(\d+)"
                     r" bp\s+([\d.]+)%")
LIVE_PORT_RE = re.compile(r"\| P(\d) (\S+)/s (\S+)/s d(\d+)")
RESULT_RE = re.compile(r"^RESULT (.*)$")
STATS_PORT_RE = re.compile(r"^P(\d)\s+(\S+)" + r"\s+(\d+)" * 8)
PHY_PORT_RE = re.compile(r"^P(\d)\s+0x[0-9a-fA-F]+\s+(.*)$")
PHY_TAIL_RE = re.compile(r"0x[0-9a-fA-F]{4}\s+(\d)\s+(\d)\s+(\d)\s+(\S+)\s*$")


def parse_rate(s):
    m = RATE_RE.match(s)
    if not m:
        return None
    return float(m.group(1)) * {"": 1, "k": 1e3, "M": 1e6, "G": 1e9}[m.group(2)]


def parse_live_line(line):
    m = LIVE_RE.match(line)
    if not m:
        return None
    d = {"elapsed_s": float(m.group(1)), "write_mb_s": float(m.group(2)),
         "written_gb": float(m.group(3)), "ring_used": int(m.group(4)),
         "ring_total": int(m.group(5)), "backpressure_pct": float(m.group(6)), "ports": {}}
    for pm in LIVE_PORT_RE.finditer(line):
        d["ports"][int(pm.group(1))] = {"frames_s": parse_rate(pm.group(2)),
                                        "bits_s": parse_rate(pm.group(3)),
                                        "drops": int(pm.group(4))}
    return d


def parse_cap_stats(text):
    d = {"ports": {}}
    for line in text.splitlines():
        if line.startswith("capture "):
            m = re.search(r"version (0x[0-9a-fA-F]+)", line)
            d["cap_version"] = m.group(1) if m else None
            d["enabled"] = "ENABLED" in line
        elif line.startswith("ports "):
            m = re.search(r"enabled (0x[0-9a-fA-F]+), snaplen (\d+), FIFO (\d+) bytes", line)
            if m:
                d["port_en"] = int(m.group(1), 16)
                d["snaplen"] = int(m.group(2))
                d["fifo_bytes"] = int(m.group(3))
        elif line.startswith("timebase "):
            m = re.search(r"^timebase (\d+) ns \(([^)]*?)(?: if set from CLOCK_REALTIME)?\)",
                          line)
            if m:
                d["timebase_ns"] = int(m.group(1))
                d["timebase"] = m.group(2)
            m = re.search(r"TB_STATUS (0x[0-9a-fA-F]+)", line)
            d["tb_status"] = m.group(1) if m else None
        else:
            m = STATS_PORT_RE.match(line)
            if m:
                v = [int(x) for x in m.groups()[2:]]
                d["ports"][int(m.group(1))] = {
                    "link": m.group(2), "frames_rx": v[0], "frames_bad": v[1],
                    "frames_drop": v[2], "frames_trunc": v[3], "bytes_rx": v[4],
                    "records": v[5], "fifo_hwm": v[6]}
    return d


def parse_phy_status(text):
    ports = {}
    for line in text.splitlines():
        m = PHY_PORT_RE.match(line)
        if not m:
            continue
        n, rest = int(m.group(1)), m.group(2)
        p = {"link": False, "speed": None, "duplex": None, "error": None,
             "sgmii_sync": None, "pcs_link": None, "path": None}
        c = re.match(r"up\s+(\S+)\s+(FD|HD)", rest)
        if c:
            p.update(link=True, speed=c.group(1), duplex="full" if c.group(2) == "FD" else "half")
        elif rest.startswith("MDIO error"):
            p["error"] = rest.split("sync=", 1)[0].strip()
        s = re.search(r"sync=(\d)", rest)
        p["sgmii_sync"] = bool(int(s.group(1))) if s else None
        t = PHY_TAIL_RE.search(rest)
        if t:
            p["pcs_link"] = bool(int(t.group(1)))
            p["path"] = t.group(4)
        ports[n] = p
    return ports


def cap_stats_from_json(doc):
    """'pktrec-cap stats --json' -> the dict parse_cap_stats() builds from the text."""
    d = {"cap_version": doc["cap_version"], "enabled": bool(doc["enabled"]),
         "port_en": doc["port_en"], "snaplen": doc["snaplen"], "fifo_bytes": doc["fifo_bytes"],
         "timebase_ns": doc["timebase_ns"], "timebase": doc["timebase"],
         "tb_status": doc["tb_status"], "tb_inc_ns": doc.get("tb_inc"),
         "tb_freq_ppb": doc.get("tb_freq_ppb"), "merge": doc.get("merge"), "ports": {}}
    for p in doc["ports"]:
        d["ports"][p["port"]] = {k: p[k] for k in (
            "link", "frames_rx", "frames_bad", "frames_drop", "frames_trunc", "bytes_rx",
            "records", "fifo_hwm")}
        d["ports"][p["port"]]["bytes_drop"] = p.get("bytes_drop")
    return d


def phy_status_from_json(doc):
    """'pktrec-phy status --json' -> ({port: state}, [pair modes] or None)."""
    ports = {}
    for p in doc["ports"]:
        cu, pcs = p.get("copper") or {}, p.get("pcs") or {}
        up = bool(cu.get("up"))
        fd = cu.get("full_duplex")
        ports[p["port"]] = {
            "link": up, "speed": cu.get("speed") if up else None,
            "duplex": None if not up or fd is None else ("full" if fd else "half"),
            "error": cu.get("error"), "sgmii_sync": bool(pcs.get("sync")) if pcs else None,
            "pcs_link": bool(p.get("link_up")), "path": p.get("path")}
    pairs = [q.get("mode") for q in doc.get("pairs") or []] or None
    return ports, pairs


def live_from_json(obj):
    """A {"type": "stats"} line of 'pktrec-cap record --stats-json'."""
    d = {k: obj.get(k) for k in ("elapsed_s", "write_mb_s", "written_bytes", "written_gb",
                                  "ring_used", "ring_total", "backpressure_pct", "drops")}
    d["ports"] = {int(n): v for n, v in (obj.get("ports") or {}).items()}
    d["source"] = "json"
    return d


def read_json_file(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def tb_discipline(path):
    """The pktrec-tb daemon state (/run/pktrec/tb.json) as shown by the API."""
    st = read_json_file(path)
    if not isinstance(st, dict):
        return {"daemon": False, "fresh": False, "locked": False, "state": None,
                "message": "pktrec-tb is not running (no state file)"}
    age = (time.time_ns() - (st.get("updated_ns") or 0)) / 1e9
    alive = True
    if st.get("pid"):
        try:
            os.kill(st["pid"], 0)
        except ProcessLookupError:
            alive = False
        except OSError:
            pass
    fresh = bool(alive and st.get("running") and -5 < age < 3 * (st.get("interval_s") or 1) + 5)
    return {"daemon": True, "fresh": fresh, "locked": bool(fresh and st.get("locked")),
            "state": st.get("state") if fresh else "stopped", "age_s": round(age, 1),
            "offset_ns": st.get("offset_ns"), "offset_rms_ns": st.get("offset_rms_30s_ns"),
            "offset_max_ns": st.get("offset_abs_max_30s_ns"),
            "ppm": st.get("ppm"), "freq_est_ppm": (st.get("freq_est_ppb") / 1e3
                                                   if st.get("freq_est_ppb") is not None else None),
            "locked_since": st.get("locked_since"), "last_set": st.get("last_set"),
            "last_set_reason": st.get("last_set_reason"), "sets": st.get("sets"),
            "ntp_synced": st.get("ntp_synced"), "capture_running": st.get("capture_running"),
            "lock_threshold_ns": st.get("lock_threshold_ns"), "message": st.get("message")}


def calibration_state(cal_file, applied_file):
    d = {"file": cal_file, "present": os.path.isfile(cal_file), "mtime": None, "applied": None}
    if d["present"]:
        d["mtime"] = iso_ns(int(os.stat(cal_file).st_mtime * 1e9))
    ap = read_json_file(applied_file)
    if isinstance(ap, dict):
        d["applied"] = {k: ap.get(k) for k in ("applied", "file", "ok", "errors", "warnings")}
    return d


def pair_mode_from_paths(paths):
    if all(p == "fwd" for p in paths):
        return "tap"
    if all(p == "idle" for p in paths):
        return "monitor"
    return "other"


# --------------------------------------------------------------------------
# Network interface address (SIOCGIFADDR), for the banner and --bind fallback
# --------------------------------------------------------------------------
def iface_ipv4(ifname):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        r = fcntl.ioctl(s.fileno(), 0x8915, struct.pack("256s", ifname.encode()[:15]))
        return socket.inet_ntoa(r[20:24])
    except OSError:
        return None
    finally:
        s.close()


def wait_iface_ipv4(ifname, timeout):
    t_end = time.monotonic() + timeout
    while True:
        a = iface_ipv4(ifname)
        if a or time.monotonic() >= t_end:
            return a
        time.sleep(1)


class ApiError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code
        self.msg = msg


# --------------------------------------------------------------------------
# Backend: the tools, the capture subprocess and cached hardware snapshots
# --------------------------------------------------------------------------
class Backend:
    def __init__(self, args):
        self.a = args
        self.cap_dir = os.path.join(args.rec_dir, "captures")
        here = os.path.dirname(os.path.realpath(__file__))
        if args.mock:
            mock = [sys.executable, os.path.join(here, "mock_tools.py")]
            self.cmd_cap = mock + ["cap"]
            self.cmd_phy = mock + ["phy"]
        else:
            self.cmd_cap = [args.pktrec_cap]
            self.cmd_phy = [args.pktrec_phy]
        self.cmd_export = [args.pktrec_export]
        self.cmd_mock = mock if args.mock else None
        self.lock = threading.Lock()          # capture state
        self.hw_lock = threading.Lock()       # stats / phy caches
        self.proc = None
        self.cap = None                        # current capture (dict)
        self.last = None                       # last finished capture (dict)
        self.stats_cache = (0.0, None)
        self.prev_counters = None              # (t, {port: counters})
        self.rates = {}
        self.phy_cache = (0.0, None)
        self.version = self._image_version()

    # ---- helpers ----
    def run(self, cmd, timeout=10):
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               timeout=timeout, text=True)
        except FileNotFoundError:
            raise ApiError(500, f"{cmd[0]} not found")
        except subprocess.TimeoutExpired:
            raise ApiError(504, f"{os.path.basename(cmd[0])} timed out")
        return r

    def run_safe(self, cmd, timeout):
        """run(), with a missing / hung tool reported as a failed run (keep serving)."""
        try:
            return self.run(cmd, timeout=timeout)
        except ApiError as e:
            return subprocess.CompletedProcess(cmd, 1, "", e.msg)

    def timebase(self):
        if self.cmd_mock:                      # the mock daemon refreshes its state file
            self.run_safe(self.cmd_mock + ["tb"], 5)
        return tb_discipline(self.a.tb_state)

    def calibration(self):
        return calibration_state(self.a.cal_file, self.a.cal_state)

    def _image_version(self):
        v = {"web": VERSION}
        try:
            with open("/etc/os-release") as f:
                kv = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
            v["image"] = " ".join(x.strip('"') for x in
                                  (kv.get("PRETTY_NAME", ""), kv.get("BUILD_ID", "")) if x)
        except OSError:
            v["image"] = None
        if self.a.mock:
            v["image"] = "mock (host test)"
        return v

    def ssd_mounted(self):
        if not self.a.mount_check:
            return os.path.isdir(self.a.rec_dir)
        return os.path.ismount(self.a.rec_dir)

    def disk(self):
        d = {"path": self.a.rec_dir, "mounted": self.ssd_mounted()}
        if d["mounted"]:
            st = os.statvfs(self.a.rec_dir)
            d.update(total_bytes=st.f_blocks * st.f_frsize, free_bytes=st.f_bavail * st.f_frsize)
        return d

    def cap_path(self, name):
        if name.endswith(".cap"):
            name = name[:-4]
        if not NAME_RE.match(name):
            raise ApiError(400, "invalid capture name (letters, digits, '.', '_', '-'; max 64)")
        return name, os.path.join(self.cap_dir, name + ".cap")

    # ---- hardware snapshots (cached; every client shares them) ----
    def hw_stats(self):
        with self.hw_lock:
            t, cached = self.stats_cache
            now = time.monotonic()
            if cached is not None and now - t < 0.8:
                return cached
            d = None
            r = self.run_safe(self.cmd_cap + ["stats", "--json"], 5)
            if r.returncode == 0:
                try:
                    d = cap_stats_from_json(json.loads(r.stdout))
                    d["source"] = "json"
                except (ValueError, KeyError, TypeError):
                    d = None
            if d is None:                       # an older pktrec-cap: text fallback
                r = self.run_safe(self.cmd_cap + ["stats"], 5)
            if d is None and r.returncode != 0:
                d = {"error": (r.stderr.strip() or "pktrec-cap stats failed")[-300:], "ports": {}}
            elif d is None:
                d = parse_cap_stats(r.stdout)
                d["source"] = "text"
            if "error" not in d:
                if self.prev_counters:
                    t0, prev = self.prev_counters
                    dt = now - t0
                    for n, c in d["ports"].items():
                        p = prev.get(n)
                        if p and dt > 0 and c["frames_rx"] >= p["frames_rx"]:
                            self.rates[n] = {
                                "frames_s": (c["frames_rx"] - p["frames_rx"]) / dt,
                                "bits_s": (c["bytes_rx"] - p["bytes_rx"]) * 8 / dt}
                        else:
                            self.rates[n] = {"frames_s": 0.0, "bits_s": 0.0}
                self.prev_counters = (now, d["ports"])
                for n, c in d["ports"].items():
                    c.update(self.rates.get(n, {"frames_s": None, "bits_s": None}))
            self.stats_cache = (now, d)
            return d

    def phy_status(self, max_age=2.0):
        with self.hw_lock:
            t, cached = self.phy_cache
            now = time.monotonic()
            if cached is not None and now - t < max_age:
                return cached
            d = None
            r = self.run_safe(self.cmd_phy + ["status", "--json"], 10)
            if r.returncode == 0:
                try:
                    ports, pairs = phy_status_from_json(json.loads(r.stdout))
                    d = {"error": None, "ports": ports, "pair_modes": pairs, "source": "json"}
                except (ValueError, KeyError, TypeError):
                    d = None
            if d is None:                       # an older pktrec-phy: text fallback
                r = self.run_safe(self.cmd_phy + ["status"], 10)
                if r.returncode != 0:
                    d = {"error": (r.stderr.strip() or "pktrec-phy status failed")[-300:],
                         "ports": {}}
                else:
                    d = {"error": None, "ports": parse_phy_status(r.stdout), "source": "text"}
            self.phy_cache = (now, d)
            return d

    # ---- per-pair mode ----
    def set_mode(self, pair, mode):
        """tap = both ports of the pair forward to each other (path fwd),
        monitor = both ports idle (receive only). M3 replaces this mapping by
        pktrec-phy's own per-pair mode command; the API stays the same."""
        with self.lock:
            if self.proc is not None:
                raise ApiError(409, "a capture is running; stop it before changing the mode")
            path = {"tap": "fwd", "monitor": "idle"}[mode]
            for port in PAIRS[pair]:
                r = self.run(self.cmd_phy + ["path", str(port), path])
                if r.returncode != 0:
                    raise ApiError(500, f"pktrec-phy path {port} {path}: "
                                   f"{(r.stderr or r.stdout).strip()[-300:]}")
        with self.hw_lock:
            self.phy_cache = (0.0, None)

    # ---- capture control ----
    def start(self, req):
        ports = req.get("ports", list(range(NUM_PORTS)))
        if (not isinstance(ports, list) or not ports or
                any(not isinstance(p, int) or not 0 <= p < NUM_PORTS for p in ports)):
            raise ApiError(400, "ports must be a non-empty list of 0..3")
        ports = sorted(set(ports))
        snaplen = req.get("snaplen", 0) or 0
        if not isinstance(snaplen, int) or not 0 <= snaplen <= 65535:
            raise ApiError(400, "snaplen must be 0..65535 (0 = whole frames)")
        dur = req.get("duration_s")
        size = req.get("size_bytes")
        if dur is not None and (not isinstance(dur, (int, float)) or dur <= 0):
            raise ApiError(400, "duration_s must be > 0")
        if size is not None and (not isinstance(size, int) or size <= 0):
            raise ApiError(400, "size_bytes must be a positive integer")
        name = req.get("name") or time.strftime("cap-%Y%m%d-%H%M%S", time.gmtime())
        name, path = self.cap_path(str(name))
        with self.lock:
            if self.proc is not None:
                raise ApiError(409, f"a capture is already running ({self.cap['name']})")
            if not self.ssd_mounted():
                raise ApiError(503, f"the SSD is not mounted at {self.a.rec_dir}")
            os.makedirs(self.cap_dir, exist_ok=True)
            if os.path.exists(path):
                raise ApiError(409, f"capture '{name}' already exists")
            cmd = self.cmd_cap + ["record", "--ports", ",".join(map(str, ports)),
                                  "--snaplen", str(snaplen), "--stats", "1", "--stats-json"]
            if dur is not None:
                cmd += ["--duration", f"{dur:g}"]
            if size is not None:
                cmd += ["--size", str(size)]
            cmd.append(path)
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        stdin=subprocess.DEVNULL, text=True, bufsize=1,
                                        start_new_session=True)
            except OSError as e:
                raise ApiError(500, f"cannot run pktrec-cap: {e}")
            self.proc = proc
            self.cap = {"name": name, "file": path, "ports": ports, "snaplen": snaplen,
                        "duration_s": dur, "size_bytes": size, "started": time.time(),
                        "t0": time.monotonic(), "live": None, "log": [], "stdout": [],
                        "result": None, "stopping": False}
            cap = self.cap
            threading.Thread(target=self._read_stderr, args=(proc, cap), daemon=True).start()
            reader = threading.Thread(target=self._read_stdout, args=(proc, cap), daemon=True)
            reader.start()
            threading.Thread(target=self._reap, args=(proc, cap, reader), daemon=True).start()
        # an immediate failure (no device, no hugepages, ...) is reported here
        try:
            proc.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            return self.capture_state()
        for _ in range(50):                    # let _reap record the result
            if self.proc is not proc:
                break
            time.sleep(0.02)
        res = self.last if self.last and self.last["name"] == name else None
        if res and res["exit_code"] == 1:
            try:
                if os.path.getsize(path) <= HDR_SIZE:
                    os.unlink(path)
            except OSError:
                pass
            raise ApiError(500, "pktrec-cap failed: " + (res["message"] or "error"))
        return self.capture_state()

    def _read_stderr(self, proc, cap):
        for line in proc.stderr:
            line = line.rstrip("\r\n")
            live = parse_live_line(line)
            if live:                            # text fallback (no --stats-json)
                if not (cap["live"] or {}).get("source") == "json":
                    live["source"] = "text"
                    cap["live"] = live
            elif line:
                cap["log"] = (cap["log"] + [line])[-40:]

    def _read_stdout(self, proc, cap):
        """--stats-json lines ({"type": "stats"|"result"}) and the summary text."""
        for line in proc.stdout:
            line = line.rstrip("\r\n")
            if line.startswith("{"):
                try:
                    obj = json.loads(line)
                except ValueError:
                    obj = None
                if isinstance(obj, dict) and obj.get("type") == "stats":
                    cap["live"] = live_from_json(obj)
                    continue
                if isinstance(obj, dict) and obj.get("type") == "result":
                    cap["result"] = obj
                    continue
            cap["stdout"].append(line)

    def _reap(self, proc, cap, reader):
        reader.join()
        code = proc.wait()
        out = "\n".join(cap["stdout"])
        result = {}
        if cap["result"]:
            result = {k: v for k, v in cap["result"].items() if k not in ("type", "exit_code")}
        for line in out.splitlines() if not result else ():
            m = RESULT_RE.match(line)
            if m:
                for kv in m.group(1).split():
                    k, _, v = kv.partition("=")
                    try:
                        result[k] = float(v) if "." in v else int(v)
                    except ValueError:
                        result[k] = v
        msg = None
        if code == 1:
            msg = "; ".join(cap["log"][-3:]) or "pktrec-cap exited with an error"
        elif code == 2:
            msg = "frames were dropped: the capture is not lossless"
        elif code < 0:
            msg = f"pktrec-cap killed by signal {-code}"
        with self.lock:
            self.last = {"name": cap["name"], "file": cap["file"], "exit_code": code,
                         "lossless": code == 0, "result": result, "message": msg,
                         "summary": out.strip().splitlines()[-12:], "log": cap["log"][-10:],
                         "finished": time.time()}
            if self.proc is proc:
                self.proc = None
                self.cap = None

    def stop(self, wait=15.0):
        with self.lock:
            proc, cap = self.proc, self.cap
            if proc is None:
                raise ApiError(409, "no capture is running")
            cap["stopping"] = True
            try:
                proc.send_signal(signal.SIGTERM)  # pktrec-cap stops cleanly (FILL, header)
            except ProcessLookupError:
                pass
        t_end = time.monotonic() + wait
        while time.monotonic() < t_end and self.proc is proc:
            time.sleep(0.05)
        return self.capture_state()

    def capture_state(self):
        with self.lock:
            cap, last = self.cap, self.last
            if cap is None:
                return {"state": "idle", "last": last}
            st = {"state": "stopping" if cap["stopping"] else "running",
                  "name": cap["name"], "ports": cap["ports"], "snaplen": cap["snaplen"],
                  "duration_s": cap["duration_s"], "size_bytes": cap["size_bytes"],
                  "started": iso_ns(int(cap["started"] * 1e9)),
                  "elapsed_s": time.monotonic() - cap["t0"], "live": cap["live"],
                  "log": cap["log"][-5:], "last": last}
        try:
            st["file_bytes"] = os.path.getsize(cap["file"])
        except OSError:
            st["file_bytes"] = None
        return st

    def shutdown(self):
        with self.lock:
            proc = self.proc
        if proc:
            proc.send_signal(signal.SIGTERM)
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                proc.kill()

    # ---- captures ----
    def active_name(self):
        with self.lock:
            return self.cap["name"] if self.cap else None

    def captures(self):
        out = []
        with self.lock:
            cap = dict(self.cap) if self.cap else {}
        active = cap.get("name")
        try:
            names = sorted(os.listdir(self.cap_dir))
        except OSError:
            return out
        for fn in names:
            if not fn.endswith(".cap") or not NAME_RE.match(fn[:-4]):
                continue
            path = os.path.join(self.cap_dir, fn)
            try:
                st = os.stat(path)
                with open(path, "rb") as f:
                    raw = f.read(HDR_SIZE)
            except OSError:
                continue
            e = {"name": fn[:-4], "file_bytes": st.st_size, "recording": fn[:-4] == active,
                 "mtime": iso_ns(int(st.st_mtime * 1e9))}
            try:
                h = parse_header(raw)
                e.update({k: h[k] for k in ("start_time", "duration_s", "ports_captured",
                                             "drops", "records", "data_bytes", "snaplen",
                                             "complete", "pair_modes")})
            except ValueError as ex:
                if not e["recording"]:           # the header is written at start and stop
                    e["error"] = str(ex)
            if e["recording"]:
                e.update(ports_captured=cap.get("ports"), drops=None, duration_s=None,
                         start_time=iso_ns(int(cap.get("started", 0) * 1e9)))
            out.append(e)
        out.sort(key=lambda e: e.get("start_time") or e["mtime"] or "", reverse=True)
        return out

    def capture_info(self, name):
        name, path = self.cap_path(name)
        if not os.path.isfile(path):
            raise ApiError(404, f"no capture '{name}'")
        with open(path, "rb") as f:
            raw = f.read(HDR_SIZE)
        try:
            h = parse_header(raw)
        except ValueError as e:
            h = {"error": str(e)}
        r = self.run(self.cmd_cap + ["info", path])
        h["name"] = name
        h["file_bytes"] = os.path.getsize(path)
        h["recording"] = name == self.active_name()
        h["info_text"] = r.stdout if r.returncode == 0 else (r.stderr or r.stdout)
        return h

    def delete(self, name):
        name, path = self.cap_path(name)
        if name == self.active_name():
            raise ApiError(409, "the capture is being recorded; stop it first")
        try:
            os.unlink(path)
        except FileNotFoundError:
            raise ApiError(404, f"no capture '{name}'")
        return {"deleted": name}


