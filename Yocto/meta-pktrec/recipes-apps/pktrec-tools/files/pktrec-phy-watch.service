# Ethernet FMC Max (OP080): configure the four DP83867 PHYs at boot and keep
# the SGMII status word fresh on every copper link change (the DP83867 sends it
# only once, see pktrec-phy 'watch'). For pairs in TAP mode it propagates a
# link loss to the partner port by holding the partner PHY in MII loopback
# (never by powering a PHY down: P0's PHY clocks P1-P3 on the OP080), and after
# every link-up it corrects the port's SFD RX_OFFSET from the PHY's skew FIFO
# status (reg 0x0055, +8 ns when non-zero). State: /run/pktrec/phy-watch.json.
# Runs as a service so it survives SSH sessions (nohup/setsid copies die with
# the session).
[Unit]
Description=OP080 PHY init and SGMII link watcher (pktrec-phy)
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStartPre=/usr/bin/pktrec-phy init --1000-only
ExecStart=/usr/bin/python3 -u /usr/bin/pktrec-phy watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
